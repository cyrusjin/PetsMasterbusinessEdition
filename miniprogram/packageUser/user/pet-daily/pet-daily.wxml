<view class="container">
  <view wx:if="{{order}}">
    <view class="card">
      <view class="flex-row gap-20">
        <cached-image wx:if="{{order.petPhoto}}" src="{{order.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
        <view wx:else class="pet-avatar-small">{{order.petName[0]}}</view>
        <view>
          <text class="boarding-name">{{order.petName}}</text>
          <text class="text-gray" style="display:block;font-size:22rpx;">{{order.startDate}} ~ {{order.endDate}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{logs.length > 0}}">
    <view class="daily-item card" wx:for="{{logs}}" wx:key="id" wx:for-index="logIdx">
      <view class="flex-between mb-16">
        <text class="text-gray">{{item.time}}</text>
      </view>
      <view class="daily-checks">
        <text class="tag tag-green" wx:for="{{item.checks}}" wx:key="*this" wx:for-item="c">{{c}}</text>
      </view>
      <view class="daily-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="daily-media" wx:if="{{(item.images && item.images.length) || (item.videoItems && item.videoItems.length) || item.videoUrl || item.video}}">
        <view
          class="daily-img-wrap"
          wx:for="{{item.images}}"
          wx:key="*this"
          wx:for-item="img"
          catchtap="onPreviewImage"
          data-log-index="{{logIdx}}"
          data-url="{{img}}"
        >
          <cached-image src="{{img}}" mode="aspectFill" custom-class="daily-img" />
        </view>
        <view
          wx:for="{{item.videoItems}}"
          wx:key="url"
          wx:for-item="videoItem"
          wx:for-index="videoIdx"
          class="daily-video-thumb {{videoItem.coverUrl ? 'has-cover' : ''}}"
          catchtap="onPreviewVideo"
          data-log-index="{{logIdx}}"
          data-url="{{videoItem.url}}"
          data-video-index="{{videoIdx}}"
        >
          <cached-image
            wx:if="{{videoItem.coverUrl}}"
            src="{{videoItem.coverUrl}}"
            mode="aspectFill"
            custom-class="daily-video-cover"
          />
          <view class="video-play-badge">▶</view>
        </view>
      </view>
      <daily-comments
        log-id="{{item.id}}"
        comments="{{item.comments}}"
        bind:change="onCommentsChange"
        data-log-index="{{logIdx}}"
      />
    </view>
  </view>
  <view wx:else class="empty-state">
    <text class="empty-icon">📸</text>
    <text class="empty-text">暂无动态记录</text>
  </view>
</view>
