<view class="container">
  <view class="card">
    <button class="login-avatar-wrap avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <cached-image custom-class="login-avatar" src="{{avatarUrl}}" default-src="/images/default-avatar.png" mode="aspectFill" />
      <text class="login-avatar-tip">点击授权微信头像</text>
    </button>
    <view class="form-group">
      <text class="form-label">昵称 <text class="required-star">*</text></text>
      <input class="form-input" type="nickname" placeholder="点击授权或输入昵称" value="{{nickName}}" bindinput="onNickInput" bindblur="onNickInput" />
    </view>
    <view class="form-group">
      <text class="form-label">真实姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{realName}}" bindinput="onRealNameInput" />
    </view>
    <view class="form-group">
      <text class="form-label">身份证号</text>
      <input class="form-input" type="idcard" placeholder="请输入身份证号" value="{{idCard}}" bindinput="onIdCardInput" />
    </view>
    <view class="form-group">
      <text class="form-label">手机号 <text class="required-star">*</text></text>
      <view class="phone-row">
        <input class="form-input phone-input" type="number" placeholder="请授权或输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
        <button class="btn-sm btn-green phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">微信授权</button>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">常用地址</text>
      <input class="form-input" placeholder="请输入常用地址" value="{{address}}" bindinput="onAddrInput" />
    </view>
    <view class="form-group debug-info">
      <text class="form-label">后端连接状态</text>
      <text class="openid-text">{{cloudStatus}} · {{cloudEnv}}</text>
      <text class="form-label" style="margin-top:16rpx;">当前账号 openid（须与数据库一致）</text>
      <text class="openid-text">{{openid || '未获取，请检查 API 配置'}}</text>
      <text class="role-text">当前角色：{{roleLabel}}</text>
      <text class="openid-text">数据库 isMerchant：{{dbIsMerchant}}</text>
      <text class="form-label" style="margin-top:16rpx;">绑定店铺编号</text>
      <text class="openid-text">{{storeDisplayNo || '未绑定，请通过店铺分享链接进入'}}</text>
      <text class="openid-text" wx:if="{{storeName}}">店铺名称：{{storeName}}</text>
      <text class="cloud-error" wx:if="{{cloudError}}">错误：{{cloudError}}</text>
      <button class="btn-outline refresh-btn" bindtap="onRefreshRole">刷新身份</button>
      <button class="btn-outline refresh-btn" wx:if="{{storeDisplayNo}}" bindtap="onCopyStoreId">复制店铺编号</button>
    </view>
    <button class="btn-primary" bindtap="onSave">保存信息</button>
  </view>
</view>
