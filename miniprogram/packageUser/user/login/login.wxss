.login-avatar-wrap { display: flex; flex-direction: column; align-items: center; margin-bottom: 30rpx; }
.avatar-btn { background: transparent; border: none; padding: 0; margin: 0; line-height: normal; }
.avatar-btn::after { border: none; }
.login-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background: #F2DEC9; border: 4rpx solid #E98657; }
.login-avatar-tip { font-size: 24rpx; color: #999999; margin-top: 12rpx; }
.phone-row { display: flex; align-items: center; gap: 16rpx; }
.phone-input { flex: 1; width: 0; min-width: 0; }
.phone-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  min-height: 80rpx;
  height: auto;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}
.phone-btn::after { border: none; }
.debug-info { background: #F7F8FA; border-radius: 16rpx; padding: 20rpx; }
.openid-text { font-size: 22rpx; color: #999999; word-break: break-all; display: block; margin-top: 8rpx; }
.role-text { font-size: 24rpx; color: #E98657; display: block; margin-top: 12rpx; font-weight: 600; }
.refresh-btn { margin-top: 20rpx; min-height: 72rpx; height: auto; padding: 16rpx 32rpx; font-size: 26rpx; white-space: nowrap; line-height: 1.2; }
.cloud-error { font-size: 22rpx; color: #E53935; display: block; margin-top: 12rpx; word-break: break-all; }