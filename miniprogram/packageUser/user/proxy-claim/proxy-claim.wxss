.invite-page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF4E7 0%, #FFFDF9 40%, #FFF8F0 100%);
}

.invite-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(233, 134, 87, 0.08);
}

.invite-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 20rpx;
}

.invite-desc {
  display: block;
  font-size: 28rpx;
  color: #8a7464;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.invite-status {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.text-red { color: #d14343; }

.btn-secondary {
  margin-top: 20rpx;
  background: #FFF6EE;
  color: #E98657;
  border: 2rpx solid #E98657;
}

.btn-secondary::after {
  border: none;
}
