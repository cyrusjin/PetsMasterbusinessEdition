<view wx:if="{{loading}}" class="insurance-state">
  <view class="insurance-state-icon loading-icon">···</view>
  <text class="insurance-state-title">正在验证保险页面</text>
  <text class="insurance-state-desc">请稍候</text>
</view>

<view wx:elif="{{expired}}" class="insurance-state">
  <view class="insurance-state-icon">⌛</view>
  <text class="insurance-state-title">{{errorText || '链接已过期'}}</text>
  <text class="insurance-state-desc">保险推广页面仅在生成后 {{validHours}} 小时内有效，请联系商家重新发送。</text>
  <button class="insurance-state-btn" bindtap="onGoHome">返回小程序首页</button>
</view>

<view wx:else class="insurance-guide">
  <view class="insurance-guide-card">
    <view class="insurance-guide-icon">🐾</view>
    <text class="insurance-guide-title">前往平安宠物保险</text>
    <text class="insurance-guide-desc">点击下方按钮，前往平安好车主小程序查看保障并投保。</text>

    <button class="insurance-buy-btn" bindtap="onBuyInsurance">前往平安购买保险</button>
    <text class="insurance-qr-hint insurance-backup-hint">无法跳转时，可点击下方小程序码放大识别</text>

    <view class="insurance-qr-wrap" bindtap="onPreviewInsuranceQr">
      <image
        class="insurance-qr"
        src="{{insuranceQrPath}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
      />
    </view>
    <button class="insurance-copy-btn" bindtap="onCopyInsuranceLink">复制购买链接</button>
    <text class="insurance-guide-provider">保险产品及承保、理赔服务由中国平安相关保险机构提供，请以平安官方页面条款为准。</text>
  </view>
</view>
