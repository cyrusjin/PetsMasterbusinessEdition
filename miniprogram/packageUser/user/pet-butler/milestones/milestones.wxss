.page { padding: 20rpx 20rpx 60rpx; }
.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}
.picker-value { margin-top: 8rpx; font-size: 30rpx; font-weight: 700; color: #4E3729; }
.birthday-card {
  padding: 40rpx 28rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  text-align: center;
  background: linear-gradient(160deg, #FFF1E7, #FFFDF8);
  box-shadow: 0 10rpx 26rpx rgba(132, 90, 58, 0.08);
}
.b-label { display: block; font-size: 24rpx; color: #A98972; }
.b-num {
  display: block;
  margin-top: 10rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: #E98657;
  line-height: 1;
}
.unit { font-size: 28rpx; }
.b-sub { display: block; margin-top: 14rpx; font-size: 26rpx; color: #4E3729; }
.note {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F2DEC9;
}
.note-date { display: block; font-size: 22rpx; color: #A98972; }
.note-text { display: block; margin-top: 6rpx; font-size: 26rpx; color: #5B4535; line-height: 1.45; }
.note-del { font-size: 22rpx; color: #D96F55; white-space: nowrap; }
.empty-card {
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #FFFDF8;
  border-radius: 24rpx;
}
.empty-title { display: block; font-size: 32rpx; font-weight: 750; color: #4E3729; }
.empty-sub { display: block; margin: 12rpx 0 32rpx; color: #A98972; font-size: 24rpx; }
.soft-empty {
  margin-top: 20rpx;
  padding-top: 8rpx;
  text-align: center;
}
.soft-empty-text {
  font-size: 24rpx;
  color: #A98972;
}
