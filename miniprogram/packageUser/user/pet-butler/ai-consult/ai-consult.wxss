.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 0%, rgba(111, 164, 98, 0.18), transparent 260rpx),
    linear-gradient(180deg, #F3F7F1 0%, #FFF8F0 45%, #FFFDF9 100%);
}

.ai-gen-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  background: #FFF3E0;
  border-bottom: 2rpx solid #F0C28A;
}

.ai-gen-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #E98657;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.ai-gen-banner-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #8A4B1F;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.ai-bubble-tag {
  display: block;
  margin-bottom: 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #E98657;
  letter-spacing: 1rpx;
}

.chat-inner {
  padding: 24rpx 22rpx 12rpx;
}

.chat-bottom-anchor {
  height: 2rpx;
  width: 100%;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}

.msg-user {
  align-items: flex-end;
}

.msg-ai {
  align-items: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 16rpx rgba(132, 90, 58, 0.06);
}

.msg-user .bubble {
  background: #E98657;
  border-bottom-right-radius: 8rpx;
}

.msg-ai .bubble {
  background: #FFFDF8;
  border-bottom-left-radius: 8rpx;
}

.bubble.pending {
  opacity: 0.75;
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-word;
}

.msg-user .bubble-text {
  color: #fff;
}

.msg-ai .bubble-text {
  color: #4E3729;
}

.msg-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #C8AA92;
  padding: 0 8rpx;
}

.quick-wrap {
  padding: 8rpx 0 4rpx;
  background: rgba(255, 253, 248, 0.88);
}

.quick-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.quick-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #FFF1E7;
  color: #E98657;
  font-size: 22rpx;
  vertical-align: middle;
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 20rpx 8rpx;
  background: #FFFDF8;
  border-top: 1rpx solid #F2DEC9;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #FFF8F0;
  border: 2rpx solid #F2DEC9;
  font-size: 28rpx;
}

.send-btn {
  flex-shrink: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
}

.send-btn.disabled {
  opacity: 0.45;
}

.safe-tip-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 20rpx calc(10rpx + env(safe-area-inset-bottom));
  background: #FFFDF8;
}

.safe-tip {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: 20rpx;
  color: #C8AA92;
}

.clear-link {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A98972;
  padding: 4rpx 8rpx;
}
