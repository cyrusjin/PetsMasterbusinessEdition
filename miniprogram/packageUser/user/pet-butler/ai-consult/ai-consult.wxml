<view class="page">
  <view class="ai-gen-banner" wx:if="{{bannerVisible}}">
    <text class="ai-gen-badge">{{bannerBadge}}</text>
    <text class="ai-gen-banner-text">{{bannerText}}</text>
  </view>

  <scroll-view
    scroll-y
    class="chat-scroll"
    scroll-into-view="{{scrollToView}}"
    scroll-top="{{scrollTop}}"
    scroll-with-animation
  >
    <view class="chat-inner">
      <view
        class="msg {{item.role === 'user' ? 'msg-user' : 'msg-ai'}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
      >
        <view class="bubble {{item.pending ? 'pending' : ''}}">
          <text class="ai-bubble-tag" wx:if="{{bubbleTag && item.role === 'ai' && !item.pending}}">{{bubbleTag}}</text>
          <text class="bubble-text" user-select="{{true}}">{{item.content}}</text>
        </view>
        <text class="msg-meta" wx:if="{{!item.pending}}">{{item.time}}{{item.metaSuffix || ''}}</text>
      </view>
      <view id="chat-bottom" class="chat-bottom-anchor"></view>
    </view>
  </scroll-view>

  <view class="quick-wrap">
    <scroll-view scroll-x class="quick-scroll" enable-flex>
      <text
        class="quick-chip"
        wx:for="{{quick}}"
        wx:key="*this"
        bindtap="onQuick"
        data-q="{{item}}"
      >{{item}}</text>
    </scroll-view>
  </view>

  <view class="input-bar">
    <input
      class="input"
      value="{{inputText}}"
      maxlength="200"
      placeholder="描述症状或养宠问题…"
      confirm-type="send"
      bindinput="onInput"
      bindconfirm="onSend"
      disabled="{{sending}}"
    />
    <view class="send-btn {{sending || !inputText ? 'disabled' : ''}}" bindtap="onSend">发送</view>
  </view>
  <view class="safe-tip-row">
    <text class="safe-tip">{{safeTip}}</text>
    <text class="clear-link" wx:if="{{hasHistory}}" bindtap="onClearHistory">清空记录</text>
  </view>
</view>
