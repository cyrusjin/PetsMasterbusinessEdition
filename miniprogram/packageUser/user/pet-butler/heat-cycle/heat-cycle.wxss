.page { padding: 20rpx 20rpx 60rpx; }
.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}
.picker-value { margin-top: 8rpx; font-size: 30rpx; font-weight: 700; color: #4E3729; }
.hint { display: block; margin-top: 12rpx; font-size: 22rpx; color: #A98972; line-height: 1.4; }
.phase-card {
  background: linear-gradient(145deg, #FFF0F4, #FFFDF8);
}
.phase-label { display: block; font-size: 22rpx; color: #A98972; }
.phase-name { display: block; margin-top: 8rpx; font-size: 40rpx; font-weight: 800; color: #C45C7A; }
.phase-grid { display: flex; gap: 16rpx; margin: 24rpx 0 12rpx; }
.phase-item {
  flex: 1;
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.8);
  text-align: center;
}
.phase-item .num { display: block; font-size: 36rpx; font-weight: 800; color: #4E3729; }
.phase-item .lab { display: block; margin-top: 4rpx; font-size: 20rpx; color: #A98972; }
.phase-sub { display: block; margin-top: 6rpx; font-size: 22rpx; color: #8C6A52; }
.btn-row { display: flex; gap: 16rpx; }
.half { flex: 1; width: auto !important; }
.tips .tip-line { display: block; margin-top: 10rpx; font-size: 24rpx; color: #5B4535; line-height: 1.5; }
.ask-ai {
  display: inline-block;
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 650;
  color: #6FA462;
}
.history-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
  font-size: 26rpx;
  color: #5B4535;
}
.history-row:last-child { border-bottom: none; }
.empty-card {
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #FFFDF8;
  border-radius: 24rpx;
}
.empty-title { display: block; font-size: 32rpx; font-weight: 750; color: #4E3729; }
.empty-sub { display: block; margin: 12rpx 0 32rpx; color: #A98972; font-size: 24rpx; }
