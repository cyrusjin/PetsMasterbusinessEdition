page {
  background: #FFF5EC;
}

.page {
  min-height: 100%;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 28rpx 32rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #FFF1E7 0%, #FFFDF8 100%);
  box-shadow: 0 10rpx 26rpx rgba(132, 90, 58, 0.08);
}

.hero-kicker,
.result-kicker {
  display: block;
  color: #E98657;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  color: #4E3729;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  color: #A98972;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}

.card-title {
  display: block;
  margin-bottom: 20rpx;
  color: #4E3729;
  font-size: 30rpx;
  font-weight: 800;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFF7EF;
  border: 2rpx solid #F2D8D2;
  color: #5B4535;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.picker-arrow {
  color: #E98657;
  font-size: 24rpx;
  font-weight: 600;
}

.existing-box {
  margin-top: 8rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #FFF4E9;
}

.existing-label {
  display: block;
  color: #A98972;
  font-size: 22rpx;
}

.existing-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E98657;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.existing-code {
  display: block;
  margin-top: 8rpx;
  color: #E98657;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.existing-name {
  display: block;
  margin-top: 4rpx;
  color: #4E3729;
  font-size: 28rpx;
  font-weight: 800;
}

.existing-sub {
  display: block;
  margin-top: 4rpx;
  color: #8C6A52;
  font-size: 22rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-title {
  display: block;
  color: #4E3729;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  color: #A98972;
  font-size: 24rpx;
}

.tips-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4E3729;
  font-size: 28rpx;
  font-weight: 800;
}

.tips-line,
.tip-line,
.disclaimer-text {
  display: block;
  margin-top: 10rpx;
  color: #5B4535;
  font-size: 24rpx;
  line-height: 1.65;
}

.start-btn {
  margin-top: 8rpx;
}

.ghost-btn {
  margin-top: 18rpx;
  text-align: center;
  color: #E98657;
  font-size: 26rpx;
  font-weight: 700;
}

.quiz {
  padding-bottom: 24rpx;
}

.quiz-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.quiz-total,
.quiz-page {
  color: #8C6A52;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.segment-track {
  flex: 1;
  display: flex;
  gap: 8rpx;
}

.segment {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #EAD7C6;
}

.segment.on {
  background: #E98657;
}

.q-card {
  padding: 28rpx 24rpx 20rpx;
  margin-bottom: 18rpx;
  border-radius: 24rpx;
  background: #FFFDF8;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}

.q-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.q-no {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E98657;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.q-text {
  flex: 1;
  min-width: 0;
  color: #4E3729;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.scale-row {
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
}

.scale-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.paw {
  position: relative;
  width: 72rpx;
  height: 72rpx;
}

.paw-toe,
.paw-pad {
  position: absolute;
  box-sizing: border-box;
  border: 4rpx solid #C9C9C9;
  background: transparent;
}

.paw-toe {
  width: 18rpx;
  height: 22rpx;
  border-radius: 50%;
}

.paw-toe.t1 {
  left: 6rpx;
  top: 18rpx;
}

.paw-toe.t2 {
  left: 18rpx;
  top: 4rpx;
}

.paw-toe.t3 {
  right: 18rpx;
  top: 4rpx;
}

.paw-toe.t4 {
  right: 6rpx;
  top: 18rpx;
}

.paw-pad {
  left: 16rpx;
  bottom: 4rpx;
  width: 40rpx;
  height: 32rpx;
  border-radius: 46% 46% 48% 48%;
}

.scale-item.on .paw-toe,
.scale-item.on .paw-pad {
  border-color: #E98657;
  background: #E98657;
}

.scale-label {
  color: #A3A3A3;
  font-size: 18rpx;
  line-height: 1.3;
  text-align: center;
}

.scale-item.on .scale-label {
  color: #E98657;
  font-weight: 700;
}

.quiz-footer-space {
  height: 160rpx;
}

.quiz-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 245, 236, 0) 0%, #FFF5EC 28%);
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
  text-align: center;
}

.nav-prev {
  background: #fff;
  color: #E98657;
  border: 3rpx solid #E98657;
  box-sizing: border-box;
}

.nav-next {
  background: #E98657;
  color: #fff;
}

.result-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 36rpx 40rpx;
  margin: 28rpx 8rpx 24rpx;
  border-radius: 8rpx 36rpx 28rpx 28rpx;
  background: #FFFDF8;
  box-shadow: 0 12rpx 32rpx rgba(132, 90, 58, 0.1);
  overflow: hidden;
}

.result-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #F3D2B3 0 50%, transparent 50%);
  pointer-events: none;
  z-index: 1;
}

.result-photo-wrap {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
}

.result-photo {
  display: block;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #F4E0CE;
  background: #FFF4E9;
  box-sizing: border-box;
  overflow: hidden;
}

.result-photo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E98657;
  font-size: 64rpx;
  font-weight: 800;
}

.result-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  margin: 0 0 20rpx;
  padding: 10rpx 28rpx;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  background: #E98657;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
  box-sizing: border-box;
}

.result-kicker {
  margin-top: 4rpx;
  color: #4E3729;
  letter-spacing: 0;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.result-code {
  display: block;
  margin-top: 8rpx;
  color: #E98657;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  line-height: 1.1;
  text-align: center;
}

.result-name {
  display: block;
  margin-top: 8rpx;
  color: #E98657;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.result-summary {
  display: block;
  align-self: stretch;
  margin-top: 24rpx;
  color: #5B4535;
  font-size: 26rpx;
  line-height: 1.75;
  text-align: left;
}

.saving-hint {
  display: block;
  margin-top: 12rpx;
  color: #A98972;
  font-size: 22rpx;
}

.disclaimer {
  background: #FFF8F0;
}

.disclaimer-text {
  color: #A98972;
  font-size: 22rpx;
}
