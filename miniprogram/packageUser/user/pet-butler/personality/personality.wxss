.page {
  min-height: 100%;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 28rpx 32rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #FFF1E7 0%, #FFFDF8 100%);
  box-shadow: 0 10rpx 26rpx rgba(132, 90, 58, 0.08);
}

.hero-kicker,
.result-kicker {
  display: block;
  color: #E98657;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  color: #4E3729;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-sub {
  display: block;
  margin-top: 14rpx;
  color: #A98972;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}

.card-title {
  display: block;
  margin-bottom: 20rpx;
  color: #4E3729;
  font-size: 30rpx;
  font-weight: 800;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFF7EF;
  border: 2rpx solid #F2D8D2;
  color: #5B4535;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.picker-arrow {
  color: #E98657;
  font-size: 24rpx;
  font-weight: 600;
}

.existing-box {
  margin-top: 8rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #FFF4E9;
}

.existing-label {
  display: block;
  color: #A98972;
  font-size: 22rpx;
}

.existing-code {
  display: block;
  margin-top: 8rpx;
  color: #E98657;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.existing-name {
  display: block;
  margin-top: 4rpx;
  color: #4E3729;
  font-size: 28rpx;
  font-weight: 800;
}

.existing-sub {
  display: block;
  margin-top: 4rpx;
  color: #8C6A52;
  font-size: 22rpx;
}

.empty-card {
  text-align: center;
  padding: 48rpx 28rpx;
}

.empty-title {
  display: block;
  color: #4E3729;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-sub {
  display: block;
  margin-top: 10rpx;
  color: #A98972;
  font-size: 24rpx;
}

.tips-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4E3729;
  font-size: 28rpx;
  font-weight: 800;
}

.tips-line,
.tip-line,
.disclaimer-text {
  display: block;
  margin-top: 10rpx;
  color: #5B4535;
  font-size: 24rpx;
  line-height: 1.65;
}

.start-btn {
  margin-top: 8rpx;
}

.ghost-btn {
  margin-top: 18rpx;
  text-align: center;
  color: #E98657;
  font-size: 26rpx;
  font-weight: 700;
}

.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.quiz-back,
.quiz-progress {
  color: #8C6A52;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #F2DEC9;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #E98657;
}

.question-card {
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #FFFDF8;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}

.question-dim {
  display: block;
  color: #E98657;
  font-size: 22rpx;
  font-weight: 700;
}

.question-text {
  display: block;
  margin-top: 14rpx;
  color: #4E3729;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.55;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
  border: 2rpx solid #F2D8D2;
  box-sizing: border-box;
}

.option-item.on {
  background: #FFF1E7;
  border-color: #E98657;
}

.option-tag {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: #F6E6D6;
  color: #8C6A52;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.option-item.on .option-tag {
  background: #E98657;
  color: #fff;
}

.option-text {
  flex: 1;
  min-width: 0;
  color: #5B4535;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.55;
}

.result-hero {
  padding: 40rpx 28rpx 32rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #FFF1E7 0%, #FFFDF8 100%);
  box-shadow: 0 10rpx 26rpx rgba(132, 90, 58, 0.08);
}

.result-code {
  display: block;
  margin-top: 8rpx;
  color: #E98657;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  line-height: 1.1;
}

.result-name {
  display: block;
  margin-top: 10rpx;
  color: #4E3729;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
}

.result-sub {
  display: block;
  margin-top: 8rpx;
  color: #A98972;
  font-size: 24rpx;
  font-weight: 700;
}

.result-summary {
  display: block;
  margin-top: 16rpx;
  color: #5B4535;
  font-size: 26rpx;
  line-height: 1.7;
}

.saving-hint {
  display: block;
  margin-top: 12rpx;
  color: #A98972;
  font-size: 22rpx;
}

.disclaimer {
  background: #FFF8F0;
}

.disclaimer-text {
  color: #A98972;
  font-size: 22rpx;
}
