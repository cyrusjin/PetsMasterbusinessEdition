<view class="page">
  <view wx:if="{{step === 'intro'}}">
    <view class="hero">
      <text class="hero-kicker">宠物 16 型人格</text>
      <text class="hero-title">测测它更接近哪一种</text>
      <text class="hero-sub">20 道日常观察题，从社交、关注、情感和作息四个维度，看看它的相处偏好。请按平时真实表现来选。</text>
    </view>

    <view class="card" wx:if="{{pets.length}}">
      <view class="form-group">
        <text class="form-label">今天测谁</text>
        <picker mode="selector" range="{{petNames}}" value="{{petIndex}}" bindchange="onPetChange">
          <view class="picker-value">{{petNames[petIndex]}} <text class="picker-arrow">更换</text></view>
        </picker>
      </view>
      <view class="existing-box" wx:if="{{existing}}">
        <text class="existing-label">上次测出来是</text>
        <text class="existing-tag" wx:if="{{existing.tag}}">{{existing.tag}}</text>
        <text class="existing-code">{{existing.typeId}}</text>
        <text class="existing-name">{{existing.typeName}}</text>
        <text class="existing-sub">{{existing.subtitle}}</text>
      </view>
    </view>

    <view class="card empty-card" wx:else>
      <text class="empty-title">还没有宠物档案</text>
      <text class="empty-sub">先把毛孩子加进来，再测它的 16 型人格。</text>
    </view>

    <view class="card tips">
      <text class="tips-title">怎么答</text>
      <text class="tips-line">选更像它平时的那个，不要选你希望它成为的样子。</text>
      <text class="tips-line">每题 5 个程度，从「非常不符合」到「非常符合」。</text>
    </view>

    <button class="btn-primary start-btn" bindtap="onStart">{{pets.length ? (existing ? '再测一次' : '开始测试') : '去添加宠物'}}</button>
    <view class="ghost-btn" wx:if="{{existing}}" bindtap="onViewExisting">看上次结果</view>
  </view>

  <view wx:elif="{{step === 'quiz'}}" class="quiz">
    <view class="quiz-progress-row">
      <text class="quiz-total">共{{totalCount}}题</text>
      <view class="segment-track">
        <view
          class="segment {{item.on ? 'on' : ''}}"
          wx:for="{{segments}}"
          wx:key="id"
        ></view>
      </view>
      <text class="quiz-page">{{progressText}}</text>
    </view>

    <view class="question-list">
      <view class="q-card" wx:for="{{pageQuestions}}" wx:key="id">
        <view class="q-head">
          <view class="q-no">{{item.no}}</view>
          <text class="q-text">{{item.prompt}}</text>
        </view>
        <view class="scale-row">
          <view
            class="scale-item {{item.answer === opt.value ? 'on' : ''}}"
            wx:for="{{scaleOptions}}"
            wx:for-item="opt"
            wx:for-index="optIndex"
            wx:key="value"
            bindtap="onSelectScale"
            data-index="{{item.globalIndex}}"
            data-value="{{opt.value}}"
          >
            <view class="paw">
              <view class="paw-toe t1"></view>
              <view class="paw-toe t2"></view>
              <view class="paw-toe t3"></view>
              <view class="paw-toe t4"></view>
              <view class="paw-pad"></view>
            </view>
            <text class="scale-label">{{opt.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="quiz-footer-space"></view>
    <view class="quiz-footer">
      <view class="nav-btn nav-prev" bindtap="onPrevPage">上一页</view>
      <view class="nav-btn nav-next" bindtap="onNextPage">{{nextLabel}}</view>
    </view>
  </view>

  <view wx:elif="{{step === 'result' && result}}" class="result-page">
    <view class="result-sheet">
      <view class="result-fold"></view>
      <view class="result-photo-wrap">
        <image wx:if="{{petPhoto}}" class="result-photo" src="{{petPhoto}}" mode="aspectFill" />
        <view wx:else class="result-photo result-photo-fallback">{{petNameInitial}}</view>
      </view>
      <view class="result-tag" wx:if="{{result.tag}}">{{result.tag}}</view>
      <text class="result-kicker">{{petName}}的 16 型人格</text>
      <text class="result-code">{{result.typeId}}</text>
      <text class="result-name">{{result.typeName}}</text>
      <text class="result-summary">{{result.summary}}</text>
      <text class="saving-hint" wx:if="{{saving}}">正在写进档案…</text>
    </view>

    <view class="card">
      <text class="card-title">相处建议</text>
      <text class="tip-line" wx:for="{{result.careTips}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="card">
      <text class="card-title">寄养到店须知</text>
      <text class="tip-line" wx:for="{{result.boardingTips}}" wx:key="*this">{{item}}</text>
    </view>

    <view class="card disclaimer">
      <text class="disclaimer-text">结果仅供了解相处偏好，不能替代专业行为评估或训宠方案。</text>
    </view>

    <button class="btn-primary start-btn" open-type="share">分享给好友</button>
    <view class="ghost-btn" bindtap="onRetake">重新测试</view>
  </view>
</view>
