.page { padding: 20rpx 20rpx 60rpx; }
.card {
  background: #FFFDF8;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(132, 90, 58, 0.07);
}
.pet-picker .picker-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #4E3729;
}
.item-top { display: flex; align-items: flex-start; gap: 16rpx; }
.item-icon { font-size: 40rpx; line-height: 1; flex-shrink: 0; }
.item-main { flex: 1; min-width: 0; }
.item-title { display: block; font-size: 30rpx; font-weight: 750; color: #4E3729; }
.item-tip { display: block; margin-top: 6rpx; font-size: 22rpx; color: #A98972; line-height: 1.4; }
.status {
  flex-shrink: 0;
  align-self: flex-start;
  white-space: nowrap;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF3E7;
  color: #5B8C5A;
}
.status.unset {
  background: #EFE6DC;
  color: #8C6A52;
}
.status.soon {
  background: #FFF1E7;
  color: #E98657;
}
.status.overdue {
  background: #FFE8E2;
  color: #D96F55;
}
.status.ok {
  background: #EAF3E7;
  color: #5B8C5A;
}
.ai-hint {
  margin-top: 8rpx;
  padding: 22rpx 24rpx;
  border: 1rpx dashed rgba(111, 164, 98, 0.45);
  background: linear-gradient(135deg, rgba(111, 164, 98, 0.08), #FFFDF8);
}
.ai-hint-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #4E3729;
}
.ai-hint-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6FA462;
}
.item-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2DEC9;
  font-size: 22rpx;
  color: #8C6A52;
}
.item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.link { color: #E98657; font-size: 26rpx; }
.btn-done {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #E98657;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}
.empty-card {
  margin-top: 80rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #FFFDF8;
  border-radius: 24rpx;
}
.empty-title { display: block; font-size: 32rpx; font-weight: 750; color: #4E3729; }
.empty-sub { display: block; margin: 12rpx 0 32rpx; color: #A98972; font-size: 24rpx; }
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(50, 30, 20, 0.35);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #FFFDF8;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 750;
  color: #4E3729;
  margin-bottom: 24rpx;
}
