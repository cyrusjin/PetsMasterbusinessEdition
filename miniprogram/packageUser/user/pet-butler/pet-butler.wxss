.butler-page {
  min-height: 100vh;
  padding: 24rpx 22rpx 60rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 88% 0%, rgba(245, 210, 174, 0.55), transparent 280rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF8F0 40%, #FFFDF9 100%);
}

.hero-card {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(233, 134, 87, 0.16), rgba(255, 253, 248, 0.95));
  box-shadow: 0 12rpx 28rpx rgba(132, 90, 58, 0.08);
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-badge {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #6FA462, #5B8C5A);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #4E3729;
}

.ai-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 253, 248, 0.95);
  border: 1rpx solid rgba(111, 164, 98, 0.28);
}

.ai-entry:active {
  opacity: 0.9;
}

.ai-entry-title {
  display: block;
  font-size: 28rpx;
  font-weight: 750;
  color: #4E3729;
}

.ai-entry-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A98972;
}

.ai-entry-arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 650;
  color: #6FA462;
}

.hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #A98972;
  line-height: 1.5;
}

.hero-stats {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.stat-chip {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 253, 248, 0.9);
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #E98657;
  line-height: 1.2;
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #A98972;
}

.section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 750;
  color: #4E3729;
}

.section-more {
  font-size: 24rpx;
  color: #E98657;
}

.upcoming-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.upcoming-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
  box-shadow: 0 8rpx 20rpx rgba(132, 90, 58, 0.06);
}

.upcoming-item.overdue {
  background: #FFF5F2;
}

.upcoming-item.soon {
  background: #FFF8EF;
}

.upcoming-icon {
  font-size: 36rpx;
}

.upcoming-body {
  flex: 1;
  min-width: 0;
}

.upcoming-title {
  display: block;
  font-size: 26rpx;
  font-weight: 650;
  color: #4E3729;
}

.upcoming-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A98972;
}

.upcoming-badge {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 20rpx;
  font-weight: 650;
  line-height: 1.2;
  color: #E98657;
  background: #FFF1E7;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.upcoming-badge.overdue,
.upcoming-item.overdue .upcoming-badge {
  color: #D96F55;
  background: #FFE8E2;
}

.upcoming-badge.soon {
  color: #E98657;
  background: #FFF1E7;
}

.empty-block.soft {
  padding: 28rpx 24rpx;
}

.empty-block.soft .empty-text {
  margin-bottom: 0;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.tool-card {
  padding: 28rpx 22rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFDF8;
  box-shadow: 0 10rpx 24rpx rgba(132, 90, 58, 0.07);
  border-top: 6rpx solid var(--accent, #E98657);
}

.tool-card.featured {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, rgba(111, 164, 98, 0.14), #FFFDF8 70%);
}

.tool-card:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.tool-emoji {
  display: block;
  font-size: 40rpx;
  line-height: 1;
}

.tool-title {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 750;
  color: #4E3729;
}

.tool-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #A98972;
  line-height: 1.4;
}

.pet-row-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pet-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
  box-shadow: 0 8rpx 20rpx rgba(132, 90, 58, 0.06);
}

.pet-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid #F2DEC9;
}

.pet-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF1E7;
  color: #E98657;
  font-weight: 700;
  font-size: 28rpx;
}

.pet-meta {
  flex: 1;
  min-width: 0;
}

.pet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #4E3729;
}

.pet-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A98972;
}

.empty-block {
  padding: 36rpx 24rpx;
  border-radius: 22rpx;
  background: #FFFDF8;
  text-align: center;
}

.empty-text {
  display: block;
  color: #A98972;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.empty-btn {
  width: 60% !important;
}
