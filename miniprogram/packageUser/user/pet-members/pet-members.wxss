.members-head {
  margin-bottom: 24rpx;
}

.members-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #3d2b1f;
  margin-bottom: 8rpx;
}

.members-sub {
  display: block;
  font-size: 24rpx;
  color: #9a8575;
  line-height: 1.5;
}

.member-card {
  margin-bottom: 20rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid #F2DEC9;
}

.member-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF4E7;
  color: #E98657;
  font-size: 28rpx;
}

.actions {
  margin-top: 40rpx;
}

.btn-outline {
  background: #fff;
  color: #E98657;
  border: 2rpx solid #E98657;
  border-radius: 48rpx;
  font-size: 30rpx;
}
