<view class="contract-page">
  <scroll-view scroll-y class="scroll-body" style="height:{{scrollHeight}}px;">
    <view class="contract-paper">
      <text class="contract-doc-title">{{doc.title}}</text>

      <view class="contract-parties">
        <view class="party-block">
          <text class="party-label">{{doc.partyA.label}}</text>
          <text class="party-line">负责人：{{doc.partyA.name}}</text>
          <text class="party-line">店铺名称：{{doc.partyA.shopName}}</text>
          <text class="party-line">联系电话：{{doc.partyA.phone}}</text>
          <text class="party-line">营业地址：{{doc.partyA.address}}</text>
        </view>
        <view class="party-block">
          <text class="party-label">{{doc.partyB.label}}</text>
          <text class="party-line">平台名称：{{doc.partyB.name}}</text>
          <text class="party-line">主体身份：{{doc.partyB.role}}</text>
        </view>
      </view>

      <view class="contract-section" wx:for="{{doc.sections}}" wx:key="title" wx:for-item="section">
        <text class="section-title">{{section.title}}</text>
        <text class="section-item" wx:for="{{section.items}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}. {{item}}</text>
      </view>

      <text class="contract-footer">本协议以电子形式订立，甲方在本平台点击「确认签署」并完成入驻申请，即视为同意本协议全部条款；本协议对甲乙双方均具有法律约束力。</text>

      <view class="sign-stamp" wx:if="{{doc.signed}}">
        <text class="sign-stamp-title">电子签署记录</text>
        <text class="sign-stamp-line">签署人：{{doc.partyA.name}}</text>
        <text class="sign-stamp-line">签署时间：{{doc.signTime}}</text>
        <text class="sign-stamp-line">签署方式：电子确认</text>
      </view>
    </view>
  </scroll-view>

  <view class="contract-action-bar" wx:if="{{mode === 'sign'}}">
    <text class="sign-tip">请仔细阅读全部条款后确认签署</text>
    <button class="btn-sign" bindtap="onConfirmSign">我已阅读并同意，确认签署</button>
  </view>
</view>
