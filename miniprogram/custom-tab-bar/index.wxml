<view class="tab-bar">
  <view
    class="tab-bar-item"
    wx:for="{{list}}"
    wx:key="pagePath"
  >
    <image
      class="tab-bar-icon"
      src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
      mode="aspectFit"
    />
    <view class="tab-bar-text {{selected === index ? 'active' : ''}}">{{item.text}}</view>
    <!-- 覆盖整格热区，避免 image/text 吞点击 -->
    <view
      class="tab-bar-hit"
      data-index="{{index}}"
      hover-class="none"
      catchtap="switchTab"
    />
  </view>
</view>
