{
  "pages": [
    "pages/index/index",
    "pages/orders/orders",
    "pages/daily/daily",
    "pages/merchant/tab-daily/tab-daily",
    "pages/merchant/tab-statistics/tab-statistics",
    "pages/merchant/tab-store/tab-store",
    "pages/share/store-landing/store-landing",
    "pages/merchant/apply/apply"
  ],
  "subPackages": [
    {
      "root": "packageUser",
      "name": "packageUser",
      "pages": [
        "user/pets/pets",
        "user/pet-form/pet-form",
        "user/pet-invite/pet-invite",
        "user/pet-members/pet-members",
        "user/pet-butler/pet-butler",
        "user/pet-butler/ai-consult/ai-consult",
        "user/pet-butler/reminders/reminders",
        "user/pet-butler/heat-cycle/heat-cycle",
        "user/pet-butler/care-guide/care-guide",
        "user/pet-butler/food-check/food-check",
        "user/pet-butler/age-calc/age-calc",
        "user/pet-butler/weight-check/weight-check",
        "user/pet-butler/walk/walk",
        "user/pet-butler/milestones/milestones",
        "user/reserve/reserve",
        "user/proxy-claim/proxy-claim",
        "user/boarding-contract/boarding-contract",
        "user/order-detail/order-detail",
        "user/order-edit/order-edit",
        "user/contract/contract",
        "user/contract-sign/contract-sign",
        "user/pet-daily/pet-daily"
      ]
    },
    {
      "root": "packageBiz",
      "name": "packageBiz",
      "pages": [
        "orders/orders",
        "order-detail/order-detail",
        "order-price/order-price",
        "daily-check/daily-check",
        "daily-logs/daily-logs",
        "pickup-manage/pickup-manage",
        "holiday-pricing/holiday-pricing",
        "share-guest/share-guest"
      ]
    },
    {
      "root": "packageContract",
      "name": "packageContract",
      "pages": [
        "boarding-contract/boarding-contract",
        "coop-contract/coop-contract",
        "contract/contract",
        "contract-edit/contract-edit"
      ]
    },
    {
      "root": "packageExtra",
      "name": "packageExtra",
      "pages": [
        "chat/chat",
        "settings/settings",
        "staff-manage/staff-manage",
        "statistics/statistics",
        "merchant-auth/merchant-auth",
        "announcements/announcements",
        "announcement-detail/announcement-detail",
        "customers/customers",
        "customer-detail/customer-detail",
        "ledger/ledger",
        "ledger/ledger-edit",
        "membership/membership"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["packageUser"]
    },
    "pages/merchant/tab-daily/tab-daily": {
      "network": "all",
      "packages": ["packageBiz", "packageExtra", "packageContract"]
    }
  },
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#FFF4E7",
    "navigationBarTitleText": "宠物寄养",
    "navigationBarTextStyle": "black",
    "backgroundColor": "#FFF8F0",
    "backgroundColorTop": "#FFF4E7",
    "backgroundColorBottom": "#FFFDF9"
  },
  "tabBar": {
    "custom": true,
    "color": "#999999",
    "selectedColor": "#E98657",
    "backgroundColor": "#FFFDF8",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "images/tab/tab-home.png",
        "selectedIconPath": "images/tab/tab-home-active.png"
      },
      {
        "pagePath": "pages/orders/orders",
        "text": "订单",
        "iconPath": "images/tab/tab-order.png",
        "selectedIconPath": "images/tab/tab-order-active.png"
      },
      {
        "pagePath": "pages/daily/daily",
        "text": "动态",
        "iconPath": "images/tab/tab-daily.png",
        "selectedIconPath": "images/tab/tab-daily-active.png"
      }
    ]
  },
  "usingComponents": {
    "cached-image": "/components/cached-image/cached-image",
    "hidden-admin-entry": "/components/hidden-admin-entry/hidden-admin-entry",
    "oa-follow-banner": "/components/oa-follow-banner/oa-follow-banner",
    "user-banner-ad": "/components/user-banner-ad/user-banner-ad",
    "daily-comments": "/components/daily-comments/daily-comments"
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "permission": {
    "scope.userLocation": {
      "desc": "用于选择寄养地址与接送位置"
    }
  },
  "requiredPrivateInfos": [
    "chooseLocation"
  ]
}
