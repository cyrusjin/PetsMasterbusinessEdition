<view class="oa-follow-banner" wx:if="{{visible}}" bindtap="onFollowTap">
  <text class="oa-follow-title">{{bannerText}}</text>
  <view class="oa-follow-btn" catchtap="onFollowTap">关注</view>
</view>
<oa-follow-sheet
  show="{{showSheet}}"
  title="{{sheetTitle}}"
  headline="{{sheetHeadline}}"
  desc="{{sheetDesc}}"
  bind:close="onSheetClose"
  bind:followed="onSheetFollowed"
/>
