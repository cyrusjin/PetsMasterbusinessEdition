.user-banner-ad {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  height: 168rpx;
  z-index: 9990;
  overflow: hidden;
  background: #FFF1E7;
  box-shadow: 0 -4rpx 16rpx rgba(132, 90, 58, 0.08);
}

.user-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}

.user-banner-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(90deg, #FFF1E7 0%, #F6D7C0 100%);
  color: #A98972;
  font-size: 24rpx;
}

.user-banner-badge {
  position: absolute;
  left: 12rpx;
  top: 10rpx;
  padding: 2rpx 8rpx;
  font-size: 18rpx;
  line-height: 1.3;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(61, 43, 31, 0.38);
  border-radius: 6rpx;
}
