.insurance-sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 13000;
}

.insurance-sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(21, 16, 12, 0.52);
}

.insurance-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  max-height: 84vh;
  padding: 20rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, #fff9f3 0%, #ffffff 42%);
  text-align: center;
}

.insurance-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #e7d7ca;
}

.insurance-sheet-close {
  position: absolute;
  top: 20rpx;
  right: 28rpx;
  width: 56rpx;
  height: 56rpx;
  color: #8f7968;
  font-size: 44rpx;
  line-height: 52rpx;
}

.insurance-sheet-brand {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #e85b18;
  background: #fff0e8;
  font-size: 23rpx;
  font-weight: 600;
}

.insurance-sheet-title {
  display: block;
  margin-top: 14rpx;
  color: #32251c;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.insurance-sheet-desc {
  display: block;
  margin-top: 6rpx;
  color: #806b5c;
  font-size: 25rpx;
}

.insurance-qr-card {
  width: 356rpx;
  height: 356rpx;
  box-sizing: border-box;
  margin: 18rpx auto 0;
  padding: 12rpx;
  border: 1rpx solid #f2dfd1;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(117, 70, 40, 0.12);
}

.insurance-qrcode {
  display: block;
  width: 332rpx;
  height: 332rpx;
  border-radius: 14rpx;
}

.insurance-sheet-hint {
  display: block;
  margin: 14rpx 0 18rpx;
  color: #8f7968;
  font-size: 22rpx;
}

.insurance-buy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 86rpx;
  margin: 0;
  padding: 18rpx 28rpx;
  box-sizing: border-box;
  border: none;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #f47a2a 0%, #e85b18 100%);
  box-shadow: 0 12rpx 24rpx rgba(232, 91, 24, 0.24);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.2;
}

.insurance-buy-btn::after {
  border: none;
}

.insurance-sheet-note {
  display: block;
  margin-top: 14rpx;
  color: #a38e80;
  font-size: 20rpx;
  line-height: 1.45;
}
