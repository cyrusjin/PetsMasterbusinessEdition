.auth-inline {
  margin-bottom: 20rpx;
}

.auth-inline-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000;
  margin-bottom: 12rpx;
}

.auth-inline-tip {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.auth-phone-group {
  margin-bottom: 8rpx;
}

.auth-phone-btn {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  margin: 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #E98657;
  font-weight: 500;
  white-space: nowrap;
  line-height: 1.2;
}

.auth-phone-btn::after {
  border: none;
}

.auth-save-btn {
  margin-top: 16rpx;
}

.auth-nickname-input {
  height: 80rpx;
}
