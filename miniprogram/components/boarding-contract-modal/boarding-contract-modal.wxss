.contract-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
}

.contract-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.contract-modal-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88vh;
  max-height: 88vh;
  background: #F2DEC9;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.contract-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F2DEC9;
  flex-shrink: 0;
}

.contract-modal-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  padding-right: 16rpx;
}

.contract-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999999;
  flex-shrink: 0;
}

.contract-modal-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 24rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.contract-paper {
  background: #FFFFFF;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  padding: 40rpx 32rpx 48rpx;
  color: #333333;
}

.contract-doc-title {
  display: block;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #000000;
  letter-spacing: 2rpx;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #F2DEC9;
}

.contract-parties {
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.party-block {
  margin-bottom: 24rpx;
}
.party-block:last-child {
  margin-bottom: 0;
}

.party-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #E98657;
  margin-bottom: 12rpx;
}

.party-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.8;
  color: #333333;
}

.contract-info-box {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border: 2rpx solid #F2DEC9;
  border-radius: 12rpx;
}

.info-box-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 16rpx;
}

.info-line {
  display: block;
  font-size: 26rpx;
  line-height: 1.85;
  color: #333333;
}

.contract-section {
  margin-bottom: 28rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 16rpx;
}

.section-item {
  display: block;
  font-size: 26rpx;
  line-height: 1.9;
  color: #333333;
  margin-bottom: 12rpx;
  text-align: justify;
}

.contract-footer {
  display: block;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #F2DEC9;
  font-size: 24rpx;
  line-height: 1.8;
  color: #666666;
  text-align: center;
}

.sign-stamp {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFF1E7;
  border-radius: 12rpx;
  border: 2rpx solid #F2C39E;
}

.sign-stamp-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #E98657;
  margin-bottom: 12rpx;
}

.sign-stamp-line {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
}

.contract-modal-footer {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #F2DEC9;
  box-sizing: border-box;
}

.sign-tip {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.btn-sign {
  width: 100%;
  min-height: 88rpx;
  height: auto;
  padding: 22rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E98657;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  border-radius: 12rpx;
  border: none;
  margin: 0;
  white-space: nowrap;
}
.btn-sign::after {
  border: none;
}
