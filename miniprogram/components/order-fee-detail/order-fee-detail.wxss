.order-fee-detail {
  font-size: 28rpx;
  color: #333333;
}

.fee-breakdown {
  margin-top: 8rpx;
  padding-top: 8rpx;
}

.fee-breakdown-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

.fee-day-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.4;
}

.fee-day-date {
  width: 96rpx;
  flex-shrink: 0;
}

.fee-day-label {
  flex: 1;
  min-width: 0;
}

.fee-day-factor {
  width: 72rpx;
  text-align: center;
  flex-shrink: 0;
  color: #999999;
}

.fee-day-amount {
  width: 88rpx;
  text-align: right;
  flex-shrink: 0;
  color: #333333;
}

.fee-total-row {
  padding-top: 12rpx;
  margin-top: 12rpx;
  border-top: 1rpx solid #F2DEC9;
  font-size: 28rpx;
}

.charge-summary-tip,
.price-adjusted-tip,
.deposit-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #999999;
}

.price-adjusted-tip {
  color: #F57C00;
}

.fee-extra-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
}

.fee-sub-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  padding-left: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.fee-sub-name {
  flex: 1;
  min-width: 0;
  color: #999999;
}

.fee-sub-amount {
  flex-shrink: 0;
  color: #666666;
}

.fee-grand-total {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2DEC9;
  font-size: 30rpx;
  font-weight: 600;
}

.copyable-fee {
  color: #E98657;
}
