.merchant-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: calc(100rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 248, 0.96);
  border-top: 1rpx solid #F2DEC9;
  box-shadow: 0 -8rpx 28rpx rgba(132, 90, 58, 0.08);
  z-index: 10000;
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  color: #B9A89B;
}

.tab-item.active {
  color: #E98657;
}

.tab-icon-v2 { position: relative; display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 14rpx; color: #a9988c; background: #f1ebe6; transition: all .18s ease; }
.tab-symbol { position: relative; display: block; color: inherit; box-sizing: border-box; }
.tab-icon-check-in .tab-symbol { width: 25rpx; height: 25rpx; border: 3rpx solid currentColor; border-radius: 8rpx; }
.tab-icon-check-in .tab-symbol::before { content: ''; position: absolute; left: 4rpx; top: 8rpx; width: 10rpx; height: 5rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }
.tab-icon-check-in .tab-symbol::after { content: ''; position: absolute; left: 3rpx; right: 3rpx; top: -6rpx; height: 7rpx; border-left: 3rpx solid currentColor; border-right: 3rpx solid currentColor; }
.tab-gift { position: absolute; right: -16rpx; top: -18rpx; width: 28rpx; height: 28rpx; pointer-events: none; z-index: 3; animation: tabGiftBounce 1.15s ease-in-out infinite; }
.tab-gift-box { font-size: 22rpx; line-height: 1; display: block; filter: drop-shadow(0 4rpx 6rpx rgba(176, 92, 42, .28)); }
.tab-gift-spark { position: absolute; width: 6rpx; height: 6rpx; border-radius: 50%; background: #ffd36b; box-shadow: 0 0 8rpx #ffd36b; animation: tabGiftSpark 1.15s ease-in-out infinite; }
.tab-gift-spark-one { left: -4rpx; top: 2rpx; }
.tab-gift-spark-two { right: -2rpx; bottom: 0; animation-delay: .35s; }
.tab-item.active .tab-gift-box { filter: drop-shadow(0 4rpx 8rpx rgba(255, 214, 140, .45)); }
.tab-icon-daily .tab-symbol { width: 7rpx; height: 7rpx; margin: -9rpx 9rpx 9rpx -9rpx; border-radius: 2rpx; background: currentColor; box-shadow: 13rpx 0 0 currentColor, 0 13rpx 0 currentColor, 13rpx 13rpx 0 currentColor; }
.tab-icon-statistics .tab-symbol { width: 6rpx; height: 13rpx; margin: 10rpx 18rpx 0 0; border-radius: 2rpx 2rpx 0 0; background: currentColor; box-shadow: 9rpx -7rpx 0 currentColor, 18rpx -14rpx 0 currentColor; }
.tab-icon-store .tab-symbol { width: 25rpx; height: 20rpx; margin-top: 8rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 4rpx 4rpx; }
.tab-icon-store .tab-symbol::before { content: ''; position: absolute; left: 2rpx; top: -10rpx; width: 15rpx; height: 15rpx; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; transform: rotate(45deg); }
.tab-item.active .tab-icon-v2 { color: #fff; background: linear-gradient(145deg, #f09b72, #df734f); box-shadow: 0 6rpx 14rpx rgba(218, 103, 69, .24); transform: translateY(-1rpx); }

.tab-text {
  font-size: 22rpx;
  margin-top: 6rpx;
  font-weight: 500;
  line-height: 1.2;
}

.tab-hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
}

.open-success-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.open-success-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 28, 20, 0.5);
}

.open-success-panel {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  background: linear-gradient(165deg, #FFF6EE 0%, #FFFFFF 38%, #FFFCF8 100%);
  border-radius: 36rpx;
  padding: 44rpx 36rpx 32rpx;
  box-sizing: border-box;
  z-index: 1;
  overflow: hidden;
  box-shadow: 0 28rpx 72rpx rgba(233, 134, 87, 0.22);
  border: 2rpx solid rgba(255, 214, 186, 0.65);
}

.open-success-pets {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 120rpx;
  pointer-events: none;
}

.open-success-pet {
  position: absolute;
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.92;
}

.open-success-pet-dog {
  left: 28rpx;
  top: 22rpx;
  transform: rotate(-12deg);
}

.open-success-pet-cat {
  right: 32rpx;
  top: 18rpx;
  transform: rotate(10deg);
  font-size: 44rpx;
}

.open-success-pet-paw {
  left: 50%;
  top: 8rpx;
  margin-left: -18rpx;
  font-size: 28rpx;
  opacity: 0.55;
}

.open-success-badge {
  width: 84rpx;
  height: 84rpx;
  margin: 8rpx auto 16rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFE8D6 0%, #FFF1E7 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(233, 134, 87, 0.16);
}

.open-success-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  min-height: 48rpx;
}

.open-success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D2B1F;
  text-align: center;
}

.open-success-close {
  position: absolute;
  right: -8rpx;
  top: -52rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #C4B0A0;
}

.open-success-lead {
  display: block;
  font-size: 28rpx;
  line-height: 1.55;
  color: #7A6556;
  text-align: center;
  padding: 0 8rpx;
}

.open-success-emoji-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 22rpx 0 8rpx;
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.95;
}

.open-success-actions {
  margin-top: 28rpx;
}

.open-success-btn {
  position: relative;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.open-success-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  pointer-events: none;
}

.open-success-btn-hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
  z-index: 2;
}

.open-success-btn-hit::after {
  border: none;
}

.open-success-btn-primary {
  background: linear-gradient(90deg, #F09A68 0%, #E98657 55%, #E07542 100%);
  box-shadow: 0 12rpx 28rpx rgba(233, 134, 87, 0.32);
}

.open-success-btn-primary .open-success-btn-text {
  color: #ffffff;
}

.open-success-advanced-link {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F2E4D8;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.open-success-advanced-title {
  font-size: 26rpx;
  color: #E98657;
  font-weight: 600;
}

.open-success-advanced-hint {
  font-size: 22rpx;
  color: #B9A89B;
}

@keyframes tabGiftBounce {
  0%, 100% { transform: translateY(0) rotate(-8deg) scale(1); }
  40% { transform: translateY(-7rpx) rotate(8deg) scale(1.12); }
  70% { transform: translateY(-2rpx) rotate(-4deg) scale(1.04); }
}

@keyframes tabGiftSpark {
  0%, 100% { opacity: .2; transform: scale(.6); }
  50% { opacity: 1; transform: scale(1.15); }
}
