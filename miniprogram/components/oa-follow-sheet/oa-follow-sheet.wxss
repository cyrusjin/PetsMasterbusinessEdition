.oa-sheet-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20000;
}

.oa-sheet-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 28, 20, 0.45);
}

.oa-sheet-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 72vh;
  padding: 18rpx 40rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFDF9;
  box-shadow: 0 -12rpx 40rpx rgba(132, 90, 58, 0.16);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oa-sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E8D5C4;
  margin-bottom: 8rpx;
}

.oa-sheet-close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 34rpx;
  color: #B9A89B;
  font-weight: 400;
}

.oa-sheet-title {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #E98657;
  line-height: 1.3;
}

.oa-sheet-headline {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #5B4535;
  line-height: 1.3;
  text-align: center;
}

.oa-sheet-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #A98972;
  line-height: 1.4;
  text-align: center;
}

.oa-sheet-qr-wrap {
  position: relative;
  margin-top: 28rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(132, 90, 58, 0.1);
}

.oa-sheet-qr-wrap--loading,
.oa-sheet-qr-wrap--error {
  width: 280rpx;
  min-height: 280rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-left: auto;
  margin-right: auto;
}

.oa-sheet-qr-status {
  padding: 0 16rpx;
  font-size: 24rpx;
  color: #8C6B54;
  line-height: 1.5;
  text-align: center;
}

.oa-sheet-qr-retry {
  font-size: 24rpx;
  color: #E98657;
  font-weight: 700;
}

.oa-sheet-qr {
  width: 280rpx;
  height: 280rpx;
  display: block;
}

.oa-sheet-qr-badge {
  position: absolute;
  left: 50%;
  bottom: 28rpx;
  transform: translateX(-50%);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(91, 69, 53, 0.78);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.oa-sheet-hint {
  margin-top: 22rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  color: #8C6B54;
  line-height: 1.5;
  text-align: center;
  font-weight: 600;
}

.oa-sheet-subhint {
  margin-top: 10rpx;
  padding: 0 12rpx 8rpx;
  font-size: 22rpx;
  color: #B4937B;
  line-height: 1.4;
  text-align: center;
}
