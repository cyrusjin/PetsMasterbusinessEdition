.cs-entry {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.92);
}

.cs-entry-text {
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.cs-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 21000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.cs-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 28, 20, 0.45);
}

.cs-panel {
  position: relative;
  width: 100%;
  max-width: 560rpx;
  background: #FFFDF9;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 48rpx rgba(132, 90, 58, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.cs-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 34rpx;
  color: #B9A89B;
}

.cs-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5B4535;
  line-height: 1.3;
}

.cs-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #A98972;
  line-height: 1.5;
  text-align: center;
}

.cs-qr {
  width: 360rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
  background: #fff;
}

.cs-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #C87A4B;
  line-height: 1.4;
  text-align: center;
}

.cs-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
