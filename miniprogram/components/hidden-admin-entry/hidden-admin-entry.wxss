.admin-pwd-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.admin-pwd-panel {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.admin-pwd-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #E98657;
  margin-bottom: 12rpx;
}

.admin-pwd-desc {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 32rpx;
}

.admin-pwd-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 32rpx;
}

.admin-pwd-actions {
  display: flex;
  gap: 16rpx;
}

.admin-pwd-btn {
  flex: 1;
  min-height: 80rpx;
  height: auto;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}

.admin-pwd-btn::after {
  border: none;
}

.admin-pwd-btn.cancel {
  background: #F7F8FA;
  color: #666666;
}

.admin-pwd-btn.confirm {
  background: #E98657;
  color: #ffffff;
}
