.sign-pad { background: #fff; border-radius: 16rpx; overflow: hidden; }
.sign-canvas-wrap {
  width: 100%;
  height: 300rpx;
  background: #F7F8FA;
  border: 2rpx dashed #F2DEC9;
  border-radius: 16rpx;
}
.sign-canvas { width: 100%; height: 100%; }
.sign-actions { display: flex; gap: 20rpx; margin-top: 20rpx; justify-content: center; }
