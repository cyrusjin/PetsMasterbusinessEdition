.user-native-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 21000;
}

.user-native-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 28, 20, 0.48);
}

.user-native-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFDF9;
  box-shadow: 0 -12rpx 40rpx rgba(132, 90, 58, 0.16);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.user-native-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E8D5C4;
  margin: 0 auto 12rpx;
}

.user-native-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #B9A89B;
  z-index: 2;
}

.user-native-badge {
  position: absolute;
  top: 28rpx;
  left: 32rpx;
  padding: 4rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #A98972;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 6rpx;
  z-index: 2;
}

.user-native-cover {
  width: 100%;
  height: 52vh;
  max-height: 720rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFF1E7;
}

.user-native-image {
  width: 100%;
  height: 100%;
  display: block;
}

.user-native-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: linear-gradient(180deg, #FFF1E7 0%, #F6D7C0 100%);
  color: #A98972;
  font-size: 24rpx;
  line-height: 1.4;
}

.user-native-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #5B4535;
  line-height: 1.3;
}

.user-native-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #A98972;
  line-height: 1.45;
}

.user-native-cta {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: #E98657;
  border-radius: 16rpx;
}

.user-native-cta-hover {
  opacity: 0.88;
}

.user-native-skip {
  margin-top: 8rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #B9A89B;
}
