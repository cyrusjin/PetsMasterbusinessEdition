<view class="container">
  <view class="order-tabs">
    <view class="order-tab {{tab === 'all' ? 'active' : ''}}" bindtap="onTab" data-tab="all">全部</view>
    <view class="order-tab {{tab === 'pending' ? 'active' : ''}}" bindtap="onTab" data-tab="pending">
      <text>待确认</text>
      <text class="tab-badge" wx:if="{{pendingBadge > 0}}">{{pendingBadge > 99 ? '99+' : pendingBadge}}</text>
    </view>
    <view class="order-tab {{tab === 'awaiting_arrival' ? 'active' : ''}}" bindtap="onTab" data-tab="awaiting_arrival">待开始</view>
    <view class="order-tab {{tab === 'boarding' ? 'active' : ''}}" bindtap="onTab" data-tab="boarding">进行中</view>
    <view class="order-tab {{tab === 'completed' ? 'active' : ''}}" bindtap="onTab" data-tab="completed">已完成</view>
  </view>

  <view class="service-tabs" wx:if="{{showServiceTabs}}">
    <view
      class="service-tab {{serviceTab === item.key ? 'active' : ''}}"
      wx:for="{{serviceTabs}}"
      wx:key="key"
      bindtap="onServiceTab"
      data-tab="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <view class="date-filter">
    <view class="date-preset-row">
      <view class="date-preset {{datePreset === 'today' ? 'active' : ''}}" bindtap="onDatePreset" data-key="today">今天</view>
      <view class="date-preset {{datePreset === 'week' ? 'active' : ''}}" bindtap="onDatePreset" data-key="week">本周</view>
      <view class="date-preset {{datePreset === 'month' ? 'active' : ''}}" bindtap="onDatePreset" data-key="month">本月</view>
      <view
        class="date-preset-clear {{filterStartDate || filterEndDate ? '' : 'disabled'}}"
        bindtap="onClearDateFilter"
      >清除</view>
    </view>
    <view class="date-range-row">
      <picker mode="date" value="{{filterStartDate || todayDate}}" bindchange="onFilterStartDate">
        <view class="date-range-box {{filterStartDate ? '' : 'placeholder'}}">{{filterStartDate || '开始日期'}}</view>
      </picker>
      <text class="date-range-sep">至</text>
      <picker mode="date" value="{{filterEndDate || todayDate}}" bindchange="onFilterEndDate">
        <view class="date-range-box {{filterEndDate ? '' : 'placeholder'}}">{{filterEndDate || '结束日期'}}</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <text>加载中...</text>
  </view>

  <block wx:elif="{{filtered.length > 0}}">
    <view class="card" wx:for="{{filtered}}" wx:key="id">
      <view class="flex-between mb-16">
        <view class="flex-row gap-16">
          <cached-image wx:if="{{item.petPhoto}}" src="{{item.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
          <view wx:else class="pet-avatar-small">{{item.petName ? item.petName[0] : '宠'}}</view>
          <view>
            <view class="order-name-row">
              <text class="boarding-name">{{item.petName}}</text>
              <text class="service-tag" wx:if="{{item.serviceLabel}}">{{item.serviceLabel}}</text>
            </view>
            <text class="text-gray order-subline">{{item.petType}} · {{item.serviceType}}</text>
            <text class="text-gray order-subline">品种：{{item.petBreed || '--'}} · {{item.petGender || '--'}} · {{item.petAgeText}}</text>
            <text class="text-gray order-subline">下单：{{item.createTimeText}}</text>
            <text class="text-gray order-subline">{{item.serviceTimeLabel}}：{{item.serviceTimeText}}</text>
            <text class="text-gray order-subline" wx:if="{{item.userNickName}}">宠主：{{item.userNickName}}</text>
          </view>
        </view>
        <view class="status-badge {{item.editPendingConfirm ? 'status-price-pending' : (item.pricePendingConfirm ? 'status-price-pending' : 'status-' + item.status)}}">
          <text wx:if="{{item.editPendingConfirm}}">改单待确认</text>
          <text wx:elif="{{item.pricePendingConfirm}}">待确认价格</text>
          <text wx:elif="{{item.status === 'pending'}}">待确认</text>
          <text wx:elif="{{item.status === 'confirmed'}}">{{item.statusLabel || '待签协议'}}</text>
          <text wx:elif="{{item.status === 'completed'}}">已完成</text>
          <text wx:elif="{{item.status === 'cancelled'}}">已取消</text>
          <text wx:else>{{item.statusLabel || '已取消'}}</text>
        </view>
      </view>
      <view class="order-info">
        <view class="order-info-texts">
          <view class="order-no-row">
            <text class="text-gray">订单号：</text>
            <text class="copyable-order-no" catchtap="onCopyOrderNo" data-no="{{item.displayNo}}">{{item.displayNo}}</text>
          </view>
        </view>
        <text class="fee-highlight" style="font-size:28rpx;">¥{{item.totalFee}}</text>
      </view>
      <view class="price-pending-tip" wx:if="{{item.editPendingConfirm}}">
        <text>宠主申请修改订单，请确认后生效</text>
        <view wx:for="{{item.pendingEditLines}}" wx:for-item="line" wx:key="*this" style="margin-top:6rpx;">{{line}}</view>
        <text wx:if="{{item.pendingEditTotalFee != null}}" style="display:block;margin-top:6rpx;">确认后费用 ¥{{item.pendingEditTotalFee}}</text>
      </view>
      <view class="price-pending-tip" wx:elif="{{item.pricePendingConfirm}}">价格待用户确认，暂不可操作订单</view>
      <view class="order-actions">
        <button wx:if="{{item.editPendingConfirm}}" class="btn-sm btn-green" bindtap="onConfirmUserEdit" data-id="{{item.id}}">确认改单</button>
        <button wx:if="{{item.editPendingConfirm}}" class="btn-sm btn-danger-outline" bindtap="onRejectUserEdit" data-id="{{item.id}}">拒绝改单</button>
        <button wx:if="{{item.status === 'pending' && !item.pricePendingConfirm && !item.editPendingConfirm}}" class="btn-sm btn-green" bindtap="onAccept" data-id="{{item.id}}">确认接单</button>
        <button wx:if="{{item.status === 'pending' && !item.pricePendingConfirm && !item.editPendingConfirm}}" class="btn-sm btn-danger-outline" bindtap="onReject" data-id="{{item.id}}">拒绝</button>
        <button wx:if="{{item.status === 'awaiting_arrival' && !item.pricePendingConfirm && !item.editPendingConfirm}}" class="btn-sm btn-green" bindtap="onConfirmArrival" data-id="{{item.id}}">{{item.startActionLabel || '确认到店'}}</button>
        <button wx:if="{{item.canDailyCheck && !item.pricePendingConfirm && !item.editPendingConfirm}}" class="btn-sm btn-blue" bindtap="onDailyCheck" data-id="{{item.id}}">去打卡</button>
        <button wx:if="{{(item.status === 'boarding' || (item.canDailyCheck && item.status === 'awaiting_arrival')) && !item.pricePendingConfirm && !item.editPendingConfirm}}" class="btn-sm btn-red" bindtap="onComplete" data-id="{{item.id}}">{{item.completeActionLabel || '结束寄养'}}</button>
        <button wx:if="{{(item.status === 'pending' || item.status === 'awaiting_arrival' || item.status === 'boarding') && !item.pricePendingConfirm}}" class="btn-sm btn-orange" bindtap="onEditPrice" data-id="{{item.id}}">修改价格</button>
        <button class="btn-sm btn-gray" bindtap="onDetail" data-id="{{item.id}}">详情</button>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">{{loadError || ((tab !== 'all' || serviceTab !== 'all' || filterStartDate || filterEndDate) ? '暂无符合筛选条件的订单' : '暂无订单')}}</text>
  </view>
</view>
