.order-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 24rpx;
  padding-left: 4rpx;
  padding-right: 4rpx;
}

.order-tab.active {
  background: transparent;
  color: #000000;
  font-weight: 700;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: #E98657;
  border-radius: 3rpx;
}

.tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: #E53935;
  border-radius: 16rpx;
  font-weight: 600;
}

.order-tab.active .tab-badge {
  background: #E98657;
  color: #fff;
}

.order-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F2DEC9;
  gap: 16rpx;
}

.order-info-texts {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.order-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.order-actions .btn-sm {
  width: 100%;
  min-width: 0;
}

.order-subline {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

.price-pending-tip {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #E65100;
  background: #FFF3E0;
  border-radius: 12rpx;
  line-height: 1.5;
}

.service-tabs {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin-bottom: 16rpx;
  padding: 8rpx;
  box-shadow: var(--shadow-card);
}

.service-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  border-radius: 12rpx;
}

.service-tab.active {
  background: #E98657;
  color: #FFFFFF;
  font-weight: 600;
}

.date-filter {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx 20rpx;
  box-shadow: var(--shadow-card);
}

.date-preset-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.date-preset {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #666666;
  background: #F7F8FA;
  border-radius: 999rpx;
}

.date-preset.active {
  color: #FFFFFF;
  background: #E98657;
  font-weight: 600;
}

.date-preset-clear {
  margin-left: auto;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #E98657;
}

.date-preset-clear.disabled {
  color: #CCCCCC;
}

.date-range-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-range-row picker {
  flex: 1;
  min-width: 0;
}

.date-range-box {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333333;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.date-range-box.placeholder {
  color: #999999;
}

.date-range-sep {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #999999;
}

.order-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.service-tag {
  font-size: 20rpx;
  color: #E98657;
  background: #FFF1E7;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}
