.loading-state { padding: 80rpx 0; text-align: center; }
.filter-bar {
  display: flex;
  align-items: stretch;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(233, 134, 87, 0.08);
  overflow: hidden;
}
.filter-bar picker {
  flex: 1;
  min-width: 0;
}
.filter-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 18rpx 24rpx;
}
.filter-item-label {
  font-size: 22rpx;
  color: #999999;
}
.filter-item-value-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.filter-item-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filter-item-arrow {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #E98657;
}
.filter-divider {
  width: 2rpx;
  margin: 20rpx 0;
  background: #F2DEC9;
  flex-shrink: 0;
}
.timeline { padding-top: 8rpx; }
.timeline-group { margin-bottom: 24rpx; }
.timeline-date { padding: 0 8rpx 16rpx; }
.timeline-date-text { font-size: 28rpx; font-weight: 700; color: #333333; }
.timeline-list { display: flex; flex-direction: column; gap: 20rpx; }
.timeline-item { display: flex; gap: 16rpx; }
.timeline-axis { width: 24rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.timeline-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #E98657; margin-top: 28rpx; flex-shrink: 0; }
.timeline-line { width: 2rpx; flex: 1; background: #F2DEC9; margin-top: 8rpx; min-height: 40rpx; }
.timeline-item:last-child .timeline-line { display: none; }
.timeline-card { flex: 1; padding: 24rpx; margin-bottom: 0; }
.timeline-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; margin-bottom: 12rpx; }
.timeline-pet-name { display: block; font-size: 30rpx; font-weight: 600; color: #333333; }
.timeline-time { display: block; font-size: 22rpx; color: #999999; margin-top: 4rpx; }
.timeline-desc { font-size: 26rpx; color: #666666; line-height: 1.5; margin: 12rpx 0; }
.daily-checks { display: flex; flex-wrap: wrap; gap: 8rpx; }
.media-thumbs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.media-thumb-wrap { display: inline-block; line-height: 0; }
.media-thumb { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #FFF1E7; }
.video-thumb { position: relative; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #E98657, #F7AA78); overflow: hidden; }
.video-thumb.has-cover { background: #FFF1E7; }
.video-play-icon { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); color: #fff; font-size: 36rpx; margin-left: 6rpx; z-index: 1; }
.tag-orange { background: #FFF1E7; color: #E98657; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; flex-shrink: 0; }
.tag-schedule { background: #E8F3FF; color: #2F6FED; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; flex-shrink: 0; }
.tag-unviewed { background: #FFF1E7; color: #E98657; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; flex-shrink: 0; }
.tag-viewed { background: #E8F8EF; color: #1F9D55; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; flex-shrink: 0; }
.timeline-head-tags { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }
.timeline-share-btn {
  width: auto !important;
  height: auto !important;
  min-width: 0;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #FFF1E7;
  line-height: 1;
  font-size: 0;
  box-sizing: border-box;
  overflow: hidden;
}
.timeline-share-btn::after { border: none; }
.timeline-share-btn-hover { opacity: 0.75; }
.timeline-share-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  padding: 0 16rpx 0 12rpx;
  box-sizing: border-box;
}
.timeline-share-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
  display: block;
}
.timeline-share-text {
  display: block;
  font-size: 22rpx;
  color: #E98657;
  font-weight: 500;
  line-height: 28rpx;
  height: 28rpx;
  white-space: nowrap;
}
.schedule-banner {
  margin: 0 0 12rpx;
  padding: 12rpx 16rpx;
  background: #E8F3FF;
  border-radius: 12rpx;
}
.schedule-banner-text {
  font-size: 22rpx;
  color: #2F6FED;
  line-height: 1.4;
}
.timeline-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
}
/* 覆盖微信原生 button 默认 100% 宽与大字号 */
.timeline-action-btn {
  width: auto !important;
  min-width: 0;
  min-height: 0;
  height: auto;
  margin: 0;
  font-size: 24rpx !important;
  font-weight: 500;
  line-height: 1.2;
  padding: 10rpx 24rpx;
}
.timeline-item.scheduled .timeline-dot { background: #2F6FED; }
.timeline-item.scheduled .timeline-card { border: 2rpx solid #D6E6FF; background: #F7FBFF; }
.video-modal { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,0.75); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.video-modal-body { width: 90%; }
.modal-video { width: 100%; height: 420rpx; border-radius: 16rpx; background: #000; }
.video-modal-close { margin-top: 24rpx; text-align: center; color: #fff; font-size: 28rpx; }
