<view class="container">
  <view wx:if="{{showFilterBar}}" class="filter-bar">
    <picker
      mode="selector"
      range="{{petPickerLabels}}"
      value="{{petPickerIndex}}"
      bindchange="onFilterPetChange"
    >
      <view class="filter-item">
        <text class="filter-item-label">宠物</text>
        <view class="filter-item-value-row">
          <text class="filter-item-value">{{selectedPetLabel}}</text>
          <text class="filter-item-arrow">▼</text>
        </view>
      </view>
    </picker>
    <view class="filter-divider"></view>
    <picker
      mode="selector"
      range="{{datePickerLabels}}"
      value="{{datePickerIndex}}"
      bindchange="onFilterDateChange"
    >
      <view class="filter-item">
        <text class="filter-item-label">日期</text>
        <view class="filter-item-value-row">
          <text class="filter-item-value">{{selectedDateLabel}}</text>
          <text class="filter-item-arrow">▼</text>
        </view>
      </view>
    </picker>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text class="text-gray">加载中...</text>
  </view>

  <view wx:elif="{{timeline.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无打卡记录</text>
  </view>

  <view wx:else class="timeline">
    <view class="timeline-group" wx:for="{{timeline}}" wx:key="dateKey" wx:for-item="group" wx:for-index="groupIdx">
      <view class="timeline-date">
        <text class="timeline-date-text">{{group.dateLabel}}</text>
      </view>

      <view class="timeline-list">
        <view class="timeline-item {{log.isScheduled ? 'scheduled' : ''}}" wx:for="{{group.logs}}" wx:key="id" wx:for-item="log" wx:for-index="logIdx">
          <view class="timeline-axis">
            <view class="timeline-dot"></view>
            <view class="timeline-line"></view>
          </view>

          <view class="timeline-card card">
            <view class="timeline-head">
              <view class="flex-row gap-16">
                <cached-image wx:if="{{log.petPhoto}}" src="{{log.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
                <view wx:else class="pet-avatar-small">{{log.petName[0]}}</view>
                <view>
                  <text class="timeline-pet-name">{{log.petName}}</text>
                  <text class="timeline-time">{{log.isScheduled ? '定时发送 ' : ''}}{{log.timeLabel}}</text>
                </view>
              </view>
              <view class="timeline-head-tags">
                <text wx:if="{{log.isScheduled}}" class="tag tag-schedule">定时待发送</text>
                <button
                  wx:if="{{!log.isScheduled}}"
                  class="timeline-share-btn"
                  open-type="share"
                  data-group-index="{{groupIdx}}"
                  data-log-index="{{logIdx}}"
                  hover-class="timeline-share-btn-hover"
                >
                  <view class="timeline-share-inner">
                    <image class="timeline-share-icon" src="/images/icon-share.png" mode="aspectFit" />
                    <text class="timeline-share-text">分享给客人</text>
                  </view>
                </button>
              </view>
            </view>

            <view class="schedule-banner" wx:if="{{log.isScheduled}}">
              <text class="schedule-banner-text">将于 {{log.timeLabel}} 自动发送给宠主</text>
            </view>
            <view class="daily-checks" wx:if="{{log.checks && log.checks.length}}">
              <text class="tag tag-green" wx:for="{{log.checks}}" wx:key="*this" wx:for-item="check">{{check}}</text>
            </view>

            <view class="timeline-desc" wx:if="{{log.description}}">{{log.description}}</view>

            <view class="media-thumbs" wx:if="{{(log.images && log.images.length) || (log.videoItems && log.videoItems.length) || log.videoUrl || log.video}}">
              <view
                class="media-thumb-wrap"
                wx:for="{{log.images}}"
                wx:key="*this"
                wx:for-item="img"
                catchtap="onPreviewImage"
                data-group-index="{{groupIdx}}"
                data-log-index="{{logIdx}}"
                data-url="{{img}}"
              >
                <cached-image src="{{img}}" mode="aspectFill" custom-class="media-thumb" />
              </view>
              <view
                wx:for="{{log.videoItems}}"
                wx:key="url"
                wx:for-item="videoItem"
                wx:for-index="videoIdx"
                class="media-thumb video-thumb {{videoItem.coverUrl ? 'has-cover' : ''}}"
                catchtap="onPreviewVideo"
                data-group-index="{{groupIdx}}"
                data-log-index="{{logIdx}}"
                data-url="{{videoItem.url}}"
                data-video-index="{{videoIdx}}"
              >
                <cached-image
                  wx:if="{{videoItem.coverUrl}}"
                  src="{{videoItem.coverUrl}}"
                  mode="aspectFill"
                  custom-class="media-thumb"
                />
                <text class="video-play-icon">▶</text>
              </view>
            </view>

            <view class="timeline-actions" wx:if="{{log.canDeleteScheduled}}">
              <button
                class="btn-sm btn-blue timeline-action-btn"
                catchtap="onEditScheduled"
                data-group-index="{{groupIdx}}"
                data-log-index="{{logIdx}}"
                disabled="{{deleting}}"
              >修改</button>
              <button
                class="btn-sm btn-danger-outline timeline-action-btn"
                catchtap="onDeleteScheduled"
                data-group-index="{{groupIdx}}"
                data-log-index="{{logIdx}}"
                disabled="{{deleting}}"
              >删除定时</button>
            </view>

            <daily-comments
              wx:if="{{!log.isScheduled}}"
              log-id="{{log.id}}"
              comments="{{log.comments}}"
              disabled="{{log.isScheduled}}"
              bind:change="onCommentsChange"
              data-group-index="{{groupIdx}}"
              data-log-index="{{logIdx}}"
            />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
