.pickup-page {
  min-height: 100vh;
}

.demo-banner {
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.demo-banner-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.6;
}

.leg-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.leg-tab {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
}
.leg-tab.active {
  background: #E98657;
  color: #FFFFFF;
  font-weight: 600;
}
.leg-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E53935;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}
.leg-tab.active .leg-badge {
  background: rgba(255, 255, 255, 0.9);
  color: #E53935;
}

.pickup-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.pickup-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.pickup-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.pickup-avatar-text {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2DEC9;
  color: #E98657;
  font-size: 32rpx;
  font-weight: 600;
}
.pickup-head-main {
  flex: 1;
  min-width: 0;
}
.pickup-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.pickup-pet {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}
.pickup-leg-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F0FF;
  color: #E98657;
}
.pickup-owner {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
}

.pickup-info-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.pickup-label {
  flex-shrink: 0;
  width: 128rpx;
  color: #999999;
}
.pickup-value {
  flex: 1;
  color: #333333;
  word-break: break-all;
}
.pickup-address {
  color: #E98657;
}

.pickup-actions {
  display: flex;
  flex-wrap: nowrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2DEC9;
  overflow-x: auto;
}
.pickup-btn {
  margin: 0 !important;
  padding: 0 24rpx !important;
  min-height: 56rpx !important;
  height: auto !important;
  font-size: 24rpx !important;
  border-radius: 28rpx !important;
  box-sizing: border-box !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
  flex-shrink: 0 !important;
  line-height: 1.2 !important;
}
.pickup-btn::after { border: none; }
.pickup-btn-ghost {
  background: #F7F8FA !important;
  color: #E98657 !important;
  border: 1rpx solid #F2C39E !important;
}
.pickup-btn-primary {
  background: #E98657 !important;
  color: #FFFFFF !important;
  border: none !important;
}

.empty-card {
  text-align: center;
  padding: 80rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
