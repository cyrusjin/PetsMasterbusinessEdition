@import '../../styles/merchant-tab.wxss';

.tip-card {
  background: linear-gradient(145deg, #FFF7EF 0%, #FFE8D6 100%);
  border: 1rpx solid #F2C39E;
}

.tip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.tip-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}

.year-switch {
  font-size: 24rpx;
  color: #E98657;
  padding: 8rpx 16rpx;
  border: 1rpx solid #F2C39E;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.tip-source {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A07858;
}

.loading-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 40rpx 0;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.card-title-row .card-title {
  margin-bottom: 0;
}

.add-date-btn {
  font-size: 24rpx;
  color: #E98657;
  flex-shrink: 0;
}

.group-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0 8rpx;
  margin-bottom: 4rpx;
  border-bottom: 1rpx solid #F2DEC9;
}

.toolbar-select-all {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.toolbar-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.toolbar-batch-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #E98657;
  padding: 8rpx 18rpx;
  border: 1rpx solid #F2C39E;
  border-radius: 999rpx;
  background: #FFF7EF;
}

.holiday-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}

.holiday-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.holiday-row:first-of-type {
  padding-top: 8rpx;
}

.holiday-check {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #D8C0A8;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
  flex-shrink: 0;
  background: #fff;
}

.check-box.checked {
  background: #E98657;
  border-color: #E98657;
}

.holiday-meta {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.holiday-date {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.holiday-name {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.holiday-amount {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.amount-input {
  width: 140rpx;
  height: 64rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.amount-unit {
  font-size: 24rpx;
  color: #666;
}

.remove-day {
  font-size: 22rpx;
  color: #C45C3E;
  padding: 8rpx 4rpx;
}

.empty-days,
.empty-card {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 0 4rpx;
}

.btn-primary {
  margin-top: 8rpx;
}

.add-date-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.add-date-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.add-date-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.add-date-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.add-date-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn-ghost {
  flex: 1;
  background: #F5F5F5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-date-confirm {
  flex: 1;
  margin-top: 0;
}

.batch-set-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.batch-set-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.batch-set-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}
