.landing-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(165deg, #FFF4E7 0%, #FFE8D6 42%, #FFFDF9 100%);
}

.landing-bg-paw {
  position: absolute;
  border-radius: 50%;
  opacity: 0.14;
  background: #E98657;
}

.landing-bg-paw-a {
  width: 280rpx;
  height: 280rpx;
  top: -80rpx;
  right: -60rpx;
}

.landing-bg-paw-b {
  width: 220rpx;
  height: 220rpx;
  bottom: 120rpx;
  left: -70rpx;
}

.landing-shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.landing-badge {
  align-self: center;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(233, 134, 87, 0.14);
  color: #C96E42;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 36rpx;
}

.landing-badge-muted {
  background: rgba(0, 0, 0, 0.06);
  color: #666666;
}

.landing-spinner {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 28rpx;
  border: 5rpx solid rgba(233, 134, 87, 0.18);
  border-top-color: #E98657;
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
}

.landing-spinner-small {
  width: 36rpx;
  height: 36rpx;
  margin: 0 16rpx 0 0;
  border-width: 4rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.landing-title,
.fail-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #2F2F2F;
  margin-bottom: 12rpx;
}

.landing-desc,
.fail-desc {
  display: block;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.7;
  color: #666666;
  margin-bottom: 8rpx;
}

.store-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.store-logo-wrap {
  width: 152rpx;
  height: 152rpx;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(233, 134, 87, 0.22);
  margin-bottom: 24rpx;
  background: #FFFFFF;
}

.store-logo,
.store-logo-fallback {
  width: 152rpx;
  height: 152rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-logo-fallback {
  font-size: 64rpx;
  background: #FFF1E7;
}

.store-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1F1F;
  text-align: center;
  margin-bottom: 8rpx;
}

.store-address {
  font-size: 24rpx;
  color: #888888;
  text-align: center;
  line-height: 1.5;
  padding: 0 24rpx;
}

.welcome-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(233, 134, 87, 0.1);
  margin-bottom: 24rpx;
}

.welcome-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #E98657;
  margin-bottom: 14rpx;
}

.welcome-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.75;
  color: #555555;
}

.perk-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.perk-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(242, 222, 201, 0.9);
}

.perk-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.perk-body {
  flex: 1;
  min-width: 0;
}

.perk-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.perk-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #777777;
}

.welcome-title-error {
  color: #E53935;
}

.jump-fail-banner {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(242, 222, 201, 0.9);
  text-align: center;
}

.jump-fail-badge {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.06);
  color: #666666;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.jump-fail-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2F2F2F;
  margin-bottom: 8rpx;
}

.jump-fail-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.action-area {
  margin-top: auto;
}

.jump-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: #666666;
  font-size: 28rpx;
}

.landing-btn {
  width: 100%;
  min-height: 92rpx;
  line-height: 1.3;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0A078 0%, #E98657 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(233, 134, 87, 0.28);
}

.landing-btn-hover {
  opacity: 0.92;
}

.landing-btn::after {
  border: none;
}

.action-tip {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
}
