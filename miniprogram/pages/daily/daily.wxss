.daily-item { padding: 24rpx 30rpx; }
.daily-time { font-size: 22rpx; flex-shrink: 0; margin-left: 12rpx; }
.daily-checks { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 12rpx; }
.daily-desc { font-size: 28rpx; color: #333333; line-height: 1.6; margin-bottom: 12rpx; }
.daily-media { display: flex; flex-wrap: wrap; gap: 12rpx; }
.daily-img-wrap { display: inline-block; line-height: 0; }
.daily-img { width: 200rpx; height: 200rpx; border-radius: 16rpx; background: #F2DEC9; }
.daily-video-thumb { position: relative; width: 200rpx; height: 200rpx; border-radius: 16rpx; background: linear-gradient(135deg, #E98657, #F7AA78); overflow: hidden; }
.daily-video-thumb.has-cover { background: #F2DEC9; }
.daily-video-cover { width: 200rpx; height: 200rpx; border-radius: 16rpx; }
.video-play-badge { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 56rpx; height: 56rpx; border-radius: 50%; background: rgba(0,0,0,0.45); color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; padding-left: 4rpx; }