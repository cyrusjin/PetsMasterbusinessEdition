<view class="home-page has-tab-bar {{showUserBannerAd ? 'has-user-banner-ad' : ''}}">
  <view class="home-custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navTotalHeight}}px;">
    <view class="home-custom-nav-inner" style="height: {{navBarHeight}}px; padding-left: {{navTitlePad}}px; padding-right: {{navTitlePad}}px;">
      <text class="home-nav-title">{{navTitle}}</text>
    </view>
  </view>
  <view class="home-nav-spacer" style="height: {{navTotalHeight}}px;"></view>
  <oa-follow-banner />
  <view class="home-header">
    <view class="greeting">
      <view class="greeting-title-row" wx:if="{{needsNickName}}">
        <text class="greeting-title">Hi，</text>
        <!-- 仅微信 API，不提供手填；新版键盘上方点选，旧版授权弹窗 -->
        <input
          wx:if="{{nickCapMode === 'nickname-input'}}"
          class="greeting-nickname-api"
          type="nickname"
          placeholder="获取微信昵称"
          bindchange="onNickNameFromApi"
          bindblur="onNickNameFromApi"
          bindnicknamereview="onNickNameReview"
        />
        <view
          wx:elif="{{nickCapMode === 'user-profile'}}"
          class="greeting-nickname-api"
          bindtap="onGetNickNameProfile"
        >获取微信昵称</view>
        <view
          wx:else
          class="greeting-nickname-api"
          bindtap="onNickNameUnsupported"
        >获取微信昵称</view>
      </view>
      <text class="greeting-title" wx:else>Hi，{{displayNickName}}</text>
      <text class="greeting-sub">愿每一天都和毛孩子更亲近</text>
    </view>
    <view class="mode-switch-btn" wx:if="{{showMerchantSwitch}}" bindtap="onSwitchToMerchant">切换商家版</view>
  </view>

  <view class="pet-hero" bindtap="onGoPets">
    <view class="pet-hero-copy">
      <view class="section-heading compact">
        <text class="section-heading-text">我的宝贝</text>
        <text class="section-arrow">›</text>
      </view>
      <text class="pet-hero-sub" wx:if="{{petsCount > 0}}">已记录 {{petsCount}} 只毛孩子</text>
      <text class="pet-hero-sub" wx:else>记录成长 · 关爱相伴</text>
      <view class="pill-action">
        <image class="pill-icon" src="/images/card/card-pets.png" mode="aspectFit" />
        <text>{{petsCount > 0 ? '查看档案' : '添加宠物'}}</text>
      </view>
    </view>
    <image class="pet-hero-img" src="/images/home/home-hero-pet-v2.png" mode="aspectFit" />
    <view class="pet-mini-orbit size-{{petPreviewSize}}" wx:if="{{previewPets.length}}">
      <view
        class="pet-mini-card"
        wx:for="{{previewPets}}"
        wx:key="id"
        style="{{item.cardStyle}}"
      >
        <cached-image
          wx:if="{{item.photo}}"
          custom-class="pet-mini-avatar"
          src="{{item.photo}}"
          mode="aspectFill"
        />
        <view wx:else class="pet-mini-avatar fallback">{{item.name ? item.name[0] : '宠'}}</view>
        <view class="pet-mini-info">
          <text class="pet-mini-name">{{item.name || '我的宝贝'}}</text>
          <text class="pet-mini-meta">{{item.breed || item.type || '健康成长中'}}</text>
        </view>
      </view>
      <view class="pet-mini-more" wx:if="{{petsMoreCount > 0}}">+{{petsMoreCount}}</view>
    </view>
  </view>

  <view class="invite-family-bar" bindtap="onOpenInviteFamily">
    <view class="invite-family-copy">
      <text class="invite-family-title">邀请家人</text>
      <text class="invite-family-sub">分享宠物档案，一起接收服务动态</text>
    </view>
    <text class="invite-family-arrow">›</text>
  </view>

  <view class="reserve-card" bindtap="onGoReserve">
    <view class="reserve-copy">
      <text class="reserve-title">{{reserveCardTitle}}</text>
      <text class="reserve-sub">{{reserveCardSub}}</text>
      <view class="reserve-button {{currentStore ? '' : 'reserve-button-disabled'}}">
        <view class="reserve-button-text">{{reserveButtonText}}</view>
        <view class="reserve-button-icon">
          <view class="reserve-button-chevron"></view>
        </view>
      </view>
    </view>
    <image class="reserve-art" src="/images/home/reserve-art-v2.png" mode="aspectFit" />
  </view>

  <view class="status-grid">
    <view class="info-card" bindtap="onGoPetButler">
      <view class="info-card-top">
        <text class="info-title">{{butlerTitle}}</text>
        <text class="section-arrow">›</text>
      </view>
      <text class="info-sub">{{butlerSubText}}</text>
      <image class="info-art health" src="/images/home/ai-butler-art.png" mode="aspectFit" />
      <text class="info-foot">{{butlerFootText}}</text>
    </view>
    <view class="info-card points-card" bindtap="onGoOrders">
      <view class="info-card-top">
        <text class="info-title">我的订单</text>
        <text class="section-arrow">›</text>
      </view>
      <text class="points-num" wx:if="{{boardingPets.length > 0}}">{{boardingPets.length}}</text>
      <text class="points-empty" wx:else>暂无</text>
      <text class="info-sub">{{boardingPets.length > 0 ? '近期服务事项' : '暂无进行中订单'}}</text>
      <image class="info-art points" src="/images/home/orders-art.png" mode="aspectFit" />
      <view class="mini-link">查看订单 ›</view>
    </view>
  </view>

  <view class="card soft-card" wx:if="{{boardingPets.length > 0}}">
    <view class="section-heading">
      <text class="section-heading-text">近期事项</text>
      <text class="section-more">全部 ›</text>
    </view>
    <view class="boarding-item" wx:for="{{boardingPets}}" wx:key="id" bindtap="onGoDaily" data-id="{{item.id}}">
      <view class="boarding-left">
        <cached-image wx:if="{{item.petPhoto}}" src="{{item.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
        <view wx:else class="pet-avatar-small">{{item.petName[0]}}</view>
        <view class="boarding-copy">
          <text class="boarding-name">{{item.petName}}</text>
          <text class="boarding-date">下单：{{item.createTimeText}}</text>
          <text class="boarding-date">{{item.startDate}} ~ {{item.endDate}}</text>
        </view>
      </view>
      <text class="tag tag-green">{{item.statusLabel || (item.status === 'boarding' ? '寄养中' : '待到店')}}</text>
    </view>
  </view>

  <view class="store-section" wx:if="{{currentStore}}">
    <view class="section-heading">
      <text class="section-heading-text">服务门店</text>
    </view>
    <view class="store-card">
      <swiper
        wx:if="{{currentStore.storePhotos.length}}"
        class="store-swiper"
        indicator-dots
        indicator-color="rgba(137,107,85,0.22)"
        indicator-active-color="#E98657"
        autoplay="{{currentStore.storePhotos.length > 1}}"
        circular
        interval="4000"
      >
        <swiper-item wx:for="{{currentStore.storePhotos}}" wx:key="*this">
          <view class="store-swiper-item" bindtap="onPreviewStorePhoto" data-url="{{item}}">
            <cached-image custom-class="store-swiper-img" src="{{item}}" mode="aspectFill" />
          </view>
        </swiper-item>
      </swiper>
      <view class="store-placeholder" wx:else>
        <image class="store-placeholder-img" src="/images/home/home-hero-pet.png" mode="aspectFit" />
      </view>
      <view class="store-body">
        <view class="store-main-row">
          <cached-image custom-class="welcome-avatar" src="{{currentStore.logo}}" default-src="/images/default-avatar.png" mode="aspectFill" />
          <view class="welcome-info">
            <text class="welcome-name">{{currentStore.name}}</text>
            <view
              class="welcome-intro {{introExpandable ? 'welcome-intro-expandable' : ''}}"
              bindtap="onOpenIntroPreview"
              data-expandable="{{introExpandable}}"
            >
              <text class="welcome-sub {{introExpandable ? 'welcome-sub-clamped' : ''}}">{{currentStore.intro || '欢迎预约宠物寄养'}}</text>
              <text class="intro-more-link" wx:if="{{introExpandable}}">查看完整</text>
            </view>
            <view class="intro-photos-grid" wx:if="{{currentStore.introPhotos && currentStore.introPhotos.length}}">
              <view
                class="intro-photo-item"
                wx:for="{{currentStore.introPhotos}}"
                wx:key="*this"
                bindtap="onPreviewIntroPhoto"
                data-url="{{item}}"
              >
                <cached-image custom-class="intro-photo" src="{{item}}" mode="aspectFill" />
              </view>
            </view>
            <text class="welcome-meta" wx:if="{{currentStore.hours}}">营业时间：{{currentStore.hours}}</text>
            <text class="welcome-meta" wx:if="{{currentStore.receptionRangeText}}">接待：{{currentStore.receptionRangeText}}</text>
          </view>
          <view class="store-status {{currentStore.isOpen ? 'open' : (currentStore.status === '未营业' ? 'inactive' : 'closed')}}">{{currentStore.status}}</view>
        </view>
        <view
          wx:if="{{currentStore.address}}"
          class="store-address-row {{currentStore.hasLocation ? 'tappable' : ''}}"
          bindtap="onOpenStoreLocation"
        >
          <text class="store-address-icon">⌖</text>
          <text class="store-address">{{currentStore.address}}</text>
          <text class="store-nav-hint" wx:if="{{currentStore.hasLocation}}">导航 ›</text>
        </view>
        <view
          wx:if="{{currentStore.contactPhone}}"
          class="store-phone-row"
          bindtap="onCallStore"
          data-phone="{{currentStore.contactPhone}}"
        >
          <text class="store-phone-icon">☎</text>
          <text class="store-phone">{{currentStore.contactPhone}}</text>
        </view>
        <view
          wx:if="{{currentStore.wechatId}}"
          class="store-wechat-row"
          bindtap="onCopyStoreWechat"
        >
          <view class="store-wechat-icon">微</view>
          <text class="store-wechat">{{currentStore.wechatId}}</text>
          <text class="store-wechat-hint">复制</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="intro-full-root" wx:if="{{introPreviewVisible}}">
  <view class="intro-full-mask" catchtouchmove="onIntroPreviewTouchMove" bindtap="onCloseIntroPreview"></view>
  <view class="intro-full-sheet">
    <view class="intro-full-head">
      <text class="intro-full-title">店铺介绍</text>
      <text class="intro-full-close" bindtap="onCloseIntroPreview">关闭</text>
    </view>
    <scroll-view scroll-y class="intro-full-body" show-scrollbar="{{false}}">
      <view class="intro-full-text">{{introPreviewContent}}</view>
    </scroll-view>
  </view>
</view>

<view class="reserve-picker-root" wx:if="{{reservePickerVisible}}">
  <view class="reserve-picker-mask" catchtouchmove="onReservePickerTouchMove" bindtap="onCloseReservePicker"></view>
  <view class="reserve-picker-sheet" catchtap="onReservePickerTouchMove">
    <image class="reserve-picker-art" src="/images/booking/service-picker-art.png" mode="aspectFit" aria-hidden="true" />
    <view class="reserve-picker-head">
      <view>
        <text class="reserve-picker-title">选择预约服务</text>
        <text class="reserve-picker-sub">请选择要预约的服务类型</text>
      </view>
      <text class="reserve-picker-close" bindtap="onCloseReservePicker">关闭</text>
    </view>
    <view
      class="reserve-picker-item"
      wx:for="{{homeServiceCards}}"
      wx:key="key"
      catchtap="onPickReserveService"
      data-line="{{item.key}}"
    >
      <view class="reserve-picker-icon">
        <image wx:if="{{item.key === 'boarding'}}" src="/images/card/card-reserve.png" mode="aspectFit" />
        <image wx:elif="{{item.key === 'wash'}}" src="/images/card/card-check.png" mode="aspectFit" />
        <image wx:else src="/images/card/card-camera.png" mode="aspectFit" />
      </view>
      <view class="reserve-picker-copy">
        <text class="reserve-picker-name">{{item.pickerTitle || item.name}}</text>
        <text class="reserve-picker-desc">{{item.homeSub || item.pickerDesc}}</text>
      </view>
      <view class="reserve-picker-arrow"><text>›</text></view>
    </view>
  </view>
</view>

<view class="invite-modal-root" wx:if="{{inviteModalVisible}}">
  <view class="invite-modal-mask" catchtouchmove="onInviteModalTouchMove" bindtap="onCloseInviteFamily"></view>
  <view class="invite-modal-sheet" catchtap="onInviteModalTouchMove">
    <view class="invite-modal-head">
      <view>
        <text class="invite-modal-title">邀请家人</text>
        <text class="invite-modal-sub">选择要分享的宠物，默认全部</text>
      </view>
      <text class="invite-modal-close" bindtap="onCloseInviteFamily">关闭</text>
    </view>
    <view class="invite-modal-tools">
      <text class="invite-modal-tool" bindtap="onSelectAllSharePets">全选</text>
      <text class="invite-modal-tool" bindtap="onClearSharePets">清空</text>
      <text class="invite-modal-count">已选 {{shareSelectedCount}} 只</text>
    </view>
    <scroll-view scroll-y class="invite-modal-list" show-scrollbar="{{false}}">
      <view
        class="invite-pet-row {{item.selected ? 'selected' : ''}}"
        wx:for="{{sharePets}}"
        wx:key="id"
        bindtap="onToggleSharePet"
        data-id="{{item.id}}"
      >
        <view class="invite-pet-check {{item.selected ? 'on' : ''}}"></view>
        <cached-image wx:if="{{item.photo}}" src="{{item.photo}}" mode="aspectFill" custom-class="invite-pet-avatar" />
        <view wx:else class="invite-pet-avatar fallback">{{item.name[0] || '宠'}}</view>
        <view class="invite-pet-meta">
          <text class="invite-pet-name">{{item.name}}</text>
          <text class="invite-pet-type">{{item.type || '宠物'}}</text>
        </view>
      </view>
    </scroll-view>
    <button
      class="invite-share-btn {{shareSelectedCount && !invitePreparing ? '' : 'disabled'}}"
      open-type="share"
      loading="{{invitePreparing}}"
      disabled="{{!shareSelectedCount || invitePreparing}}"
    >分享给微信好友</button>
  </view>
  <user-native-ad visible="{{userNativeAdVisible}}" bindclose="onCloseUserNativeAd" />
  <user-banner-ad visible="{{showUserBannerAd && !userTabBarHidden}}" />
</view>
