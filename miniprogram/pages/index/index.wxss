.home-page {
  min-height: 100vh;
  padding: 28rpx 22rpx 160rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 5%, rgba(245, 210, 174, 0.7), transparent 260rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F2 42%, #FFFDF9 100%);
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 8rpx 20rpx;
}

.greeting {
  flex: 1;
  min-width: 0;
}

.mode-switch-btn {
  flex-shrink: 0;
  margin-top: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.88);
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.greeting-title {
  display: block;
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.greeting-sub {
  display: block;
  margin-top: 8rpx;
  color: #A98972;
  font-size: 22rpx;
  line-height: 1.4;
}

.greeting-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.greeting-nickname-input {
  min-width: 220rpx;
  max-width: 360rpx;
  height: 48rpx;
  padding: 0 8rpx;
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.points-empty {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 20rpx;
  color: #C4A995;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.pet-hero {
  position: relative;
  min-height: 310rpx;
  margin-bottom: 20rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: rgba(255, 253, 248, 0.74);
  box-shadow: 0 14rpx 34rpx rgba(138, 94, 58, 0.12);
}

.pet-hero-copy {
  position: relative;
  z-index: 2;
  width: 280rpx;
  padding: 46rpx 0 0 42rpx;
}

.pet-hero-img {
  position: absolute;
  right: -20rpx;
  bottom: -8rpx;
  width: 560rpx;
  height: 306rpx;
  z-index: 1;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-heading.compact {
  justify-content: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.section-heading-text {
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section-arrow {
  color: #B4937B;
  font-size: 34rpx;
  line-height: 1;
}

.section-more {
  color: #B4937B;
  font-size: 22rpx;
  font-weight: 600;
}

.pet-hero-sub {
  display: block;
  color: #A98972;
  font-size: 22rpx;
  line-height: 1.4;
}

.pill-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 10rpx 18rpx 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #8B6B55;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(134, 93, 61, 0.12);
}

.pill-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.pet-mini-orbit {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.pet-mini-card {
  position: absolute;
  width: 168rpx;
  min-height: 84rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.92);
  box-shadow: 0 10rpx 26rpx rgba(120, 82, 56, 0.16);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.pet-mini-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F1D8C2;
  flex-shrink: 0;
  overflow: hidden;
}

.pet-mini-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: #E98657;
  font-size: 24rpx;
  font-weight: 800;
}

.pet-mini-info {
  min-width: 0;
  flex: 1;
}

.pet-mini-name,
.pet-mini-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-mini-name {
  color: #5B4535;
  font-size: 24rpx;
  font-weight: 800;
}

.pet-mini-meta {
  margin-top: 4rpx;
  color: #B4937B;
  font-size: 18rpx;
}

.pet-mini-more {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.9);
  color: #A98972;
  font-size: 18rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(120, 82, 56, 0.12);
}

/* 2 只：略缩小 */
.pet-mini-orbit.size-double .pet-mini-card {
  width: 148rpx;
  min-height: 68rpx;
  padding: 12rpx 14rpx;
  border-radius: 20rpx;
  gap: 10rpx;
}

.pet-mini-orbit.size-double .pet-mini-avatar {
  width: 44rpx;
  height: 44rpx;
}

.pet-mini-orbit.size-double .pet-mini-avatar.fallback {
  font-size: 20rpx;
}

.pet-mini-orbit.size-double .pet-mini-name {
  font-size: 22rpx;
}

.pet-mini-orbit.size-double .pet-mini-meta {
  font-size: 16rpx;
}

/* 3 只：再紧凑一些 */
.pet-mini-orbit.size-triple .pet-mini-card {
  width: 132rpx;
  min-height: 56rpx;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  gap: 8rpx;
}

.pet-mini-orbit.size-triple .pet-mini-avatar {
  width: 38rpx;
  height: 38rpx;
}

.pet-mini-orbit.size-triple .pet-mini-avatar.fallback {
  font-size: 18rpx;
}

.pet-mini-orbit.size-triple .pet-mini-name {
  font-size: 20rpx;
}

.pet-mini-orbit.size-triple .pet-mini-meta {
  margin-top: 2rpx;
  font-size: 15rpx;
}

.reserve-card {
  position: relative;
  min-height: 188rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFDF8;
  box-shadow: 0 12rpx 30rpx rgba(132, 90, 58, 0.14);
}

.reserve-copy {
  position: relative;
  z-index: 2;
  padding: 34rpx 0 30rpx 34rpx;
  width: 360rpx;
}

.reserve-title {
  display: block;
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
}

.reserve-sub {
  display: block;
  margin-top: 10rpx;
  color: #B4937B;
  font-size: 21rpx;
}

.reserve-button {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F7AA78, #E98657);
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 20rpx rgba(233, 134, 87, 0.26);
}

.reserve-button-icon {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.reserve-button-disabled {
  background: #E8D8CA;
  color: #A98972;
  box-shadow: none;
}

.reserve-art {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  width: 322rpx;
  height: 188rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.info-card {
  position: relative;
  min-height: 230rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
  overflow: hidden;
}

.info-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.info-title {
  color: #6A4D3B;
  font-size: 25rpx;
  font-weight: 800;
}

.info-sub,
.info-foot {
  position: relative;
  z-index: 2;
  display: block;
  color: #B4937B;
  font-size: 20rpx;
}

.info-sub { margin-top: 12rpx; }

.info-foot {
  position: absolute;
  left: 24rpx;
  bottom: 22rpx;
}

.info-art {
  position: absolute;
  right: -4rpx;
  bottom: 14rpx;
}

.info-art.health {
  width: 220rpx;
  height: 160rpx;
}

.info-art.points {
  right: -10rpx;
  bottom: 2rpx;
  width: 210rpx;
  height: 154rpx;
}

.points-num {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 20rpx;
  color: #E98657;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.mini-link {
  position: absolute;
  left: 22rpx;
  bottom: 22rpx;
  z-index: 2;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF4E9;
  color: #A98972;
  font-size: 19rpx;
  font-weight: 700;
}

.soft-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
}

.boarding-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}

.boarding-item:last-child { border-bottom: none; }

.boarding-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.boarding-copy {
  min-width: 0;
  flex: 1;
}

.boarding-name {
  display: block;
  color: #5B4535;
  font-size: 26rpx;
  font-weight: 800;
}

.boarding-date {
  display: block;
  margin-top: 6rpx;
  color: #B4937B;
  font-size: 21rpx;
}

.pet-avatar-small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E98657;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
  overflow: hidden;
}

.tag-green {
  flex-shrink: 0;
  background: #F5EFE7;
  color: #8C6A52;
}

.store-section {
  margin-bottom: 20rpx;
}

.store-card {
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
  overflow: hidden;
}

.store-swiper,
.store-placeholder {
  width: 100%;
  height: 238rpx;
  background: #FFF2E3;
}

.store-swiper-item,
.store-swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}

.store-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-placeholder-img {
  width: 430rpx;
  height: 220rpx;
}

.store-body {
  padding: 24rpx;
}

.store-main-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.welcome-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF2E5;
  background: #F6E1CF;
  flex-shrink: 0;
  overflow: hidden;
}

.welcome-info {
  flex: 1;
  min-width: 0;
}

.welcome-name {
  color: #5B4535;
  font-size: 28rpx;
  font-weight: 800;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.welcome-sub,
.welcome-meta {
  color: #A98972;
  font-size: 21rpx;
  margin-top: 5rpx;
  display: block;
  line-height: 1.35;
}

.welcome-sub {
  white-space: pre-wrap;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
}

.intro-photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.intro-photo-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5EFE7;
}

.intro-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.store-status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  flex-shrink: 0;
  font-weight: 800;
}

.store-status.open {
  background: #EEF8EA;
  color: #6FA462;
}

.store-status.closed {
  background: #FFF0EC;
  color: #D96F55;
}

.store-status.inactive {
  background: #F5EFE7;
  color: #A98972;
}

.store-address-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F2DEC9;
}

.store-address-row.tappable:active,
.store-phone-row:active,
.reserve-card:active,
.pet-hero:active,
.info-card:active {
  opacity: 0.9;
  transform: scale(0.992);
}

.store-address-icon,
.store-phone-icon {
  flex-shrink: 0;
  color: #DFA06F;
  font-size: 24rpx;
  line-height: 1.5;
}

.store-address {
  flex: 1;
  color: #8C6A52;
  font-size: 23rpx;
  line-height: 1.5;
}

.store-nav-hint,
.store-phone {
  flex-shrink: 0;
  color: #E98657;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 800;
}

.store-phone-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}
