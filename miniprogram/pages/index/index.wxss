.home-page {
  min-height: 100vh;
  padding: 28rpx 22rpx 160rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 5%, rgba(245, 210, 174, 0.7), transparent 260rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F2 42%, #FFFDF9 100%);
}

.home-page.has-user-banner-ad {
  padding-bottom: 336rpx;
}

.home-custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  background: #FFF4E7;
  box-sizing: border-box;
}

.home-custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.home-nav-title {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #5B4535;
  font-size: 17px;
  font-weight: 900;
  line-height: 1.2;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.home-nav-spacer {
  width: 100%;
}

.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 4rpx 8rpx 20rpx;
}

.greeting {
  flex: 1;
  min-width: 0;
}

.mode-switch-btn {
  flex-shrink: 0;
  margin-top: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.88);
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.greeting-title {
  display: block;
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.greeting-sub {
  display: block;
  margin-top: 8rpx;
  color: #A98972;
  font-size: 22rpx;
  line-height: 1.4;
}

.greeting-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.greeting-nickname-api {
  min-width: 200rpx;
  max-width: 360rpx;
  height: 48rpx;
  padding: 0 4rpx;
  color: #C87A4B;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.points-empty {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 20rpx;
  color: #C4A995;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.pet-hero {
  position: relative;
  min-height: 310rpx;
  margin-bottom: 20rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: rgba(255, 253, 248, 0.74);
  box-shadow: 0 14rpx 34rpx rgba(138, 94, 58, 0.12);
}

.pet-hero-copy {
  position: relative;
  z-index: 2;
  width: 280rpx;
  padding: 46rpx 0 0 42rpx;
}

.pet-hero-img {
  position: absolute;
  right: -20rpx;
  bottom: -8rpx;
  width: 560rpx;
  height: 306rpx;
  z-index: 1;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-heading.compact {
  justify-content: flex-start;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.section-heading-text {
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.section-arrow {
  color: #B4937B;
  font-size: 34rpx;
  line-height: 1;
}

.section-more {
  color: #B4937B;
  font-size: 22rpx;
  font-weight: 600;
}

.pet-hero-sub {
  display: block;
  color: #A98972;
  font-size: 22rpx;
  line-height: 1.4;
}

.pill-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 10rpx 18rpx 10rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #8B6B55;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(134, 93, 61, 0.12);
}

.pill-icon {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.pet-mini-orbit {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.pet-mini-card {
  position: absolute;
  width: 168rpx;
  min-height: 84rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.92);
  box-shadow: 0 10rpx 26rpx rgba(120, 82, 56, 0.16);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  pointer-events: none;
}

.pet-mini-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #F1D8C2;
  flex-shrink: 0;
  overflow: hidden;
}

.pet-mini-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  background: #E98657;
  font-size: 24rpx;
  font-weight: 800;
}

.pet-mini-info {
  min-width: 0;
  flex: 1;
}

.pet-mini-name,
.pet-mini-meta {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-mini-name {
  color: #5B4535;
  font-size: 24rpx;
  font-weight: 800;
}

.pet-mini-meta {
  margin-top: 4rpx;
  color: #B4937B;
  font-size: 18rpx;
}

.pet-mini-more {
  position: absolute;
  right: 24rpx;
  bottom: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.9);
  color: #A98972;
  font-size: 18rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(120, 82, 56, 0.12);
}

/* 2 只：略缩小 */
.pet-mini-orbit.size-double .pet-mini-card {
  width: 148rpx;
  min-height: 68rpx;
  padding: 12rpx 14rpx;
  border-radius: 20rpx;
  gap: 10rpx;
}

.pet-mini-orbit.size-double .pet-mini-avatar {
  width: 44rpx;
  height: 44rpx;
}

.pet-mini-orbit.size-double .pet-mini-avatar.fallback {
  font-size: 20rpx;
}

.pet-mini-orbit.size-double .pet-mini-name {
  font-size: 22rpx;
}

.pet-mini-orbit.size-double .pet-mini-meta {
  font-size: 16rpx;
}

/* 3 只：再紧凑一些 */
.pet-mini-orbit.size-triple .pet-mini-card {
  width: 132rpx;
  min-height: 56rpx;
  padding: 10rpx 12rpx;
  border-radius: 18rpx;
  gap: 8rpx;
}

.pet-mini-orbit.size-triple .pet-mini-avatar {
  width: 38rpx;
  height: 38rpx;
}

.pet-mini-orbit.size-triple .pet-mini-avatar.fallback {
  font-size: 18rpx;
}

.pet-mini-orbit.size-triple .pet-mini-name {
  font-size: 20rpx;
}

.pet-mini-orbit.size-triple .pet-mini-meta {
  margin-top: 2rpx;
  font-size: 15rpx;
}

.invite-family-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF8F0 0%, #FFEFE3 100%);
  border: 1rpx solid rgba(233, 134, 87, 0.18);
  box-shadow: 0 8rpx 20rpx rgba(132, 90, 58, 0.06);
}

.invite-family-title {
  display: block;
  color: #4E3729;
  font-size: 30rpx;
  font-weight: 700;
}

.invite-family-sub {
  display: block;
  margin-top: 6rpx;
  color: #A98972;
  font-size: 22rpx;
}

.invite-family-arrow {
  color: #E98657;
  font-size: 36rpx;
  font-weight: 300;
}

.reserve-card {
  position: relative;
  min-height: 188rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #FFFDF8;
  box-shadow: 0 12rpx 30rpx rgba(132, 90, 58, 0.14);
}

.reserve-copy {
  position: relative;
  z-index: 2;
  padding: 34rpx 0 30rpx 34rpx;
  width: 360rpx;
}

.reserve-title {
  display: block;
  color: #5B4535;
  font-size: 32rpx;
  font-weight: 900;
}

.reserve-sub {
  display: block;
  margin-top: 10rpx;
  color: #B4937B;
  font-size: 21rpx;
}

.reserve-button {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  height: 54rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F7AA78, #E98657);
  color: #FFFFFF;
  box-shadow: 0 10rpx 20rpx rgba(233, 134, 87, 0.26);
}

.reserve-button-text {
  height: 28rpx;
  line-height: 28rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.reserve-button-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

.reserve-button-chevron {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  margin: auto;
  width: 8rpx;
  height: 8rpx;
  border-top: 3rpx solid #FFFFFF;
  border-right: 3rpx solid #FFFFFF;
  box-sizing: border-box;
  transform: rotate(45deg);
  transform-origin: center center;
}

.reserve-button-disabled {
  background: #E8D8CA;
  color: #A98972;
  box-shadow: none;
}

.reserve-art {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  width: 322rpx;
  height: 188rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.info-card {
  position: relative;
  min-height: 230rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
  overflow: hidden;
}

.info-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 2;
}

.info-title {
  color: #6A4D3B;
  font-size: 25rpx;
  font-weight: 800;
}

.info-sub,
.info-foot {
  position: relative;
  z-index: 2;
  display: block;
  color: #B4937B;
  font-size: 20rpx;
}

.info-sub { margin-top: 12rpx; }

.info-foot {
  position: absolute;
  left: 24rpx;
  bottom: 22rpx;
}

.info-art {
  position: absolute;
  right: -4rpx;
  bottom: 14rpx;
}

.info-art.health {
  width: 220rpx;
  height: 160rpx;
}

.info-art.points {
  right: -10rpx;
  bottom: 2rpx;
  width: 210rpx;
  height: 154rpx;
}

.points-num {
  position: relative;
  z-index: 2;
  display: block;
  margin-top: 20rpx;
  color: #E98657;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
}

.mini-link {
  position: absolute;
  left: 22rpx;
  bottom: 22rpx;
  z-index: 2;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: #FFF4E9;
  color: #A98972;
  font-size: 19rpx;
  font-weight: 700;
}

.soft-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
}

.boarding-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}

.boarding-item:last-child { border-bottom: none; }

.boarding-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.boarding-copy {
  min-width: 0;
  flex: 1;
}

.boarding-name {
  display: block;
  color: #5B4535;
  font-size: 26rpx;
  font-weight: 800;
}

.boarding-date {
  display: block;
  margin-top: 6rpx;
  color: #B4937B;
  font-size: 21rpx;
}

.pet-avatar-small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E98657;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
  overflow: hidden;
}

.tag-green {
  flex-shrink: 0;
  background: #F5EFE7;
  color: #8C6A52;
}

.store-section {
  margin-bottom: 20rpx;
}

.store-card {
  border-radius: 26rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(132, 90, 58, 0.1);
  overflow: hidden;
}

.store-swiper,
.store-placeholder {
  width: 100%;
  height: 238rpx;
  background: #FFF2E3;
}

.store-swiper-item,
.store-swiper-img {
  width: 100%;
  height: 100%;
  display: block;
}

.store-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.store-placeholder-img {
  width: 430rpx;
  height: 220rpx;
}

.store-body {
  padding: 24rpx;
}

.store-main-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.welcome-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #FFF2E5;
  background: #F6E1CF;
  flex-shrink: 0;
  overflow: hidden;
}

.welcome-info {
  flex: 1;
  min-width: 0;
}

.welcome-name {
  color: #5B4535;
  font-size: 28rpx;
  font-weight: 800;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.welcome-sub,
.welcome-meta {
  color: #A98972;
  font-size: 21rpx;
  margin-top: 5rpx;
  display: block;
  line-height: 1.35;
}

.welcome-sub {
  white-space: pre-wrap;
  word-break: break-word;
}

.welcome-sub-clamped {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 6;
  overflow: hidden;
  white-space: normal;
}

.intro-more-link {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #E98657;
  font-weight: 500;
}

.intro-full-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20000;
}

.intro-full-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.intro-full-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 72vh;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.intro-full-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.intro-full-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.intro-full-close {
  font-size: 26rpx;
  color: #E98657;
  padding: 8rpx 0 8rpx 24rpx;
}

.intro-full-body {
  flex: 1;
  height: 0;
  width: 100%;
}

.intro-full-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #333333;
  white-space: pre-wrap;
  word-break: break-word;
  padding-bottom: 24rpx;
}

.intro-photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.intro-photo-item {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F5EFE7;
}

.intro-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.store-status {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  flex-shrink: 0;
  font-weight: 800;
}

.store-status.open {
  background: #EEF8EA;
  color: #6FA462;
}

.store-status.closed {
  background: #FFF0EC;
  color: #D96F55;
}

.store-status.inactive {
  background: #F5EFE7;
  color: #A98972;
}

.store-address-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F2DEC9;
}

.store-address-row.tappable:active,
.store-phone-row:active,
.store-wechat-row:active,
.reserve-card:active,
.pet-hero:active,
.info-card:active {
  opacity: 0.9;
  transform: scale(0.992);
}

.store-address-icon,
.store-phone-icon,
.store-wechat-icon {
  flex-shrink: 0;
  color: #DFA06F;
  font-size: 24rpx;
  line-height: 1.5;
}

.store-wechat-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #E98657;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 28rpx;
  text-align: center;
}

.store-address {
  flex: 1;
  color: #8C6A52;
  font-size: 23rpx;
  line-height: 1.5;
}

.store-nav-hint,
.store-phone,
.store-wechat-hint {
  flex-shrink: 0;
  color: #E98657;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 800;
}

.store-phone-row,
.store-wechat-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.store-wechat-label {
  flex-shrink: 0;
  color: #A98972;
  font-size: 22rpx;
}

.store-wechat {
  flex: 1;
  color: #8C6A52;
  font-size: 23rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.invite-modal-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 21000;
}

.invite-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.invite-modal-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  z-index: 1;
}

.invite-modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.invite-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.invite-modal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a8575;
}

.invite-modal-close {
  font-size: 26rpx;
  color: #E98657;
  padding: 8rpx 0 8rpx 24rpx;
}

.invite-modal-tools {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.invite-modal-tool {
  font-size: 24rpx;
  color: #E98657;
}

.invite-modal-count {
  margin-left: auto;
  font-size: 22rpx;
  color: #A98972;
}

.invite-modal-list {
  flex: 1;
  max-height: 48vh;
  margin-bottom: 20rpx;
}

.invite-pet-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 12rpx;
  border-bottom: 1rpx solid #F2DEC9;
}

.invite-pet-row.selected {
  background: rgba(233, 134, 87, 0.06);
}

.invite-pet-check {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #D8C0A8;
  box-sizing: border-box;
  flex-shrink: 0;
}

.invite-pet-check.on {
  border-color: #E98657;
  background: #E98657;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.invite-pet-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid #F2DEC9;
  flex-shrink: 0;
}

.invite-pet-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF4E7;
  color: #E98657;
  font-size: 26rpx;
}

.invite-pet-name {
  display: block;
  font-size: 28rpx;
  color: #3d2b1f;
  font-weight: 600;
}

.invite-pet-type {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #A98972;
}

.invite-share-btn {
  background: #E98657 !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  font-weight: 600;
  border: none !important;
}

.invite-share-btn.disabled,
.invite-share-btn[disabled] {
  opacity: 0.45;
}

.reserve-picker-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 21000;
}

.reserve-picker-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.reserve-picker-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 1;
}

.reserve-picker-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.reserve-picker-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b1f;
}

.reserve-picker-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a8575;
}

.reserve-picker-close {
  font-size: 26rpx;
  color: #E98657;
  padding: 8rpx 0 8rpx 24rpx;
}

.reserve-picker-item {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F2DEC9;
}

.reserve-picker-item:last-child {
  border-bottom: none;
}

.reserve-picker-item:active {
  opacity: 0.86;
}

.reserve-picker-emoji {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
  background: #FFF1E7;
  font-size: 36rpx;
  line-height: 72rpx;
  text-align: center;
}

.reserve-picker-copy {
  flex: 1;
  min-width: 0;
}

.reserve-picker-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #3D2B1F;
}

.reserve-picker-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #A98972;
  line-height: 1.45;
}

.reserve-picker-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #E98657;
  font-size: 40rpx;
  font-weight: 300;
}
