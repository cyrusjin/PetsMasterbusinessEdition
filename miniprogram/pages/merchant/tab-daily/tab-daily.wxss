@import '../../../styles/merchant-tab.wxss';

.merchant-page.has-tab-bar {
  padding-bottom: 160rpx !important;
  box-sizing: border-box;
}

.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  background: #E98657;
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-announce,
.nav-announce-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-announce-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-announce-dot {
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E54D42;
  border: 2rpx solid #E98657;
  box-sizing: border-box;
}

.custom-nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 12rpx;
}

.demo-banner {
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.demo-banner-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.6;
}
.disabled-banner {
  background: #F5F5F5;
  border-color: #E0E0E0;
}
.disabled-banner .demo-banner-text {
  color: #616161;
}
.rejected-banner {
  background: #FFF5F5;
  border-color: #FFCDD2;
}
.rejected-banner .demo-banner-text {
  color: #E53935;
}

.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; width: 100%; box-sizing: border-box; }

.guest-invite-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100% !important;
  min-width: 0;
  margin: 0 0 20rpx;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  text-align: center;
  line-height: normal;
  font-weight: normal;
  background: linear-gradient(165deg, #FFF8F0 0%, #FFFFFF 42%, #FFF4EA 100%);
  border: 3rpx solid #F0C49A;
  box-shadow:
    0 0 0 6rpx rgba(255, 241, 231, 0.95),
    0 18rpx 44rpx rgba(233, 134, 87, 0.16);
}

.guest-invite-card::after {
  border: none;
}

.guest-invite-card-hover {
  opacity: 0.96;
}

.guest-invite-frame {
  position: absolute;
  left: 14rpx;
  right: 14rpx;
  top: 14rpx;
  bottom: 14rpx;
  border-radius: 22rpx;
  border: 2rpx dashed rgba(233, 134, 87, 0.45);
  pointer-events: none;
  z-index: 0;
}

.guest-invite-corner {
  position: absolute;
  z-index: 1;
  font-size: 28rpx;
  line-height: 1;
  pointer-events: none;
}

.guest-invite-corner-tl {
  left: 22rpx;
  top: 18rpx;
}

.guest-invite-corner-tr {
  right: 22rpx;
  top: 18rpx;
}

.guest-invite-corner-bl {
  left: 22rpx;
  bottom: 18rpx;
}

.guest-invite-corner-br {
  right: 22rpx;
  bottom: 18rpx;
}

.guest-invite-title {
  position: relative;
  z-index: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #3D2B1F;
  line-height: 1.3;
}

.guest-invite-luck {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #E98657;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.guest-invite-desc {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A7466;
  line-height: 1.5;
}

.guest-invite-btn-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #F09A68 0%, #E98657 55%, #E07542 100%);
  box-shadow: 0 14rpx 32rpx rgba(233, 134, 87, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.guest-invite-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.guest-invite-actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.guest-invite-action {
  margin: 0;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 12rpx;
  border-radius: 40rpx;
  background: linear-gradient(90deg, #F09A68 0%, #E98657 55%, #E07542 100%);
  box-shadow: 0 10rpx 24rpx rgba(233, 134, 87, 0.28);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.guest-invite-action::after {
  border: none;
}

.guest-invite-action-alt {
  background: #FFFFFF;
  color: #E98657;
  border: 2rpx solid #E98657;
  box-shadow: none;
}

.guest-invite-action-hover {
  opacity: 0.92;
}

.share-actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}
.share-grid-solo { grid-template-columns: 1fr; }
.share-action-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.share-action-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #999999;
  text-align: center;
}

.staff-collab-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.staff-collab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx 24rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  box-sizing: border-box;
  min-height: 160rpx;
}

.staff-collab-item:active {
  opacity: 0.88;
}

.staff-collab-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.3;
}

.staff-collab-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: #E98657;
  background: #FFF1E7;
  border-radius: 16rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.quick-item { display: flex; flex-direction: column; align-items: center; padding: 24rpx 0 20rpx; background: #F7F8FA; border-radius: 16rpx; font-size: 24rpx; color: #666666; box-sizing: border-box; }
.quick-item-badge-wrap { position: relative; }
.quick-badge {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: #E53935;
  border-radius: 16rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.share-item-wrap { position: relative; }
.share-hit-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  opacity: 0;
  background: transparent;
  border: none;
  z-index: 2;
}
.share-hit-btn::after {
  border: none;
}
.quick-icon-img { width: 72rpx; height: 72rpx; margin-bottom: 10rpx; display: block; }
.boarding-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F2DEC9; gap: 16rpx; }
.boarding-item:last-child { border-bottom: none; }
.boarding-main { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.boarding-info { min-width: 0; }
.boarding-name-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.boarding-date { display: block; font-size: 22rpx; margin-top: 4rpx; }
.boarding-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; flex-shrink: 0; }
.check-count { font-size: 22rpx; color: #666666; white-space: nowrap; }
.go-check-btn {
  margin: 0;
  padding: 0 28rpx;
  min-height: 56rpx;
  height: auto;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #E98657;
  border-radius: 28rpx;
  border: none;
  white-space: nowrap;
  line-height: 1.2;
}
.go-check-btn::after { border: none; }
.expiring-tag { font-size: 20rpx; color: #E53935; background: #FFEBEE; padding: 2rpx 10rpx; border-radius: 8rpx; }
.service-tag { font-size: 20rpx; color: #E98657; background: #FFF1E7; padding: 2rpx 10rpx; border-radius: 8rpx; }

.quick-entry-row,
.share-staff-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 24rpx 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}
.quick-entry-row:active,
.share-staff-row:active {
  opacity: 0.85;
}
.quick-entry-icon,
.share-staff-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.quick-entry-body,
.share-staff-body {
  flex: 1;
  min-width: 0;
}
.quick-entry-title,
.share-staff-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.quick-entry-desc,
.share-staff-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}
.share-staff-badge {
  font-size: 22rpx;
  color: #E98657;
  background: #FFF1E7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.quick-entry-arrow,
.share-staff-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
  line-height: 1;
}
