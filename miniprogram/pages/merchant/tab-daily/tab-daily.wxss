@import '../../../styles/merchant-tab.wxss';

.merchant-page.has-tab-bar {
  padding-bottom: 160rpx !important;
  box-sizing: border-box;
}

.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 1000;
  background: linear-gradient(135deg, #F29A69 0%, #DF6F4D 100%);
  box-shadow: 0 8rpx 24rpx rgba(205, 101, 66, .2);
  box-sizing: border-box;
}

.custom-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.nav-announce,
.nav-announce-placeholder {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-announce-icon {
  width: 40rpx;
  height: 40rpx;
}

.nav-announce-dot {
  position: absolute;
  top: 8rpx;
  right: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E54D42;
  border: 2rpx solid #E98657;
  box-sizing: border-box;
}

.custom-nav-title {
  flex: 1;
  min-width: 0;
  text-align: center;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 12rpx;
}

.demo-banner {
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.demo-banner-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.6;
}
.disabled-banner {
  background: #F5F5F5;
  border-color: #E0E0E0;
}
.disabled-banner .demo-banner-text {
  color: #616161;
}
.rejected-banner {
  background: #FFF5F5;
  border-color: #FFCDD2;
}
.rejected-banner .demo-banner-text {
  color: #E53935;
}
.upload-banner {
  background: #F3F8F1;
  border-color: #C5E1A5;
}
.upload-banner .demo-banner-text {
  color: #558B2F;
}

.quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; width: 100%; box-sizing: border-box; }

.guest-invite-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100% !important;
  min-width: 0;
  margin: 0 0 20rpx;
  padding: 42rpx 32rpx 30rpx;
  border-radius: 34rpx;
  overflow: hidden;
  box-sizing: border-box;
  text-align: center;
  line-height: normal;
  font-weight: normal;
  background: linear-gradient(145deg, #FFFDFC 0%, #FFF7F1 52%, #FFEDEB 100%);
  border: 1rpx solid rgba(255, 255, 255, .96);
  box-shadow: 0 18rpx 42rpx rgba(198, 113, 100, .16), inset 0 1rpx 0 rgba(255,255,255,.95);
}

.guest-invite-card::before {
  content: '';
  position: absolute;
  width: 250rpx;
  height: 250rpx;
  right: -90rpx;
  top: -120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 205, 186, .6), rgba(255, 205, 186, 0));
  pointer-events: none;
}

.guest-invite-card::after {
  border: none;
}

.guest-invite-card-hover {
  opacity: 0.96;
}

.guest-invite-frame {
  position: absolute;
  left: 16rpx;
  right: 16rpx;
  top: 16rpx;
  bottom: 16rpx;
  border-radius: 26rpx;
  border: 1rpx dashed rgba(232, 120, 99, .28);
  pointer-events: none;
  z-index: 0;
}

.guest-invite-title {
  position: relative;
  z-index: 1;
  font-size: 36rpx;
  font-weight: 800;
  color: #533737;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.guest-invite-luck {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #E87863;
  letter-spacing: 3rpx;
  line-height: 1.4;
}

.guest-invite-desc {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9A7C78;
  line-height: 1.5;
}

.guest-invite-btn-wrap {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #F09A68 0%, #E98657 55%, #E07542 100%);
  box-shadow: 0 14rpx 32rpx rgba(233, 134, 87, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.guest-invite-btn-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.guest-invite-actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  width: 100%;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.guest-invite-action {
  margin: 0;
  min-width: 0;
  min-height: 82rpx;
  padding: 0 12rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #F49A82 0%, #E87863 58%, #D9655C 100%);
  box-shadow: 0 12rpx 24rpx rgba(216, 103, 91, .25);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 80rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.guest-invite-action::after {
  border: none;
}

.guest-invite-action-alt {
  background: rgba(255,255,255,.72);
  color: #D86C61;
  border: 2rpx solid #F09D8D;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.8);
}

.guest-invite-action-hover {
  opacity: 0.92;
}

.share-actions-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}
.share-grid-solo { grid-template-columns: 1fr; }
.share-action-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.share-action-hint {
  display: block;
  margin-top: 10rpx;
  padding: 0 4rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #999999;
  text-align: center;
}

.staff-collab-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.staff-collab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx 24rpx;
  background: linear-gradient(145deg, #FFFDFB, #FFF3F0);
  border: 1rpx solid rgba(241, 211, 205, .7);
  border-radius: 22rpx;
  box-sizing: border-box;
  min-height: 160rpx;
}

.staff-collab-item:active {
  opacity: 0.88;
}

.staff-collab-text {
  font-size: 24rpx;
  color: #765B5A;
  line-height: 1.3;
}

.staff-collab-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  font-size: 20rpx;
  color: #E98657;
  background: #FFF1E7;
  border-radius: 16rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.quick-item { display: flex; flex-direction: column; align-items: center; padding: 24rpx 0 20rpx; background: linear-gradient(145deg, #FFF9F3, #FFF0E5); border: 1rpx solid rgba(238, 207, 183, .72); border-radius: 22rpx; font-size: 24rpx; color: #765B4A; box-sizing: border-box; box-shadow: 0 8rpx 18rpx rgba(130, 86, 54, .07); }
.quick-item-badge-wrap { position: relative; }
.quick-badge {
  position: absolute;
  top: 12rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  color: #fff;
  background: #E53935;
  border-radius: 16rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}
.share-item-wrap { position: relative; }
.share-hit-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  opacity: 0;
  background: transparent;
  border: none;
  z-index: 2;
}
.share-hit-btn::after {
  border: none;
}
.quick-icon-img { width: 72rpx; height: 72rpx; margin-bottom: 10rpx; display: block; }
.boarding-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #F2DEC9; gap: 16rpx; }
.boarding-item:last-child { border-bottom: none; }
.boarding-main { display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0; }
.boarding-info { min-width: 0; }
.boarding-name-row { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.boarding-date { display: block; font-size: 22rpx; margin-top: 4rpx; }
.boarding-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; flex-shrink: 0; }
.check-count { font-size: 22rpx; color: #666666; white-space: nowrap; }
.go-check-btn {
  margin: 0;
  padding: 0 28rpx;
  min-height: 56rpx;
  height: auto;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #E98657;
  border-radius: 28rpx;
  border: none;
  white-space: nowrap;
  line-height: 1.2;
}
.go-check-btn::after { border: none; }
.expiring-tag { font-size: 20rpx; color: #E53935; background: #FFEBEE; padding: 2rpx 10rpx; border-radius: 8rpx; }
.service-tag { font-size: 20rpx; color: #E98657; background: #FFF1E7; padding: 2rpx 10rpx; border-radius: 8rpx; }

.quick-entry-row,
.share-staff-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 24rpx 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}
.quick-entry-row:active,
.share-staff-row:active {
  opacity: 0.85;
}
.quick-entry-icon,
.share-staff-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.quick-entry-body,
.share-staff-body {
  flex: 1;
  min-width: 0;
}
.quick-entry-title,
.share-staff-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.quick-entry-desc,
.share-staff-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}
.share-staff-badge {
  font-size: 22rpx;
  color: #E98657;
  background: #FFF1E7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.quick-entry-arrow,
.share-staff-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
  line-height: 1;
}
