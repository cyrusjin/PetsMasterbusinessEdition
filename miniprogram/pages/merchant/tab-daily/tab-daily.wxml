<view class="merchant-page has-tab-bar has-custom-nav" style="padding-bottom: 160rpx;">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navTotalHeight}}px;">
    <view class="custom-nav-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-announce" bindtap="onGoAnnouncements">
        <image class="nav-announce-icon" src="/images/icon-announce.png" mode="aspectFit" />
        <view class="nav-announce-dot" wx:if="{{hasUnreadAnnouncement}}"></view>
      </view>
      <text class="custom-nav-title">{{navTitle}}</text>
      <view class="nav-announce-placeholder"></view>
    </view>
  </view>
  <view class="container" style="padding-top: {{navTotalHeight}}px;">
    <view class="mode-switch-row mode-switch-row--end">
      <view class="mode-switch-btn" bindtap="onSwitchToUser">切换用户版</view>
    </view>
    <oa-follow-banner scene="merchant" />
    <view class="demo-banner" wx:if="{{isDemoMode}}">
      <text class="demo-banner-text">体验模式 · 数据仅保存在本地，提交入驻申请后可使用完整功能</text>
    </view>
    <view class="demo-banner pending-banner" wx:elif="{{isPendingReview}}">
      <text class="demo-banner-text">入驻审核中 · 日常管理将在审核通过后开放，请前往「申请入驻」查看进度</text>
    </view>
    <view class="demo-banner rejected-banner" wx:elif="{{isApplyRejected}}">
      <text class="demo-banner-text">入驻未通过 · 请前往「申请入驻」查看驳回理由并修改后重新提交</text>
    </view>
    <view class="demo-banner disabled-banner" wx:elif="{{isAdminDisabled}}">
      <text class="demo-banner-text">{{adminDisableReason || '店铺已被平台关闭 · 暂无法使用商家端功能'}}</text>
    </view>

    <view class="card">
      <view class="card-title">快捷操作</view>
      <view class="quick-grid">
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoMerchantOrders">
          <image class="quick-icon-img" src="/images/card/card-orders.png" mode="aspectFit" />
          <text>订单管理</text>
          <view class="quick-badge" wx:if="{{pendingOrderCount > 0}}">{{pendingOrderCount > 99 ? '99+' : pendingOrderCount}}</view>
        </view>
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoDailyCheck">
          <image class="quick-icon-img" src="/images/card/card-check.png" mode="aspectFit" />
          <text>日常打卡</text>
          <view class="quick-badge" wx:if="{{uncheckedPetCount > 0}}">{{uncheckedPetCount > 99 ? '99+' : uncheckedPetCount}}</view>
        </view>
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoPickupManage">
          <image class="quick-icon-img" src="/images/card/card-reserve.png" mode="aspectFit" />
          <text>接送管理</text>
          <view class="quick-badge" wx:if="{{pickupPendingCount > 0}}">{{pickupPendingCount > 99 ? '99+' : pickupPendingCount}}</view>
        </view>
        <view class="quick-item" bindtap="onGoDailyLogs">
          <image class="quick-icon-img" src="/images/card/card-camera.png" mode="aspectFit" />
          <text>打卡记录</text>
        </view>
        <view class="quick-item" bindtap="onGoCustomers">
          <image class="quick-icon-img" src="/images/card/card-pets.png" mode="aspectFit" />
          <text>客户管理</text>
        </view>
        <view class="quick-item" bindtap="onGoLedger">
          <image class="quick-icon-img" src="/images/card/card-stats.png" mode="aspectFit" />
          <text>记账本</text>
        </view>
      </view>
    </view>

    <view class="guest-invite-card">
      <view class="guest-invite-frame" aria-hidden="true"></view>
      <view class="guest-invite-corner guest-invite-corner-tl" aria-hidden="true">✨</view>
      <view class="guest-invite-corner guest-invite-corner-tr" aria-hidden="true">💰</view>
      <view class="guest-invite-corner guest-invite-corner-bl" aria-hidden="true">🧧</view>
      <view class="guest-invite-corner guest-invite-corner-br" aria-hidden="true">🎉</view>
      <text class="guest-invite-title">发给客人</text>
      <text class="guest-invite-luck">发财 · 爆单 · 生意兴隆</text>
      <text class="guest-invite-desc">{{guestShareDesc}}</text>
      <view class="guest-invite-actions">
        <button
          wx:if="{{!guestShareMulti}}"
          class="guest-invite-action"
          open-type="share"
          data-share-type="customer"
          hover-class="guest-invite-action-hover"
        >发送给客人预约</button>
        <view
          wx:else
          class="guest-invite-action"
          hover-class="guest-invite-action-hover"
          bindtap="onShareToGuest"
        >{{guestShareBtnText}}</view>
        <view
          class="guest-invite-action guest-invite-action-alt"
          hover-class="guest-invite-action-hover"
          bindtap="onProxyOrder"
        >代客人下单</view>
      </view>
    </view>

    <view class="card" wx:if="{{isStoreOwner && !isDemoMode}}">
      <view class="card-title">员工协作</view>
      <view class="staff-collab-row">
        <view class="staff-collab-item share-item-wrap">
          <image class="quick-icon-img" src="/images/card/card-pets.png" mode="aspectFit" />
          <text class="staff-collab-text">分享给员工</text>
          <button
            class="share-hit-btn"
            open-type="share"
            data-share-type="staff"
            hover-class="none"
          ></button>
        </view>
        <view class="staff-collab-item" bindtap="onGoStaffManage">
          <image class="quick-icon-img" src="/images/card/card-pets.png" mode="aspectFit" />
          <text class="staff-collab-text">员工管理</text>
          <text class="staff-collab-badge" wx:if="{{staffCount > 0}}">{{staffCount}}人</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{boardingList.length > 0}}">
      <view class="card-title">服务中宠物 ({{boardingList.length}})</view>
      <view class="boarding-item" wx:for="{{boardingList}}" wx:key="id">
        <view class="boarding-main" bindtap="onGoDetail" data-id="{{item.id}}">
          <cached-image wx:if="{{item.petPhoto}}" src="{{item.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
          <view wx:else class="pet-avatar-small">{{item.petName[0]}}</view>
          <view class="boarding-info">
            <view class="boarding-name-row">
              <text class="boarding-name">{{item.petName}}</text>
              <text class="service-tag" wx:if="{{item.serviceLabel}}">{{item.serviceLabel}}</text>
              <text class="expiring-tag" wx:if="{{item.isExpiringToday}}">今日到期</text>
            </view>
            <text class="text-gray boarding-date">下单：{{item.createTimeText}}</text>
            <text class="text-gray boarding-date">{{item.dateLabel}}：{{item.dateText}}</text>
          </view>
        </view>
        <view class="boarding-actions">
          <text class="check-count">今日打卡 {{item.todayCheckCount}} 次</text>
          <button
            class="go-check-btn"
            size="mini"
            catchtap="onGoDailyCheckForOrder"
            data-id="{{item.id}}"
          >去打卡</button>
        </view>
      </view>
    </view>
  </view>

</view>
<merchant-tab-bar active="daily" isDemoMode="{{isDemoMode}}" />
<hidden-admin-entry id="hiddenAdminEntry" />
