<view class="merchant-page has-tab-bar has-custom-nav" style="padding-bottom: 160rpx;">
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px; height: {{navTotalHeight}}px;">
    <view class="custom-nav-inner" style="height: {{navBarHeight}}px;">
      <view class="nav-announce" bindtap="onGoAnnouncements">
        <image class="nav-announce-icon" src="/images/icon-announce.png" mode="aspectFit" />
        <view class="nav-announce-dot" wx:if="{{hasUnreadAnnouncement}}"></view>
      </view>
      <text class="custom-nav-title">{{navTitle}}</text>
      <view class="nav-announce-placeholder"></view>
    </view>
  </view>
  <view class="container" style="padding-top: {{navTotalHeight}}px;">
    <view class="mode-switch-row mode-switch-row--end">
      <view class="mode-switch-btn" bindtap="onSwitchToUser">切换用户版</view>
    </view>
    <oa-follow-banner scene="merchant" />
    <view class="demo-banner upload-banner" wx:if="{{dailyUploadActive}}">
      <text class="demo-banner-text">{{dailyUploadText}} · 可继续操作，不要退出小程序</text>
    </view>
    <view class="demo-banner" wx:if="{{isDemoMode}}">
      <text class="demo-banner-text">展示数据 · 开通店铺后即可发给客人、购买保险</text>
    </view>
    <view class="demo-banner pending-banner" wx:elif="{{isPendingReview}}">
      <text class="demo-banner-text">入驻审核中 · 日常管理将在审核通过后开放，请前往「申请入驻」查看进度</text>
    </view>
    <view class="demo-banner rejected-banner" wx:elif="{{isApplyRejected}}">
      <text class="demo-banner-text">入驻未通过 · 请前往「申请入驻」查看驳回理由并修改后重新提交</text>
    </view>
    <view class="demo-banner disabled-banner" wx:elif="{{isAdminDisabled}}">
      <text class="demo-banner-text">{{adminDisableReason || '店铺已被平台关闭 · 暂无法使用商家端功能'}}</text>
    </view>

    <view class="today-focus-card">
      <view class="today-focus-head">
        <view>
          <text class="today-focus-title">今日待办</text>
          <text class="today-focus-sub">把最重要的事情一次处理完</text>
        </view>
        <text class="today-focus-live">实时</text>
      </view>
      <view class="today-focus-grid">
        <view class="today-focus-item" bindtap="onGoMerchantOrders">
          <text class="today-focus-value">{{pendingOrderCount}}</text>
          <text class="today-focus-label">待处理订单</text>
        </view>
        <view class="today-focus-item" bindtap="onGoDailyCheck">
          <text class="today-focus-value">{{uncheckedPetCount}}</text>
          <text class="today-focus-label">待打卡宠物</text>
        </view>
        <view class="today-focus-item" bindtap="onGoPickupManage">
          <text class="today-focus-value">{{pickupPendingCount}}</text>
          <text class="today-focus-label">待接送任务</text>
        </view>
      </view>
    </view>

    <view id="guestInviteCard" class="guest-invite-card">
      <view class="guest-invite-frame" aria-hidden="true"></view>
      <text class="guest-invite-title">发给客人</text>
      <text class="guest-invite-luck">发财 · 爆单 · 生意兴隆</text>
      <text class="guest-invite-desc">{{guestShareDesc}}</text>
      <view class="guest-invite-actions">
        <view id="onboarding-record-target" class="guest-invite-action guest-invite-action-record" hover-class="guest-invite-action-hover" bindtap="onServiceRecord">发服务记录</view>
        <button
          wx:if="{{!guestShareMulti && !isDemoMode}}"
          id="onboarding-customer-target"
          class="guest-invite-action"
          open-type="share"
          data-share-type="customer"
          hover-class="guest-invite-action-hover"
        >发送给客人预约</button>
        <view
          wx:elif="{{!guestShareMulti}}"
          id="onboarding-customer-target"
          class="guest-invite-action"
          hover-class="guest-invite-action-hover"
          bindtap="onShareToGuest"
        >发送给客人预约</view>
        <view
          wx:else
          id="onboarding-customer-target"
          class="guest-invite-action"
          hover-class="guest-invite-action-hover"
          bindtap="onShareToGuest"
        >{{guestShareBtnText}}</view>
        <view
          class="guest-invite-action guest-invite-action-alt"
          hover-class="guest-invite-action-hover"
          bindtap="onProxyOrder"
        >代客人下单</view>
      </view>
    </view>

    <view class="card quick-ops-card">
      <view class="card-title">快捷操作</view>
      <view class="quick-grid">
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoMerchantOrders">
          <view class="quick-icon-v2 quick-icon-orders"><view class="quick-symbol symbol-orders"></view></view>
          <text>订单管理</text>
          <view class="quick-badge" wx:if="{{pendingOrderCount > 0}}">{{pendingOrderCount > 99 ? '99+' : pendingOrderCount}}</view>
        </view>
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoDailyCheck">
          <view class="quick-icon-v2 quick-icon-check"><view class="quick-symbol symbol-check"></view></view>
          <text>日常打卡</text>
          <view class="quick-badge" wx:if="{{uncheckedPetCount > 0}}">{{uncheckedPetCount > 99 ? '99+' : uncheckedPetCount}}</view>
        </view>
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoPickupManage">
          <view class="quick-icon-v2 quick-icon-pickup"><view class="quick-symbol symbol-pickup"></view></view>
          <text>接送管理</text>
          <view class="quick-badge" wx:if="{{pickupPendingCount > 0}}">{{pickupPendingCount > 99 ? '99+' : pickupPendingCount}}</view>
        </view>
        <view class="quick-item" bindtap="onGoDailyLogs">
          <view class="quick-icon-v2 quick-icon-logs"><view class="quick-symbol symbol-logs"></view></view>
          <text>打卡记录</text>
        </view>
        <view class="quick-item" bindtap="onGoCustomers">
          <view class="quick-icon-v2 quick-icon-customers"><view class="quick-symbol symbol-customers"></view></view>
          <text>客户管理</text>
        </view>
        <view class="quick-item quick-poster-item" bindtap="onGoPromoPoster">
          <view class="quick-icon-v2 quick-icon-poster"><view class="quick-symbol symbol-poster"></view></view>
          <text>宣传海报</text>
        </view>
        <view class="quick-item" bindtap="onGoGuide">
          <view class="quick-icon-v2 quick-icon-guide"><view class="quick-symbol symbol-guide"></view></view>
          <text>使用指南</text>
        </view>
        <view class="quick-item quick-item-badge-wrap" bindtap="onGoBoardingInsurance">
          <view class="quick-icon-v2 quick-icon-insurance"><view class="quick-symbol symbol-insurance"></view></view>
          <text>商家寄养保</text>
          <view class="quick-gift-badge">
            <text class="quick-gift-badge-text">免费送宠粮</text>
          </view>
        </view>
      </view>
    </view>

    <view class="insurance-promo-entry" bindtap="onGoInsurancePromotion" hover-class="insurance-promo-entry-hover">
      <view class="insurance-promo-logo-wrap">
        <view class="insurance-promo-logo-inner">
          <image class="insurance-promo-logo" src="/images/insurance/pingan-logo.png" mode="aspectFit" />
        </view>
      </view>
      <view class="insurance-promo-copy">
        <view class="insurance-promo-title-row">
          <text class="insurance-promo-title">宠物保险推广</text>
          <text class="insurance-promo-badge">10%佣金</text>
        </view>
        <text class="insurance-promo-desc">发送专属保障页面给客人，成交可享推广佣金</text>
      </view>
      <text class="insurance-promo-arrow">›</text>
    </view>

    <view class="promotion-card" wx:if="{{promotionStats}}">
      <view class="promotion-head"><view><text class="promotion-title">推广小报</text><text class="promotion-sub">近30天 · 看看分享带来的预约</text></view><text class="promotion-link" bindtap="onGoCustomers">客户标签 ›</text></view>
      <view class="promotion-grid">
        <view><text class="promotion-value">{{promotionStats.shares}}</text><text class="promotion-label">分享</text></view>
        <view><text class="promotion-value">{{promotionStats.opens}}</text><text class="promotion-label">打开</text></view>
        <view><text class="promotion-value">{{promotionStats.orders}}</text><text class="promotion-label">带来订单</text></view>
        <view><text class="promotion-value">{{promotionStats.conversionRate}}%</text><text class="promotion-label">转化率</text></view>
      </view>
    </view>

    <view class="card" wx:if="{{isStoreOwner && !isDemoMode}}">
      <view class="card-title">员工协作</view>
      <view class="staff-collab-row">
        <view class="staff-collab-item share-item-wrap">
          <view class="quick-icon-v2 quick-icon-staff-share"><view class="quick-symbol symbol-staff-share"></view></view>
          <text class="staff-collab-text">分享给员工</text>
          <button
            class="share-hit-btn"
            open-type="share"
            data-share-type="staff"
            hover-class="none"
          ></button>
        </view>
        <view class="staff-collab-item" bindtap="onGoStaffManage">
          <view class="quick-icon-v2 quick-icon-staff-manage"><view class="quick-symbol symbol-customers"></view></view>
          <text class="staff-collab-text">员工管理</text>
          <text class="staff-collab-badge" wx:if="{{staffCount > 0}}">{{staffCount}}人</text>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{boardingList.length > 0}}">
      <view class="card-title">服务中宠物 ({{boardingList.length}})</view>
      <view class="boarding-item" wx:for="{{boardingList}}" wx:key="id">
        <view class="boarding-main" bindtap="onGoDetail" data-id="{{item.id}}">
          <cached-image wx:if="{{item.petPhoto}}" src="{{item.petPhoto}}" mode="aspectFill" custom-class="pet-avatar-small" />
          <view wx:else class="pet-avatar-small">{{item.petName[0]}}</view>
          <view class="boarding-info">
            <view class="boarding-name-row">
              <text class="boarding-name">{{item.petName}}</text>
              <text class="service-tag" wx:if="{{item.serviceLabel}}">{{item.serviceLabel}}</text>
              <text class="expiring-tag" wx:if="{{item.isExpiringToday}}">今日到期</text>
            </view>
            <text class="text-gray boarding-date">下单：{{item.createTimeText}}</text>
            <text class="text-gray boarding-date">{{item.dateLabel}}：{{item.dateText}}</text>
          </view>
        </view>
        <view class="boarding-actions">
          <text class="check-count">今日打卡 {{item.todayCheckCount}} 次</text>
          <button
            class="go-check-btn"
            size="mini"
            catchtap="onGoDailyCheckForOrder"
            data-id="{{item.id}}"
          >去打卡</button>
        </view>
      </view>
    </view>
  </view>

</view>
<merchant-tab-bar active="daily" isDemoMode="{{isDemoMode}}" />
<hidden-admin-entry id="hiddenAdminEntry" />

<view wx:if="{{onboardingVisible}}" class="onboarding-root" catchtouchmove="onGuideTouchMove">
  <view class="onboarding-dim {{onboardingStep === 'action' ? 'onboarding-dim-action' : ''}}"></view>
  <view
    wx:if="{{onboardingStep === 'action'}}"
    class="onboarding-spotlight"
    style="top: {{onboardingTarget.top}}px; left: {{onboardingTarget.left}}px; width: {{onboardingTarget.width}}px; height: {{onboardingTarget.height}}px;"
  ></view>
  <view
    wx:if="{{onboardingStep === 'action' && onboardingMode === 'existing'}}"
    class="onboarding-hotspot"
    style="top: {{onboardingTarget.top}}px; left: {{onboardingTarget.left}}px; width: {{onboardingTarget.width}}px; height: {{onboardingTarget.height}}px;"
    bindtap="onGuideTargetTap"
  ></view>
  <view
    wx:elif="{{onboardingStep === 'action' && onboardingMode === 'opening' && guestShareMulti}}"
    class="onboarding-hotspot"
    style="top: {{onboardingTarget.top}}px; left: {{onboardingTarget.left}}px; width: {{onboardingTarget.width}}px; height: {{onboardingTarget.height}}px;"
    bindtap="onGuideTargetTap"
  ></view>
  <button
    wx:elif="{{onboardingStep === 'action' && onboardingMode === 'opening'}}"
    class="onboarding-hotspot onboarding-share-hotspot"
    style="top: {{onboardingTarget.top}}px; left: {{onboardingTarget.left}}px; width: {{onboardingTarget.width}}px; height: {{onboardingTarget.height}}px;"
    open-type="share"
    data-share-type="customer"
    bindtap="onGuideShareTap"
    hover-class="none"
  ></button>
  <view class="onboarding-panel" wx:if="{{onboardingStep === 'choose'}}">
    <text class="onboarding-kicker">开始使用</text>
    <text class="onboarding-title">先告诉我你的店铺状态</text>
    <text class="onboarding-desc">我们会按你的情况安排第一步，不需要先学完整套系统。</text>
    <view class="onboarding-choice" bindtap="onGuideChoose" data-mode="existing">
      <view class="onboarding-choice-icon">店</view>
      <view class="onboarding-choice-copy"><text class="onboarding-choice-title">已有店铺，正在营业</text><text class="onboarding-choice-desc">把刚完成的服务发给顾客</text></view>
      <text class="onboarding-arrow">›</text>
    </view>
    <view class="onboarding-choice" bindtap="onGuideChoose" data-mode="opening">
      <view class="onboarding-choice-icon onboarding-choice-icon-new">新</view>
      <view class="onboarding-choice-copy"><text class="onboarding-choice-title">待开业，正在准备中</text><text class="onboarding-choice-desc">先发一个预约入口给客人</text></view>
      <text class="onboarding-arrow">›</text>
    </view>
    <text class="onboarding-skip" bindtap="onGuideSkip">跳过引导</text>
  </view>
  <view class="onboarding-tip" wx:elif="{{onboardingStep === 'action'}}">
    <text class="onboarding-kicker">第一步</text>
    <text class="onboarding-title">{{onboardingTitle}}</text>
    <text class="onboarding-desc">{{onboardingDesc}}</text>
    <text class="onboarding-hint">点击上方高亮区域继续</text>
    <text class="onboarding-skip" bindtap="onGuideSkip">跳过引导</text>
  </view>
</view>
