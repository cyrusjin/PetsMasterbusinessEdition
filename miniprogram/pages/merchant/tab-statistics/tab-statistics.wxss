@import '../../../styles/merchant-tab.wxss';

.merchant-page.has-tab-bar,
.stats-page.has-tab-bar {
  padding-bottom: 160rpx !important;
  box-sizing: border-box;
}

.stats-page {
  min-height: 100vh;
}

.demo-banner {
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}
.demo-banner-text {
  font-size: 24rpx;
  color: #F57C00;
  line-height: 1.6;
}

.period-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.period-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #666666;
  border-radius: 12rpx;
}
.period-tab.active {
  background: #E98657;
  color: #FFFFFF;
  font-weight: 600;
}

.revenue-hero {
  background: linear-gradient(135deg, #E98657 0%, #F7AA78 100%);
  border-radius: 24rpx;
  padding: 32rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 28rpx rgba(29, 61, 122, 0.28);
  color: #FFFFFF;
}
.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.hero-label {
  font-size: 26rpx;
  opacity: 0.9;
}
.hero-updated {
  font-size: 20rpx;
  opacity: 0.65;
}
.hero-amount {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 1rpx;
}
.hero-compare {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}
.hero-metrics {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}
.hero-metric {
  flex: 1;
  text-align: center;
}
.hero-metric-value {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}
.hero-metric-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.75;
}
.hero-metrics-3 .hero-metric-value {
  font-size: 26rpx;
}
.hero-metrics-3 .hero-metric-label {
  font-size: 20rpx;
}
.hero-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.25);
}

.kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.kpi-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}
.kpi-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #E98657;
  line-height: 1.2;
}
.kpi-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #333333;
  font-weight: 500;
}
.kpi-hint {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #999999;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.card-title.inline {
  margin-bottom: 0;
  border: none;
  padding: 0;
}
.card-link {
  font-size: 24rpx;
  color: #E98657;
}

.composition-empty {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.composition-row {
  margin-bottom: 24rpx;
}
.composition-row:last-child {
  margin-bottom: 0;
}
.composition-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}
.composition-name {
  color: #333333;
}
.composition-amount {
  color: #E98657;
  font-weight: 600;
}
.composition-bar {
  height: 16rpx;
  background: #F2DEC9;
  border-radius: 8rpx;
  overflow: hidden;
}
.composition-fill {
  height: 100%;
  border-radius: 8rpx;
  min-width: 4rpx;
}
.composition-fill.boarding {
  background: #E98657;
}
.composition-fill.shipping {
  background: #F7AA78;
}
.composition-fill.extra {
  background: #81C784;
}

.ledger-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}
.ledger-kpi {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  min-width: 0;
}
.ledger-kpi-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #E98657;
  line-height: 1.2;
}
.ledger-kpi-value.expense {
  color: #E53935;
}
.ledger-kpi-value.income {
  color: #2E7D32;
}
.ledger-kpi-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #666666;
  text-align: center;
  line-height: 1.35;
}
.ledger-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.status-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
}
.status-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}
.status-name {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #999999;
}
.status-chip.pending .status-num { color: #F57C00; }
.status-chip.boarding .status-num { color: #E98657; }
.status-chip.completed .status-num { color: #2E7D32; }
.status-chip.cancelled .status-num { color: #999999; }

.order-period-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
  gap: 16rpx;
}
.recent-item:last-child {
  border-bottom: none;
}
.recent-item:active {
  opacity: 0.85;
}
.recent-main {
  flex: 1;
  min-width: 0;
}
.recent-pet {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.recent-date {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
}
.recent-side {
  text-align: right;
  flex-shrink: 0;
}
.recent-amount {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #E98657;
}
.recent-status {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
}
.recent-status.status-pending { color: #F57C00; }
.recent-status.status-boarding { color: #E98657; }
.recent-status.status-completed { color: #2E7D32; }
.recent-status.status-cancelled { color: #999999; }

.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
