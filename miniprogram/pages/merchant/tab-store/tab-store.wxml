      <view class="form-group"><text class="form-label">押金金额（元）</text><input class="form-input" type="digit" placeholder="不填默认 0 元" value="{{shop.deposit}}" bindinput="onField" data-field="deposit" /></view>
    </view>
    <button class="btn-primary" bindtap="onSave">保存设置</button>
    </block>
  </view>

  <view class="clause-modal" wx:if="{{showCoopContractModal && coopContractDoc}}">
    <view class="clause-modal-mask" catchtouchmove="preventMove" bindtap="onCloseCoopContractModal"></view>
    <view class="clause-modal-panel coop-contract-panel">
      <view class="clause-modal-header" catchtouchmove="preventMove">
        <text class="clause-modal-title">{{coopContractDoc.title}}</text>
        <text class="clause-modal-close" bindtap="onCloseCoopContractModal">×</text>
      </view>
      <scroll-view scroll-y class="coop-contract-scroll" enhanced show-scrollbar="{{false}}">
        <view class="coop-contract-paper">
          <view class="coop-contract-parties">
            <view class="coop-party-block">
              <text class="coop-party-label">{{coopContractDoc.partyA.label}}</text>
              <text class="coop-party-line">负责人：{{coopContractDoc.partyA.name}}</text>
              <text class="coop-party-line">店铺名称：{{coopContractDoc.partyA.shopName}}</text>
              <text class="coop-party-line">联系电话：{{coopContractDoc.partyA.phone}}</text>
              <text class="coop-party-line">营业地址：{{coopContractDoc.partyA.address}}</text>
            </view>
            <view class="coop-party-block">
              <text class="coop-party-label">{{coopContractDoc.partyB.label}}</text>
              <text class="coop-party-line">平台名称：{{coopContractDoc.partyB.name}}</text>
              <text class="coop-party-line">主体身份：{{coopContractDoc.partyB.role}}</text>
            </view>
          </view>

          <view class="coop-contract-section" wx:for="{{coopContractDoc.sections}}" wx:key="title" wx:for-item="section">
            <text class="coop-section-title">{{section.title}}</text>
            <text class="coop-section-item" wx:for="{{section.items}}" wx:key="*this" wx:for-index="idx">{{idx + 1}}. {{item}}</text>
          </view>

          <text class="coop-contract-footer">本协议以电子形式订立，甲方在本平台点击「确认签署」并完成入驻申请，即视为同意本协议全部条款；本协议对甲乙双方均具有法律约束力。</text>

          <view class="coop-sign-stamp" wx:if="{{coopContractDoc.signed}}">
            <text class="coop-sign-stamp-title">电子签署记录</text>
            <text class="coop-sign-stamp-line">签署人：{{coopContractDoc.partyA.name}}</text>
            <text class="coop-sign-stamp-line">签署时间：{{coopContractDoc.signTime}}</text>
            <text class="coop-sign-stamp-line">签署方式：电子确认</text>
          </view>
        </view>
      </scroll-view>
      <view class="clause-modal-footer coop-contract-footer-bar" wx:if="{{coopContractMode === 'sign'}}" catchtouchmove="preventMove">
        <view class="coop-sign-tip-wrap">
          <text class="coop-sign-tip">请仔细阅读全部条款后确认签署</text>
        </view>
        <button class="clause-btn clause-btn-primary coop-sign-btn" bindtap="onConfirmCoopSign">我已阅读并同意，确认签署</button>
      </view>
    </view>
  </view>

  <view class="clause-modal" wx:if="{{showContractModal}}">
    <view class="clause-modal-mask" catchtouchmove="preventMove" bindtap="onCloseContractModal"></view>
    <view class="clause-modal-panel">
      <view class="clause-modal-header" catchtouchmove="preventMove">
        <text class="clause-modal-title">编辑寄养协议条款</text>
        <text class="clause-modal-close" bindtap="onCloseContractModal">×</text>
      </view>
      <view class="clause-modal-body">
        <view class="form-group clause-editor-group">
          <text class="form-label" catchtouchmove="preventMove">协议条款正文</text>
          <text class="clause-field-hint" catchtouchmove="preventMove">请保留「一、」「二、」等章节标题，条款使用「1.」「2.」编号，便于客户阅读。赔付金额请直接在正文中修改。</text>
          <textarea
            class="form-textarea clause-textarea"
            value="{{contractClauseDraft}}"
            bindinput="onContractClauseInput"
            maxlength="-1"
            show-confirm-bar="{{false}}"
            auto-height="{{false}}"
          />
        </view>
      </view>
      <view class="clause-modal-footer" catchtouchmove="preventMove">
        <button class="clause-btn clause-btn-ghost" bindtap="onResetContractClause">恢复默认</button>
        <button class="clause-btn clause-btn-primary" bindtap="onSaveContractClause" loading="{{savingContractClause}}" disabled="{{savingContractClause}}">保存</button>
      </view>
    </view>
  </view>

  <view
    class="photo-drag-layer"
    wx:if="{{photoDrag.active}}"
    catchtouchmove="onPhotoTouchMove"
    bindtouchend="onPhotoTouchEnd"
    bindtouchcancel="onPhotoTouchEnd"
  >
    <view
      class="photo-drag-ghost"
      style="width:{{photoDrag.ghostSize}}px;height:{{photoDrag.ghostSize}}px;transform:translate3d({{photoDrag.ghostX}}px, {{photoDrag.ghostY}}px, 0) scale(1.08);"
    >
      <image class="photo-drag-ghost-img" src="{{photoDrag.ghostUrl}}" mode="aspectFill" />
    </view>
  </view>

</view>
<oa-follow-sheet
  show="{{oaFollowSheetVisible}}"
  title="申请已提交"
  headline="关注服务号，接收新订单提醒"
  desc="有新预约或订单变更时，服务号会第一时间通知你"
  bind:close="onCloseOaFollowSheet"
  bind:followed="onOaFollowSheetFollowed"
/>
<merchant-tab-bar wx:if="{{!hideMerchantTabBar}}" active="store" isDemoMode="{{isDemoMode}}" />
<hidden-admin-entry id="hiddenAdminEntry" />
