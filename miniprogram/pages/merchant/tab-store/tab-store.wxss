  color: #E98657;
  background: #FFF1E7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.clause-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  /* 必须高于 custom-tab-bar(10000)，否则底部保存按钮会被挡住 */
  z-index: 20000;
}
.clause-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.clause-modal-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 12vh;
  height: auto;
  max-height: 88vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.clause-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F2DEC9;
  flex-shrink: 0;
}
.clause-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.clause-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999999;
}
.clause-modal-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.clause-field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  flex-shrink: 0;
}
.clause-editor-group {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
}
.clause-textarea {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  margin-top: 12rpx;
  box-sizing: border-box;
}
.clause-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F2DEC9;
  flex-shrink: 0;
  background: #ffffff;
}

.coop-contract-panel {
