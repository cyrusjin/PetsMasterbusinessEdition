}
.contract-signed-info { flex: 1; min-width: 0; }
.contract-signed-title { display: block; font-size: 26rpx; font-weight: 600; color: #E98657; }
.contract-signed-time { display: block; font-size: 22rpx; color: #999999; margin-top: 4rpx; }
.contract-resign { font-size: 24rpx; color: #E98657; flex-shrink: 0; }
.btn-disabled { background: #F2DEC9 !important; opacity: 0.8; }

.contract-clause-tip {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
.contract-preview.tappable:active {
  opacity: 0.85;
}
.contract-preview-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.contract-custom-badge {
