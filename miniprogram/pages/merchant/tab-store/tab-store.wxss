@import '../../../styles/merchant-tab.wxss';
@import '../../../styles/settings-form.wxss';

.merchant-page.has-tab-bar {
  padding-bottom: 160rpx !important;
  box-sizing: border-box;
}

.merchant-page.apply-only {
  padding-bottom: 48rpx !important;
  box-sizing: border-box;
}

.incomplete-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
}
.incomplete-tip-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.apply-pending-card {
  margin-bottom: 24rpx;
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
}

.apply-tip {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}


.address-box {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
}
.address-content { flex: 1; min-width: 0; }
.address-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}
.address-placeholder { color: #999999; }
.address-coord {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}
.address-action-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #E98657;
  background: #FFF1E7;
  border: 2rpx solid #E98657;
  border-radius: 999rpx;
  line-height: 1.4;
}

.charge-section { background: #F7F8FA; border-radius: 16rpx; padding: 20rpx; }
.charge-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.charge-hint.mt-16 { margin-top: 16rpx; }
.day-charge-group { display: flex; gap: 16rpx; }
.day-charge-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #F2DEC9;
  background: #fff;
  font-size: 28rpx;
  color: #333333;
}
.day-charge-item.mode-active {
  background: #FFF1E7;
  border-color: #E98657;
  color: #E98657;
  font-weight: 600;
}
.time-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}
.time-picker-row:last-of-type { border-bottom: none; }
.time-picker-label { flex: 1; min-width: 0; }
.time-picker-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.time-picker-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}
.time-picker-value {
  min-width: 140rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #E98657;
  background: #fff;
  border: 2rpx solid #E98657;
  border-radius: 12rpx;
}
.charge-summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666666;
  background: #FFF1E7;
  border-radius: 12rpx;
}
.pickup-notice-group { margin-top: 20rpx; margin-bottom: 0; }
.pickup-pricing-group { margin-top: 20rpx; margin-bottom: 0; }

.business-hours-group { margin-bottom: 0; }

.store-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #E98657;
}
.store-info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
  flex-shrink: 0;
}
.store-status-area { flex-shrink: 0; }
.store-status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.store-status-badge.incomplete {
  color: #999999;
  background: #F0F2F5;
  border: 2rpx solid #F2DEC9;
}
.business-status-group {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.business-status-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #666666;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 999rpx;
}
.business-status-item.active.open {
  color: #4CAF50;
  background: #E8F5E9;
  border-color: #4CAF50;
  font-weight: 600;
}
.business-status-item.active.closed {
  color: #E53935;
  background: #FFE8E8;
  border-color: #E53935;
  font-weight: 600;
}

.weekday-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.weekday-chip {
  min-width: 88rpx;
  padding: 14rpx 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  background: #fff;
  border: 2rpx solid #F2DEC9;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.weekday-chip.active {
  color: #E98657;
  background: #FFF1E7;
  border-color: #E98657;
  font-weight: 600;
}
.business-time-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.business-time-item { flex: 1; min-width: 0; }
.business-time-sep {
  flex-shrink: 0;
  padding-bottom: 18rpx;
  font-size: 26rpx;
  color: #999999;
}
.business-hours-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999999;
}

.reception-range-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.reception-range-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  color: #333333;
  background: #fff;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
}
.reception-range-item.active {
  color: #E98657;
  background: #FFF1E7;
  border-color: #E98657;
  font-weight: 600;
}
.reception-range-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.store-photos-tip {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #999999;
}
.store-photos-empty {
  display: block;
  padding: 28rpx 0;
  font-size: 24rpx;
  color: #bbbbbb;
}
.store-photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.store-photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  transition: transform 0.18s ease, opacity 0.18s ease, box-shadow 0.18s ease;
}
.store-photo-item.drag-source {
  opacity: 0.28;
}
.store-photo-item.drop-target {
  transform: scale(1.04);
  box-shadow: 0 0 0 4rpx rgba(233, 134, 87, 0.55);
}
.store-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F2DEC9;
}
.photo-drag-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  pointer-events: auto;
}
.photo-drag-ghost {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 1001;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.28);
  transform-origin: center center;
  pointer-events: none;
  will-change: transform;
  opacity: 0.96;
  animation: photo-drag-lift 0.16s ease-out;
}
@keyframes photo-drag-lift {
  from {
    opacity: 0.7;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  }
  to {
    opacity: 0.96;
    box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.28);
  }
}
.photo-drag-ghost-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 16rpx;
}
.store-photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
}
.store-photo-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed #E98657;
  border-radius: 16rpx;
  background: #F7F8FA;
  color: #E98657;
}
.store-photo-add-icon {
  font-size: 56rpx;
  line-height: 1;
}
.store-photo-add-text {
  font-size: 24rpx;
}

.share-card { margin-top: 20rpx; }
.share-tip {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.share-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.share-preview-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #F2DEC9;
  flex-shrink: 0;
}
.share-preview-info { flex: 1; min-width: 0; }
.share-preview-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.share-preview-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
.btn-share {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  border-radius: 40rpx;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 18rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}
.btn-share::after { border: none; }
.btn-share-disabled {
  background: #F2DEC9;
  color: #999999;
}
.share-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}
.apply-rejected-card {
  border: 2rpx solid #FFCDD2;
  background: #FFF5F5;
}
.apply-rejected-card .card-title {
  color: #E53935;
}
.apply-reject-reason {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #FFCDD2;
  border-radius: 12rpx;
}
.apply-reject-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #E53935;
  font-weight: 600;
}
.apply-reject-text {
  display: block;
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}
.apply-disabled-card {
  border: 2rpx solid #E0E0E0;
  background: #F5F5F5;
}
.contract-agreement { }
.contract-preview { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; background: #F7F8FA; border-radius: 16rpx; margin-bottom: 20rpx; }
.contract-icon { font-size: 40rpx; }
.contract-info { flex: 1; }
.contract-title { font-size: 28rpx; font-weight: 600; color: #333333; display: block; }
.contract-desc { font-size: 22rpx; color: #999999; display: block; margin-top: 4rpx; }
.contract-link { font-size: 24rpx; color: #E98657; flex-shrink: 0; }
.contract-sign-row { margin-top: 24rpx; text-align: center; }
.btn-contract-sign {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  margin: 0;
  padding: 18rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}
.btn-contract-sign::after { border: none; }
.contract-sign-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}
.contract-signed-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF1E7;
  border-radius: 16rpx;
}
.contract-signed-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
