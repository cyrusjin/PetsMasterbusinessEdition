@import '../../../styles/merchant-tab.wxss';
@import '../settings/settings.wxss';

.merchant-page.has-tab-bar {
  padding-bottom: 160rpx !important;
  box-sizing: border-box;
}

.incomplete-tip {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
  border-radius: 16rpx;
}
.incomplete-tip-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.apply-pending-card {
  margin-bottom: 24rpx;
  background: #FFF1E7;
  border: 1rpx solid #F2C39E;
}

.apply-tip {
  display: block;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}

.address-box {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
}
.address-content { flex: 1; min-width: 0; }
.address-text {
  display: block;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  word-break: break-all;
}
.address-placeholder { color: #999999; }
.address-coord {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
}
.address-action-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #E98657;
  background: #FFF1E7;
  border: 2rpx solid #E98657;
  border-radius: 999rpx;
  line-height: 1.4;
}

.charge-section { background: #F7F8FA; border-radius: 16rpx; padding: 20rpx; }
.charge-hint {
  display: block;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.charge-hint.mt-16 { margin-top: 16rpx; }
.day-charge-group { display: flex; gap: 16rpx; }
.day-charge-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 16rpx;
  border: 2rpx solid #F2DEC9;
  background: #fff;
  font-size: 28rpx;
  color: #333333;
}
.day-charge-item.mode-active {
  background: #FFF1E7;
  border-color: #E98657;
  color: #E98657;
  font-weight: 600;
}
.time-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}
.time-picker-row:last-of-type { border-bottom: none; }
.time-picker-label { flex: 1; min-width: 0; }
.time-picker-title {
  display: block;
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.time-picker-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}
.time-picker-value {
  min-width: 140rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #E98657;
  background: #fff;
  border: 2rpx solid #E98657;
  border-radius: 12rpx;
}
.charge-summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #666666;
  background: #FFF1E7;
  border-radius: 12rpx;
}
.pickup-notice-group { margin-top: 20rpx; margin-bottom: 0; }
.pickup-pricing-group { margin-top: 20rpx; margin-bottom: 0; }

.business-hours-group { margin-bottom: 0; }

.store-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #E98657;
}
.store-info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
  flex-shrink: 0;
}
.store-status-area { flex-shrink: 0; }
.store-status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.store-status-badge.incomplete {
  color: #999999;
  background: #F0F2F5;
  border: 2rpx solid #F2DEC9;
}
.business-status-group {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
.business-status-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  font-size: 22rpx;
  color: #666666;
  background: #F7F8FA;
  border: 2rpx solid #F2DEC9;
  border-radius: 999rpx;
}
.business-status-item.active.open {
  color: #4CAF50;
  background: #E8F5E9;
  border-color: #4CAF50;
  font-weight: 600;
}
.business-status-item.active.closed {
  color: #E53935;
  background: #FFE8E8;
  border-color: #E53935;
  font-weight: 600;
}

.weekday-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.weekday-chip {
  min-width: 88rpx;
  padding: 14rpx 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #666666;
  background: #fff;
  border: 2rpx solid #F2DEC9;
  border-radius: 999rpx;
  box-sizing: border-box;
}
.weekday-chip.active {
  color: #E98657;
  background: #FFF1E7;
  border-color: #E98657;
  font-weight: 600;
}
.business-time-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}
.business-time-item { flex: 1; min-width: 0; }
.business-time-sep {
  flex-shrink: 0;
  padding-bottom: 18rpx;
  font-size: 26rpx;
  color: #999999;
}
.business-hours-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999999;
}

.reception-range-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.reception-range-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  color: #333333;
  background: #fff;
  border: 2rpx solid #F2DEC9;
  border-radius: 16rpx;
}
.reception-range-item.active {
  color: #E98657;
  background: #FFF1E7;
  border-color: #E98657;
  font-weight: 600;
}
.reception-range-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.store-photos-tip {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #999999;
}
.store-photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.store-photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.store-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F2DEC9;
}
.store-photo-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 50%;
}
.store-photo-add {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx dashed #E98657;
  border-radius: 16rpx;
  background: #F7F8FA;
  color: #E98657;
}
.store-photo-add-icon {
  font-size: 56rpx;
  line-height: 1;
}
.store-photo-add-text {
  font-size: 24rpx;
}

.share-card { margin-top: 20rpx; }
.share-tip {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.share-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.share-preview-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #F2DEC9;
  flex-shrink: 0;
}
.share-preview-info { flex: 1; min-width: 0; }
.share-preview-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.share-preview-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
.btn-share {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  border-radius: 40rpx;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 18rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}
.btn-share::after { border: none; }
.btn-share-disabled {
  background: #F2DEC9;
  color: #999999;
}
.share-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}
.apply-rejected-card {
  border: 2rpx solid #FFCDD2;
  background: #FFF5F5;
}
.apply-disabled-card {
  border: 2rpx solid #E0E0E0;
  background: #F5F5F5;
}
.contract-agreement { }
.contract-preview { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; background: #F7F8FA; border-radius: 16rpx; margin-bottom: 20rpx; }
.contract-icon { font-size: 40rpx; }
.contract-info { flex: 1; }
.contract-title { font-size: 28rpx; font-weight: 600; color: #333333; display: block; }
.contract-desc { font-size: 22rpx; color: #999999; display: block; margin-top: 4rpx; }
.contract-link { font-size: 24rpx; color: #E98657; flex-shrink: 0; }
.contract-sign-row { margin-top: 24rpx; text-align: center; }
.btn-contract-sign {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  margin: 0;
  padding: 18rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  line-height: 1.2;
}
.btn-contract-sign::after { border: none; }
.contract-sign-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999999;
  text-align: center;
}
.contract-signed-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #FFF1E7;
  border-radius: 16rpx;
}
.contract-signed-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: #E98657;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
}
.contract-signed-info { flex: 1; min-width: 0; }
.contract-signed-title { display: block; font-size: 26rpx; font-weight: 600; color: #E98657; }
.contract-signed-time { display: block; font-size: 22rpx; color: #999999; margin-top: 4rpx; }
.contract-resign { font-size: 24rpx; color: #E98657; flex-shrink: 0; }
.btn-disabled { background: #F2DEC9 !important; opacity: 0.8; }

.contract-clause-tip {
  display: block;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
.contract-preview.tappable:active {
  opacity: 0.85;
}
.contract-preview-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}
.contract-custom-badge {
  font-size: 22rpx;
  color: #E98657;
  background: #FFF1E7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.clause-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
}
.clause-modal-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.clause-modal-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88vh;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.clause-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #F2DEC9;
  flex-shrink: 0;
}
.clause-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}
.clause-modal-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 40rpx;
  color: #999999;
}
.clause-modal-body {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.clause-field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999999;
  line-height: 1.5;
  flex-shrink: 0;
}
.clause-editor-group {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
}
.clause-textarea {
  flex: 1;
  width: 100%;
  height: 48vh;
  min-height: 400rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}
.clause-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #F2DEC9;
  flex-shrink: 0;
}
.clause-btn {
  flex: 1;
  min-height: 80rpx;
  height: auto;
  margin: 0;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  white-space: nowrap;
  line-height: 1.2;
}
.clause-btn::after {
  border: none;
}
.clause-btn-ghost {
  background: #F7F8FA;
  color: #666666;
}
.clause-btn-primary {
  background: #E98657;
  color: #ffffff;
  font-weight: 600;
}
