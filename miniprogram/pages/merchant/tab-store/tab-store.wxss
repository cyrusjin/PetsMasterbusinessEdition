}

.coop-sign-stamp-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #E98657;
  margin-bottom: 10rpx;
}

.coop-sign-stamp-line {
  display: block;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
}

.coop-contract-footer-bar {
