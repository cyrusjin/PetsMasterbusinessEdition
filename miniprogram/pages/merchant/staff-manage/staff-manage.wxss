.tip-card {
  margin-bottom: 20rpx;
}
.tip-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #666666;
}
.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
.staff-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}
.staff-item:last-child {
  border-bottom: none;
}
.staff-avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFF1E7;
  color: #E98657;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.staff-info {
  flex: 1;
  min-width: 0;
}
.staff-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.staff-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
}
.staff-remove-btn {
  margin: 0;
  padding: 0 24rpx;
  min-height: 56rpx;
  height: auto;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #E53935;
  background: #fff;
  border: 2rpx solid #FFCDD2;
  border-radius: 28rpx;
  flex-shrink: 0;
  white-space: nowrap;
  line-height: 1.2;
}
.staff-remove-btn::after {
  border: none;
}
