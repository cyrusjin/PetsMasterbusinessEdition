<view class="merchant-page pickup-page">
  <view class="container">
    <view class="demo-banner" wx:if="{{isDemoMode}}">
      <text class="demo-banner-text">体验模式 · 以下为演示接送任务</text>
    </view>

    <view class="leg-tabs">
      <view
        class="leg-tab {{leg === 'outbound' ? 'active' : ''}}"
        data-leg="outbound"
        bindtap="onLegTab"
      >
        <text>接</text>
        <view class="leg-badge" wx:if="{{outboundCount > 0}}">{{outboundCount > 99 ? '99+' : outboundCount}}</view>
      </view>
      <view
        class="leg-tab {{leg === 'return' ? 'active' : ''}}"
        data-leg="return"
        bindtap="onLegTab"
      >
        <text>送</text>
        <view class="leg-badge" wx:if="{{returnCount > 0}}">{{returnCount > 99 ? '99+' : returnCount}}</view>
      </view>
    </view>

    <view class="pickup-list" wx:if="{{list.length}}">
      <view class="pickup-card" wx:for="{{list}}" wx:key="id">
        <view class="pickup-head" bindtap="onGoOrderDetail" data-id="{{item.id}}">
          <cached-image wx:if="{{item.petPhoto}}" src="{{item.petPhoto}}" mode="aspectFill" custom-class="pickup-avatar" />
          <view wx:else class="pickup-avatar pickup-avatar-text">{{item.petName[0]}}</view>
          <view class="pickup-head-main">
            <view class="pickup-title-row">
              <text class="pickup-pet">{{item.petName}}</text>
              <text class="pickup-leg-tag">{{item.legLabel}}</text>
            </view>
            <text class="pickup-owner text-gray">{{item.contactName}} · {{item.statusLabel}}</text>
          </view>
        </view>

        <view class="pickup-info-row">
          <text class="pickup-label">订单号</text>
          <text class="pickup-value copyable-order-no" catchtap="onCopyOrderNo" data-no="{{item.displayNo}}">{{item.displayNo}}</text>
        </view>
        <view class="pickup-info-row">
          <text class="pickup-label">下单时间</text>
          <text class="pickup-value">{{item.createTimeText}}</text>
        </view>
        <view class="pickup-info-row">
          <text class="pickup-label">接送时间</text>
          <text class="pickup-value">{{item.pickupTimeText}}</text>
        </view>
        <view class="pickup-info-row">
          <text class="pickup-label">接送地址</text>
          <text class="pickup-value pickup-address">{{item.pickupAddress}}</text>
        </view>
        <view class="pickup-info-row" wx:if="{{item.shippingFee > 0}}">
          <text class="pickup-label">接送费</text>
          <text class="pickup-value">¥{{item.shippingFee}}</text>
        </view>

        <view class="pickup-actions">
          <button
            class="pickup-btn pickup-btn-ghost"
            size="mini"
            wx:if="{{item.contactPhone}}"
            catchtap="onCallPhone"
            data-phone="{{item.contactPhone}}"
          >拨打电话</button>
          <button
            class="pickup-btn pickup-btn-ghost"
            size="mini"
            wx:if="{{item.hasCoords}}"
            catchtap="onOpenMap"
            data-lat="{{item.pickupLatitude}}"
            data-lng="{{item.pickupLongitude}}"
            data-name="{{item.pickupLocationName}}"
            data-address="{{item.pickupAddress}}"
          >导航</button>
          <button
            class="pickup-btn pickup-btn-primary"
            size="mini"
            wx:if="{{item.leg === 'outbound'}}"
            catchtap="onConfirmOutbound"
            data-id="{{item.id}}"
          >已到店</button>
          <button
            class="pickup-btn pickup-btn-primary"
            size="mini"
            wx:if="{{item.leg === 'return'}}"
            catchtap="onConfirmReturn"
            data-id="{{item.id}}"
          >确认已送</button>
        </view>
      </view>
    </view>

    <view class="empty-card" wx:if="{{!loading && !list.length}}">
      <text class="empty-title">暂无{{leg === 'return' ? '送' : '接'}}宠任务</text>
      <text class="empty-desc">需要接送且待到店或寄养中的订单会显示在这里</text>
    </view>
  </view>
</view>
