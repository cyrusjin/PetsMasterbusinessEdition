<view class="check-in-page {{hideTabBar ? 'no-tab' : ''}}">
  <view class="page-content">
    <view class="demo-tip" wx:if="{{isDemoMode}}">展示模式 · 签到奖励不会计入真实会员</view>
    <view class="expired-banner" wx:if="{{showExpiredBanner}}">会员已到期 · 签到即可领回 1 天，立刻恢复经营</view>
    <view class="expired-banner restored" wx:if="{{restoredAccess}}">会员已恢复 · 可继续使用经营功能</view>

    <view class="hero-panel">
      <view class="hero-copy">
        <view class="activity-pill">
          <view class="activity-dot"></view>
          <text>会员能量补给站</text>
        </view>
        <text class="hero-title">每天签到，会员天天领</text>
        <text class="hero-subtitle">连续冒险 21 天，再送 1 个月会员</text>
        <view class="hero-deadline" wx:if="{{checkInCampaignExpireText}}">活动截止 {{checkInCampaignExpireText}}</view>
      </view>
      <view class="gift-scene">
        <text class="gift-mark">🎁</text>
      </view>
      <view class="hero-stats">
        <view class="hero-stat">
          <text class="stat-value">{{checkIn.currentStreak}}</text>
          <text class="stat-label">连续签到</text>
        </view>
        <view class="stat-divider"></view>
        <view class="hero-stat">
          <text class="stat-value">{{checkIn.totalCheckIns}}</text>
          <text class="stat-label">累计签到</text>
        </view>
        <view class="stat-divider"></view>
        <view class="hero-stat">
          <text class="stat-value">{{checkIn.daysToBonus}}</text>
          <text class="stat-label">距月卡奖励</text>
        </view>
      </view>
    </view>

    <view class="quest-card">
      <view class="quest-head">
        <view>
          <text class="quest-kicker">21 DAY QUEST</text>
          <text class="quest-title">会员冒险地图</text>
        </view>
        <view class="quest-progress">
          <text>{{checkIn.cycleDay}}</text>/21
        </view>
      </view>
      <view class="quest-rule">
        <text class="rule-spark">✦</text>
        <text>每日签到得 1 天，第 21 天额外得 1 个月</text>
      </view>

      <view class="trail">
        <view class="{{item.nodeClass}}" wx:for="{{checkIn.progress}}" wx:key="day">
          <view class="node-bubble">
            <text wx:if="{{item.showCheck}}" class="node-check">✓</text>
            <text wx:elif="{{item.showGift}}" class="node-gift">🎁</text>
            <text wx:else class="node-day">{{item.day}}</text>
          </view>
          <text class="node-reward">{{item.rewardText}}</text>
        </view>
      </view>

      <button class="btn-primary" bindtap="onCheckIn" loading="{{checking}}" disabled="{{checkDisabled}}">{{checkButtonText}}</button>
      <text class="check-hint" wx:if="{{checkHintText}}">{{checkHintText}}</text>
      <button class="btn-outline enter-home" wx:if="{{hideTabBar && !restoredAccess}}" bindtap="onBackMembership">返回开通会员</button>
      <button class="btn-outline enter-home" wx:if="{{restoredAccess}}" bindtap="onEnterMerchant">进入日常管理</button>
    </view>

    <view class="reward-guide">
      <view class="guide-head">
        <text class="guide-title">冒险奖励</text>
        <text class="guide-tag">活动进行中</text>
      </view>
      <view class="guide-item">
        <view class="guide-icon daily">+1</view>
        <view class="guide-copy">
          <text class="guide-name">每日能量</text>
          <text class="guide-desc">每天签到，会员有效期自动增加 1 天</text>
        </view>
        <text class="guide-state">每天可领</text>
      </view>
      <view class="guide-item last">
        <view class="guide-icon monthly">21</view>
        <view class="guide-copy">
          <text class="guide-name">终点宝箱</text>
          <text class="guide-desc">连续签到 21 天，额外增加 1 个月会员</text>
        </view>
        <text class="guide-state gold">循环可得</text>
      </view>
    </view>

    <view class="rules-card">
      <text class="rules-title">活动说明</text>
      <view class="rules-row"><text>01</text><view>每个门店每天限签到 1 次，奖励直接发放至当前门店。</view></view>
      <view class="rules-row"><text>02</text><view>连续签到中断后将从第 1 天重新累计，累计签到次数保留。</view></view>
      <view class="rules-row"><text>03</text><view>21 天奖励可循环获得，第 21 天同时获得当日 1 天会员。</view></view>
      <view class="rules-row"><text>04</text><view>本店签到活动开放 21 天，截止至 {{checkInCampaignExpireText}}，到期后签到入口关闭。</view></view>
    </view>
  </view>
</view>

<merchant-tab-bar id="merchantTabBar" active="checkIn" isDemoMode="{{isDemoMode}}" hideBar="{{hideTabBar}}" />

<view class="reward-modal" wx:if="{{rewardVisible}}" catchtouchmove="preventMove">
  <view class="reward-mask" bindtap="onCloseReward"></view>
  <view class="reward-panel">
    <view class="reward-medal"><text>✓</text></view>
    <text class="reward-title">签到成功</text>
    <text class="reward-subtitle">今日冒险能量已到账</text>
    <view class="reward-ticket">
      <text class="ticket-plus">+</text>
      <text class="ticket-number">{{rewardDays}}</text>
      <text class="ticket-unit">天会员</text>
    </view>
    <view class="bonus-ticket" wx:if="{{bonusMonths > 0}}">
      <text>终点宝箱开启</text>
      <text class="bonus-ticket-value">额外 +{{bonusMonths}} 个月会员</text>
    </view>
    <text class="reward-progress" wx:if="{{showRewardProgress}}">已连续签到 {{checkIn.currentStreak}} 天 · 距月卡还有 {{checkIn.daysToBonus}} 天</text>
    <button class="btn-primary" bindtap="onConfirmReward">{{rewardConfirmText}}</button>
  </view>
</view>
