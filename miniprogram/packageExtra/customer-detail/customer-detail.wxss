.empty-card {
  text-align: center;
  padding: 48rpx 32rpx;
}
.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}
.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.6;
}
.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFF1E7;
  color: #E98657;
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.profile-info {
  flex: 1;
  min-width: 0;
}
.profile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}
.profile-phone {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666666;
}
.call-btn {
  margin: 0;
  padding: 0 28rpx;
  min-height: 56rpx;
  height: auto;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #E98657;
  border-radius: 28rpx;
  border: none;
  white-space: nowrap;
  line-height: 1.2;
  flex-shrink: 0;
}
.call-btn::after {
  border: none;
}
.stat-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.stat-item {
  flex: 1;
  background: #F7F8FA;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}
.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #E98657;
  line-height: 1.2;
}
.stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2DEC9;
  margin-top: 20rpx;
}
.detail-label {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}
.detail-value {
  font-size: 24rpx;
  color: #333333;
  text-align: right;
}
.empty-pets {
  padding: 24rpx 0 8rpx;
  text-align: center;
}
.pet-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}
.pet-item:last-child {
  border-bottom: none;
}
.pet-item:active {
  opacity: 0.85;
}
.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #FFF1E7;
}
.pet-avatar-fallback {
  line-height: 80rpx;
  text-align: center;
  color: #E98657;
  font-size: 28rpx;
  font-weight: 600;
}
.pet-info {
  flex: 1;
  min-width: 0;
}
.pet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.pet-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999999;
}
.pet-extra {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}
.pet-extra text {
  display: block;
  font-size: 22rpx;
  color: #666666;
  line-height: 1.7;
}
.pet-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  flex-shrink: 0;
  line-height: 80rpx;
}
.order-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}
.order-item:last-child {
  border-bottom: none;
}
.order-item:active {
  opacity: 0.85;
}
.order-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.order-main {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}
.order-pet-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #FFF1E7;
}
.order-pet-fallback {
  line-height: 72rpx;
  text-align: center;
  color: #E98657;
  font-size: 26rpx;
  font-weight: 600;
}
.order-info {
  flex: 1;
  min-width: 0;
}
.order-pet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}
.order-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding-left: 88rpx;
}
.order-fee {
  font-size: 28rpx;
  font-weight: 700;
  color: #E98657;
}
.order-link {
  font-size: 22rpx;
  color: #999999;
}
