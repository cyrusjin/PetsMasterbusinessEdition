<view class="container">
  <view class="card" wx:if="{{loading}}">
    <text class="text-gray">加载中...</text>
  </view>

  <view class="card empty-card" wx:elif="{{!customer}}">
    <text class="empty-title">未找到该客户</text>
    <text class="empty-desc">可能已被清理或订单数据尚未同步</text>
  </view>

  <block wx:else>
    <view class="card">
      <view class="profile-head">
        <view class="profile-avatar">{{customer.avatarText}}</view>
        <view class="profile-info">
          <text class="profile-name">{{customer.name}}</text>
          <text class="profile-phone" wx:if="{{customer.phone}}">{{customer.phone}}</text>
          <text class="profile-phone" wx:else>暂无联系电话</text>
        </view>
        <button
          wx:if="{{customer.phone}}"
          class="call-btn"
          size="mini"
          bindtap="onCall"
        >拨打</button>
      </view>

      <view class="stat-row">
        <view class="stat-item">
          <text class="stat-value">{{customer.orderCount}}</text>
          <text class="stat-label">总单数</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{customer.petCount}}</text>
          <text class="stat-label">宠物数</text>
        </view>
      </view>

      <view class="detail-row" wx:if="{{customer.lastOrderTimeText}}">
        <text class="detail-label">最近下单</text>
        <text class="detail-value">{{customer.lastOrderTimeText}}</text>
      </view>
      <view class="detail-row" wx:if="{{customer.nickName && customer.nickName !== customer.name}}">
        <text class="detail-label">微信昵称</text>
        <text class="detail-value">{{customer.nickName}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">宠物管理 ({{customer.petCount}})</view>

      <view class="empty-pets" wx:if="{{!customer.pets.length}}">
        <text class="empty-desc">暂无关联宠物</text>
      </view>

      <view
        class="pet-item"
        wx:for="{{customer.pets}}"
        wx:key="key"
        bindtap="onTogglePet"
        data-key="{{item.key}}"
      >
        <cached-image
          wx:if="{{item.photo}}"
          src="{{item.photo}}"
          mode="aspectFill"
          custom-class="pet-avatar"
        />
        <view wx:else class="pet-avatar pet-avatar-fallback">{{item.name[0]}}</view>
        <view class="pet-info">
          <text class="pet-name">{{item.name}}</text>
          <text class="pet-meta">{{item.metaText}}</text>
          <view class="pet-extra" wx:if="{{expandedPetKey === item.key}}">
            <text wx:if="{{item.type}}">类型：{{item.type}}</text>
            <text wx:if="{{item.breed}}">品种：{{item.breed}}</text>
            <text wx:if="{{item.gender}}">性别：{{item.gender}}</text>
            <text wx:if="{{item.ageText}}">年龄：{{item.ageText}}</text>
            <text wx:if="{{item.weightText}}">体重：{{item.weightText}}</text>
          </view>
        </view>
        <text class="pet-arrow">›</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">历史订单 ({{orders.length}})</view>

      <view class="empty-pets" wx:if="{{!orders.length}}">
        <text class="empty-desc">暂无历史订单</text>
      </view>

      <view
        class="order-item"
        wx:for="{{orders}}"
        wx:key="id"
        bindtap="onOpenOrder"
        data-id="{{item.id}}"
      >
        <view class="order-top">
          <view class="order-main">
            <cached-image
              wx:if="{{item.petPhoto}}"
              src="{{item.petPhoto}}"
              mode="aspectFill"
              custom-class="order-pet-avatar"
            />
            <view wx:else class="order-pet-avatar order-pet-fallback">{{item.petName[0]}}</view>
            <view class="order-info">
              <text class="order-pet-name">{{item.petName}}</text>
              <text class="order-meta">{{item.serviceType}} · {{item.createTimeText}}</text>
              <text class="order-meta">寄养：{{item.boardingTime}}</text>
              <text class="order-meta" wx:if="{{item.displayNo}}">单号：{{item.displayNo}}</text>
            </view>
          </view>
          <view class="status-badge {{item.pricePendingConfirm ? 'status-price-pending' : 'status-' + item.status}}">
            {{item.statusLabel}}
          </view>
        </view>
        <view class="order-bottom">
          <text class="order-fee" wx:if="{{item.totalFee !== ''}}">¥{{item.totalFee}}</text>
          <text class="order-fee" wx:else>费用待定</text>
          <text class="order-link">查看详情 ›</text>
        </view>
      </view>
    </view>

  </block>
</view>
