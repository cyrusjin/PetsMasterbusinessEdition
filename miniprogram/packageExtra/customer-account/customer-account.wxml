<view class="container"><view class="card"><view class="card-title">客户账户操作</view><input class="form-input" placeholder="客户手机号" value="{{phone}}" data-field="phone" bindinput="onInput"/><input class="form-input" placeholder="客户姓名（新建时填写）" value="{{name}}" data-field="name" bindinput="onInput"/><view class="switch-row"><text>操作类型</text><picker mode="selector" range="{{modeNames}}" value="{{modeIndex}}" bindchange="onModeChange"><view>{{modeNames[modeIndex]}} ›</view></picker></view><input class="form-input" type="digit" placeholder="金额" value="{{amount}}" data-field="amount" bindinput="onInput"/><input class="form-input" placeholder="用途/备注（必填）" value="{{remark}}" data-field="remark" bindinput="onInput"/><button class="btn-primary" loading="{{saving}}" bindtap="onSubmit">{{modeIndex === 0 ? '确认充值' : '确认核销'}}</button></view><view class="card" wx:if="{{ledger.length}}"><view class="card-title">账户流水</view><view wx:for="{{ledger}}" wx:key="createTime" class="ledger-row"><text>{{item.remark || item.type}}</text><text class="ledger-amount">{{item.amount > 0 ? '+' : ''}}{{item.amount}}</text></view></view></view>
