.poster-page { min-height: 100vh; padding: 28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #4c3528; background: #f7f5f2; }
.intro-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.intro-title { display: block; font-size: 34rpx; font-weight: 800; }
.intro-desc { display: block; margin-top: 7rpx; color: #9b887c; font-size: 22rpx; }
.section-label { color: #695044; font-size: 25rpx; font-weight: 750; }
.service-section { margin-bottom: 24rpx; }
.service-tabs { display: flex; gap: 14rpx; margin-top: 15rpx; overflow-x: auto; }
.service-tab { display: flex; align-items: center; flex: 1; min-width: 0; gap: 10rpx; padding: 18rpx 14rpx; border: 2rpx solid transparent; border-radius: 22rpx; box-sizing: border-box; background: #fff; box-shadow: 0 6rpx 20rpx rgba(90, 65, 49, .05); }
.service-tab.active { border-color: #e78962; background: #fff7f2; box-shadow: 0 8rpx 22rpx rgba(224, 116, 73, .13); }
.service-tab.active.service-wash { border-color: #6db9ad; background: #f2fbf9; }
.service-tab.active.service-homeFeeding { border-color: #8ba18a; background: #f5f9f3; }
.service-emoji { flex: 0 0 auto; font-size: 30rpx; }
.service-name { display: block; white-space: nowrap; color: #513b30; font-size: 23rpx; font-weight: 750; }
.service-desc { display: none; margin-top: 3rpx; color: #aa968a; font-size: 17rpx; white-space: nowrap; }
.poster-stage { position: relative; width: 600rpx; height: 800rpx; margin: 0 auto; overflow: hidden; border-radius: 30rpx; background: #eee9e4; box-shadow: 0 22rpx 54rpx rgba(91, 67, 52, .16); }
.poster-canvas { width: 600rpx; height: 800rpx; }
.poster-loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: #fff; font-size: 23rpx; background: rgba(64, 52, 43, .30); backdrop-filter: blur(4rpx); }
.loading-dot { width: 28rpx; height: 28rpx; border: 5rpx solid rgba(255,255,255,.45); border-top-color: #fff; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.copy-section { margin-top: 26rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.change-background { padding: 8rpx 16rpx; border-radius: 999rpx; color: #df7952; font-size: 20rpx; background: #fff0e9; }
.copy-scroll { width: 100%; margin-top: 15rpx; white-space: nowrap; }
.copy-row { display: inline-flex; gap: 14rpx; padding: 2rpx 2rpx 8rpx; }
.copy-chip { padding: 15rpx 24rpx; border: 2rpx solid transparent; border-radius: 999rpx; color: #8e796d; font-size: 22rpx; background: #fff; }
.copy-chip.active { border-color: #ed9a78; color: #db724b; background: #fff7f2; font-weight: 700; }
.editor-card { margin-top: 18rpx; padding: 28rpx 28rpx 12rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 30rpx rgba(103, 72, 54, .06); }
.editor-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.editor-title { font-size: 29rpx; font-weight: 800; }
.editor-tip { color: #c0aa9d; font-size: 20rpx; }
.field { padding: 20rpx 0; border-bottom: 1rpx solid #f1e8e2; }
.field.last { border-bottom: 0; }
.field-label { display: block; margin-bottom: 11rpx; color: #9a8071; font-size: 21rpx; }
.field input, .field textarea { width: 100%; min-height: 38rpx; color: #4b3529; font-size: 27rpx; line-height: 1.55; }
.action-bar-safe { height: 15rpx; }
.action-bar { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 18rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background: rgba(255, 253, 251, .97); box-shadow: 0 -10rpx 30rpx rgba(91, 60, 42, .08); }
.action-btn { display: flex !important; align-items: center; justify-content: center; height: 88rpx; margin: 0; padding: 0 16rpx; border-radius: 24rpx; box-sizing: border-box; font-size: 26rpx; font-weight: 700; line-height: 1.2 !important; text-align: center; }
.action-btn::after { border: 0; }
.save-btn { flex: 0 0 210rpx; color: #d96f49; background: #fff0e8; }
.share-btn { flex: 1; color: #fff; background: linear-gradient(135deg, #ef986e, #df714c); box-shadow: 0 10rpx 24rpx rgba(218, 106, 68, .24); }
