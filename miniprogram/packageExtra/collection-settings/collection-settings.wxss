@import "../../styles/settings-form.wxss";
.container { padding: 24rpx 24rpx 64rpx; }
.hero { background: linear-gradient(135deg, #fff0de, #fffdf7); }
.headline { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; color: #613f2b; }
.hint { display: block; color: #786e64; font-size: 25rpx; line-height: 1.8; white-space: pre-wrap; }
.choice { display: flex; align-items: flex-start; gap: 16rpx; padding: 20rpx 0; }
.choice radio, .choice checkbox { flex-shrink: 0; }
.choice > view { flex: 1; }
.notice { display: block; background: #fff2db; color: #8a5c24; padding: 20rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.7; margin-bottom: 20rpx; }
.error { color: #ae4330; line-height: 1.7; }
button { margin-top: 20rpx; }
.agreement-link { color: #b5643c; padding: 22rpx 0; line-height: 1.8; }
.agreement-dialog-layer { position: fixed; inset: 0; z-index: 20000; }
.agreement-dialog-mask { position: absolute; inset: 0; background: rgba(0, 0, 0, .45); }
.agreement-dialog { position: absolute; left: 0; right: 0; top: 12vh; bottom: 0; display: flex; flex-direction: column; min-height: 0; background: #fff; border-radius: 24rpx 24rpx 0 0; overflow: hidden; box-sizing: border-box; }
.agreement-dialog-header { position: relative; z-index: 2; flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx 20rpx; border-bottom: 1rpx solid #f2dec9; background: #fff; }
.agreement-dialog-title { flex: 1; min-width: 0; padding-right: 16rpx; font-size: 32rpx; line-height: 1.5; font-weight: 600; color: #333; }
.agreement-dialog-close { flex-shrink: 0; width: 56rpx; height: 56rpx; line-height: 52rpx; text-align: center; font-size: 40rpx; color: #999; }
.agreement-dialog-body { flex: 1; min-height: 0; height: 0; box-sizing: border-box; background: #fff; }
.agreement-dialog-content { padding: 24rpx 32rpx 40rpx; box-sizing: border-box; }
.agreement-dialog-content .section { margin-top: 24rpx; overflow-wrap: break-word; }
.agreement-dialog-footer { position: relative; z-index: 2; flex-shrink: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #f2dec9; background: #fff; }
.agreement-dialog-footer .btn-primary { width: 100%; margin: 0; }
.section { font-size: 25rpx; line-height: 1.9; margin-bottom: 24rpx; color: #5f574f; }
.section-title { font-weight: 600; color: #332e28; }
.review-message { display: block; margin: 14rpx 0; padding: 18rpx; border-radius: 12rpx; background: #fff0ec; color: #a64f3f; font-size: 25rpx; line-height: 1.6; }
.steps { display: grid; grid-template-columns: 44rpx 1fr; gap: 14rpx 16rpx; margin: 20rpx 0; color: #675b51; font-size: 25rpx; line-height: 1.6; }
.steps > text { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; background: #fff0de; color: #b5643c; font-weight: 600; }
.form-group { margin-top: 26rpx; }
.form-label { display: block; margin-bottom: 12rpx; color: #403832; font-size: 26rpx; font-weight: 500; }
.form-input, .form-textarea { width: 100%; box-sizing: border-box; border: 1rpx solid #eaded3; border-radius: 14rpx; background: #faf8f5; color: #332e28; font-size: 27rpx; }
.form-input { height: 82rpx; padding: 0 22rpx; line-height: 82rpx; }
.form-textarea { min-height: 132rpx; padding: 20rpx 22rpx; line-height: 1.6; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.picker-value text { color: #ad9e92; font-size: 34rpx; }
.field-tip { display: block; margin-top: 10rpx; color: #9a8f85; font-size: 22rpx; line-height: 1.6; }
.date-input-row { display: flex; align-items: center; gap: 12rpx; }
.date-input-row .date-part { flex: 1; width: 0; min-width: 0; padding: 0 8rpx; text-align: center; }
.date-input-row .date-year { flex: 1.5; }
.date-input-row > text { flex-shrink: 0; font-size: 26rpx; color: #786e64; }
.date-long-term { display: flex; align-items: center; gap: 12rpx; margin: 12rpx 0 20rpx; font-size: 26rpx; color: #403832; }
.secure-note { display: block; box-sizing: border-box; width: 100%; margin: 12rpx 0 20rpx; padding: 20rpx; border-radius: 14rpx; background: #eef7f1; color: #4e725a; font-size: 24rpx; line-height: 1.7; white-space: normal; overflow-wrap: break-word; }
.photo-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.photo-item { position: relative; width: 190rpx; height: 150rpx; overflow: hidden; border-radius: 14rpx; background: #f3eee8; }
.photo-item image { width: 100%; height: 100%; }
.photo-item > text { position: absolute; right: 8rpx; top: 8rpx; padding: 6rpx 12rpx; border-radius: 999rpx; background: rgba(45,35,30,.72); color: #fff; font-size: 20rpx; }
.upload-btn { margin: 14rpx 0 0; border: 2rpx dashed #dda985; background: #fffaf6; color: #b5643c; font-size: 25rpx; }
.agreement-choice { gap: 14rpx; padding: 16rpx 0 24rpx; }
.agreement-choice .hint { flex: 1; min-width: 0; }
.application-actions { display: flex; flex-direction: column; gap: 24rpx; padding-top: 8rpx; }
.application-actions .btn-primary,
.application-actions .btn-outline { display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 88rpx; margin: 0; padding: 20rpx 24rpx; box-sizing: border-box; font-size: 28rpx; line-height: 1.5; white-space: normal; }

.private-preview { display: block; width: 100%; height: 260rpx; margin: 16rpx 0; border-radius: 16rpx; background: #f7f4ef; }
