@import '../../styles/merchant-tab.wxss';

.hero-card {
  background: linear-gradient(145deg, #FFF7EF 0%, #FFE8D6 100%);
  border: 1rpx solid #F2C39E;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.hero-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.price-row {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
}

.price-symbol {
  font-size: 32rpx;
  color: #E98657;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.price-num {
  font-size: 72rpx;
  line-height: 1;
  color: #E98657;
  font-weight: 800;
}

.price-unit {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
  margin-left: 8rpx;
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2DEC9;
}

.status-row:last-child {
  border-bottom: none;
}

.status-label {
  font-size: 28rpx;
  color: #666;
}

.status-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.status-value.pro {
  color: #E98657;
}

.benefit-item {
  position: relative;
  padding: 12rpx 0 12rpx 28rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.benefit-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E98657;
}

.pay-tip {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}
