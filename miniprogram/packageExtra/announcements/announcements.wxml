<view class="page">
  <view class="tip" wx:if="{{!loading && list.length}}">以下为平台下发的商家公告，点击查看详情</view>

  <view class="loading" wx:if="{{loading}}">加载中…</view>

  <view class="empty card" wx:elif="{{!list.length}}">
    <text class="empty-title">暂无公告</text>
    <text class="empty-desc">平台发布公告后会显示在这里</text>
  </view>

  <block wx:else>
    <view
      class="ann-card card {{item.pinned ? 'pinned' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      bindtap="onOpenDetail"
      data-id="{{item.id}}"
    >
      <view class="ann-top">
        <view class="ann-title-wrap">
          <text class="pin-tag" wx:if="{{item.pinned}}">置顶</text>
          <text class="ann-title">{{item.title}}</text>
        </view>
        <text class="ann-arrow">›</text>
      </view>
      <text class="ann-preview" wx:if="{{item.preview}}">{{item.preview}}</text>
      <text class="ann-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
    </view>
  </block>
</view>
