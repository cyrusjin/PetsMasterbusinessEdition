.merchant-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #F2DEC9;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 10000;
  box-sizing: border-box;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}
.tab-item.active { color: #E98657; }
.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.tab-text { font-size: 22rpx; margin-top: 6rpx; font-weight: 500; }
.merchant-page {
  min-height: 100vh;
  box-sizing: border-box;
}

/* 商家 Tab 页内容底部留白（与 .has-tab-bar 叠加时以页面 class 为准） */
.merchant-page.has-tab-bar {
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.merchant-page .container {
  padding-bottom: 40rpx;
}

.mode-switch-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.mode-switch-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.92);
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}
