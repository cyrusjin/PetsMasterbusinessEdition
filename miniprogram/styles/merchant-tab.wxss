.merchant-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 249, .94);
  border-top: 1rpx solid rgba(242, 222, 201, .78);
  box-shadow: 0 -10rpx 30rpx rgba(111, 75, 48, .1);
  backdrop-filter: blur(18px);
  z-index: 10000;
  box-sizing: border-box;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}
.tab-item.active { color: #E77952; }
.tab-icon-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}
.tab-text { font-size: 22rpx; margin-top: 6rpx; font-weight: 500; }
.merchant-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: radial-gradient(circle at 92% 8%, rgba(255, 199, 191, .28), transparent 300rpx), linear-gradient(180deg, #FFF7F1 0%, #FFFDFB 52%, #FFF8F4 100%);
}

/* 商家 Tab 页内容底部留白（与 .has-tab-bar 叠加时以页面 class 为准） */
.merchant-page.has-tab-bar {
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.merchant-page .container {
  padding-bottom: 40rpx;
}

.mode-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 自定义导航页用 padding-top 顶开固定栏，需额外补回与内容区一致的上间距 */
.merchant-page.has-custom-nav .mode-switch-row {
  margin-top: 20rpx;
}

.mode-switch-row.mode-switch-row--end {
  justify-content: flex-end;
}

.announce-entry {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.92);
}

.announce-entry-text {
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}

.announce-dot {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #E54D42;
  border: 2rpx solid #fff;
  box-sizing: border-box;
}

.mode-switch-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7C8AD;
  background: rgba(255, 255, 255, 0.92);
  color: #C87A4B;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
}
