@import './styles/design-tokens.wxss';

page {
  background: var(--color-bg-page);
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding-bottom: env(safe-area-inset-bottom);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.container { padding: 20rpx 20rpx 40rpx; }
.card:last-child { margin-bottom: 0; }

/* 仅底部 Tab 页需要为自定义 tabBar 留空（栏高约 100rpx + 额外呼吸空间） */
.has-tab-bar {
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

/* 区块标题：左侧主色竖条 */
.card-title,
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-heading);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--color-primary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  line-height: 1.3;
}

/* 表单 */
.form-group { margin-bottom: 24rpx; }
.form-label {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}
.required-star { color: var(--color-danger); margin-right: 4rpx; }
.form-input {
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
}
.form-input:focus { border-color: var(--color-primary); background: var(--color-bg-card); }
/* flex 行内输入框不要 width:100%，否则单位/按钮会被挤到下一行 */
.flex-row > .form-input,
.phone-row > .form-input {
  flex: 1;
  width: 0;
  min-width: 0;
}
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--color-bg-input);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
}

/* 按钮：重置微信 button 默认边距，避免视觉偏右/溢出；文字单行，高度随文案适配 */
.btn-primary {
  width: 100%;
  min-height: 88rpx;
  height: auto;
  background: var(--color-primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin: 0;
  padding: 20rpx 32rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-btn);
  white-space: nowrap;
  line-height: 1.2;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.88; transform: scale(0.98); }
.btn-outline {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  background: var(--color-bg-card);
  color: var(--color-primary);
  font-size: 28rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 18rpx 32rpx;
  box-sizing: border-box;
  white-space: nowrap;
  line-height: 1.2;
}
.btn-outline::after { border: none; }
.btn-sm {
  padding: 12rpx 28rpx;
  margin: 0;
  font-size: 24rpx;
  border-radius: var(--radius-pill);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-sizing: border-box;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  line-height: 1.2;
}
.btn-sm::after { border: none; }
.btn-green { background: #2E7D32; color: #fff; }
.btn-blue { background: var(--color-primary); color: #fff; }
.btn-orange { background: #F57C00; color: #fff; }
.btn-red { background: var(--color-danger); color: #fff; }
.btn-danger-outline { background: #FFEBEE; color: var(--color-danger); border: 2rpx solid var(--color-danger); }
.btn-gray { background: var(--color-border-light); color: var(--color-text-tertiary); }

/* 标签 */
.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  margin-right: 10rpx;
  font-weight: 500;
}
.tag-green { background: var(--color-accent-bg); color: var(--color-primary); }
.tag-orange { background: #FFF1E7; color: var(--color-primary-light); }
.tag-blue { background: var(--color-accent-bg); color: var(--color-primary); }
.tag-red { background: #FFEBEE; color: var(--color-danger); }
.tag-purple { background: var(--color-accent-bg); color: var(--color-primary-dark); }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 100rpx; margin-bottom: 24rpx; opacity: 0.4; }
.empty-text { font-size: 28rpx; color: var(--color-text-tertiary); }

/* 文字工具类 */
.fee-highlight { color: var(--color-primary); font-size: 36rpx; font-weight: 700; }
.text-green { color: var(--color-primary); }
.text-red { color: var(--color-danger); }
.text-gray { color: var(--color-text-tertiary); }
.stat-number {
  font-size: 56rpx;
  font-weight: 700;
  font-style: italic;
  color: var(--color-text-heading);
  text-shadow: var(--shadow-stat);
}

/* 布局 */
.flex-row { display: flex; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-wrap { display: flex; flex-wrap: wrap; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }

/* 头像 */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-border);
}
.avatar-img { width: 100%; height: 100%; }

/* 状态徽章 */
.status-badge { padding: 8rpx 20rpx; border-radius: var(--radius-pill); font-size: 22rpx; font-weight: 600; }
.status-pending { background: #FFF1E7; color: var(--color-primary-light); }
.status-confirmed { background: #EDE7F6; color: #5E35B1; }
.status-boarding { background: var(--color-accent-bg); color: var(--color-primary); }
.status-completed { background: #E8F5E9; color: var(--color-success); }
.status-cancelled { background: #FFEBEE; color: var(--color-danger); }
.status-awaiting_arrival { background: #FFF3E0; color: #F57C00; }
.status-toPay { background: #FFF8E1; color: #F9A825; }
.status-price-pending { background: #FFF3E0; color: #E65100; }

.pet-avatar-small {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
  object-fit: cover;
}
.boarding-name {
  font-size: 28rpx;
  font-weight: 600;
  display: block;
  color: var(--color-text-heading);
}

/* Tab：文字 + 下划线激活态 */
.order-tabs {
  display: flex;
  background: var(--color-bg-card);
  border-radius: var(--radius-card);
  margin-bottom: 20rpx;
  padding: 0 8rpx;
  box-shadow: var(--shadow-card);
}
.order-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  font-weight: 500;
  position: relative;
}
.order-tab.active {
  color: var(--color-text-heading);
  font-weight: 700;
  background: transparent;
}
.order-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* Pill 切换按钮组 */
.pill-tabs { display: flex; gap: 16rpx; }
.pill-tab {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  background: var(--color-bg-card);
}
.pill-tab.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 600;
}

/* 订单号（列表卡片可复制） */
.order-no-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
  font-size: 22rpx;
  line-height: 1.6;
}
.copyable-order-no {
  color: var(--color-primary);
  font-weight: 600;
}
